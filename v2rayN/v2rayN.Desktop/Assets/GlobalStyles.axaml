<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ==================================================================== -->
    <!--  Радиус кнопок (CTA/пилюль) — НЕ пилюля, НЕ капсула.                   -->
    <!--  Android Material-CTA задаёт cornerRadius=26dp на кнопке 52dp          -->
    <!--  (activity_buy_tariff.xml:303 btn_pay, activity_login.xml:64           -->
    <!--  btn_telegram; tonal-retry :75 = 22). Но 26 >= половины высоты 48 52,  -->
    <!--  поэтому и Android (после 6dp inset), и Avalonia клампят угол до        -->
    <!--  полукруга -> получается капсула-стадион (android_buy.jpg/login.jpg).   -->
    <!--  Владелец отклонил эти капсулы. Порт: настоящий скруглённый             -->
    <!--  ПРЯМОУГОЛЬНИК radius 16 (на 48h остаётся прямой вертикальный край;     -->
    <!--  язык формы как у Android bg_buy_option radius 14). 16 достраивает      -->
    <!--  шкалу Incy chip 12 / button 16 / card 20 / sheet 24 и меньше радиуса   -->
    <!--  карты (кнопка внутри карты 20 остаётся концентрически гармоничной).    -->
    <!-- ==================================================================== -->
    <Styles.Resources>
        <CornerRadius x:Key="Radius.Button">16</CornerRadius>

        <!-- ==================================================================== -->
        <!--  ДВЕ ГАРНИТУРЫ, РАЗДЕЛЁННЫЕ ПО ПИСЬМЕННОСТИ (00-rules.md 5.1, D-1/D-2). -->
        <!--                                                                        -->
        <!--  Font.Ui = Golos Text — РУССКИЙ интерфейсный шрифт. Им набрано КАЖДОЕ    -->
        <!--  русское слово: Headline · Title · Title medium · Body · Subtitle ·      -->
        <!--  Caption · Section header и ВСЕ подписи кнопок.                          -->
        <!--  Font.Brand = Space Grotesk — брендовая/цифровая гарнитура: цифры,        -->
        <!--  единицы, валюта, латинские технические токены (VLESS · Reality · WS ·    -->
        <!--  TCP · хосты · порты), подписи чипов и вордмарк. И БОЛЬШЕ НИЧЕГО.         -->
        <!--                                                                          -->
        <!--  ПОЧЕМУ разделение (измеренная причина, не вкусовая): бинарь Space        -->
        <!--  Grotesk покрывает 735 кодпоинтов и НОЛЬ в диапазоне U+0400-U+04FF.       -->
        <!--  Русская строка, которой назначен Space Grotesk, ВСЕГДА рисовалась        -->
        <!--  необъявленным фолбэком ОС — один экран тремя гарнитурами на трёх         -->
        <!--  системах. Это дефект P1, а не полировка.                                -->
        <!--                                                                          -->
        <!--  ФОРМА URI: ПАПКА, а не отдельный .ttf. Golos Text приезжает тремя         -->
        <!--  статическими начертаниями (Regular 400 / Medium 500 / Bold 700).          -->
        <!--  Ссылка на один файл дала бы коллекцию из ОДНОГО начертания, и             -->
        <!--  FontWeight="Bold" получил бы СИНТЕТИЧЕСКИЙ жир (fake-bold Skia),          -->
        <!--  который 5.4 запрещает. Папочная форма собирает семейство целиком,          -->
        <!--  и вес выбирает НАСТОЯЩЕЕ начертание.                                      -->
        <!--  Golos Text Medium несёт собственное имя семейства в name-таблице,          -->
        <!--  поэтому у веса 500 отдельный ключ Font.Ui.Medium.                          -->
        <!-- ==================================================================== -->
        <FontFamily x:Key="Font.Ui">avares://departament/Assets/Fonts#Golos Text</FontFamily>
        <FontFamily x:Key="Font.Ui.Medium">avares://departament/Assets/Fonts#Golos Text Medium, Golos Text</FontFamily>
        <FontFamily x:Key="Font.Brand">avares://departament/Assets/Fonts/SpaceGrotesk.ttf#Space Grotesk</FontFamily>

        <!-- ==================================================================== -->
        <!--  Flyout Incy (замена светло-серого дефолта Semi FlyoutPresenter).       -->
        <!--  ТОЛЬКО для наших флайаутов вкладки «Аккаунт» (пополнение, kebab «Ещё»,  -->
        <!--  привязка почты) — применяется ТОЧЕЧНО через FlyoutPresenterTheme, а НЕ  -->
        <!--  implicit-по-типу: implicit-версия налезала бы на легаси-флайауты        -->
        <!--  (настройки фрагмента, add-server, backup, тема) и клипала их из-за      -->
        <!--  MaxWidth/паддинга. Тёмная SurfaceHigh (#1A1D21) — на шаг выше карты,     -->
        <!--  поэтому флайаут поверх карты отделяется; 1px OutlineVariant, радиус 20,  -->
        <!--  паддинг 16, мягкая тень. Без MaxWidth (контент сам задаёт ширину);       -->
        <!--  ScrollViewer + MaxHeight 480 — длинный список апгрейда скроллится.       -->
        <!-- ==================================================================== -->
        <ControlTheme x:Key="IncyFlyoutTheme" TargetType="FlyoutPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHigh}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.OutlineVariant}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card}" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurface}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        BoxShadow="0 12 32 0 #66000000"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <ScrollViewer
                            HorizontalScrollBarVisibility="Disabled"
                            MaxHeight="480"
                            VerticalScrollBarVisibility="Auto">
                            <ContentPresenter
                                Padding="{TemplateBinding Padding}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <!-- ==================================================================== -->
        <!--  Incy-скроллбар (замена уродливого дефолта Semi). АВТО-СКРЫТИЕ оверлей: -->
        <!--  в покое ползунок НЕВИДИМ (opacity 0). При наведении курсора на область -->
        <!--  скролла / прокрутке ScrollBar получает :expanded (ScrollViewer.Allow-   -->
        <!--  AutoHide=True, глобальный стиль ниже) → проявляется пилюля-ползунок 6px -->
        <!--  @ alpha 0.45; прямое наведение на полосу → 8px, ярче (0.8); Accent при  -->
        <!--  перетаскивании. Без чанковых кнопок-стрелок (line-up/down не включены   -->
        <!--  в шаблон — они null-safe в ScrollBar.OnApplyTemplate). Плавность width/  -->
        <!--  opacity 150мс Ease.Standard, мгновенно под .lite (гасится ниже).        -->
        <!--  Тема-зависимо через DynamicResource; применяется глобально ключом       -->
        <!--  {x:Type ScrollBar} (GlobalStyles подключён ПОСЛЕ SemiTheme).            -->
        <!-- ==================================================================== -->

        <!--  Область-страница трека: невидима, но hit-target для click-to-page.  -->
        <ControlTheme x:Key="Incy.ScrollBarPageButton" TargetType="RepeatButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <!--  Ползунок: пилюля muted, размеры/ховер/press задаёт ScrollBar-шаблон.  -->
        <ControlTheme x:Key="Incy.ScrollBarThumb" TargetType="Thumb">
            <Setter Property="Background" Value="{DynamicResource Brush.OnSurfaceVariant}" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
            <!--  Покой = невидим; :expanded/ховер/drag проявляют (стили ScrollBar ниже).  -->
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                </ControlTemplate>
            </Setter>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.15" Easing="{StaticResource Ease.Standard}" />
                    <DoubleTransition Property="Height" Duration="0:0:0.15" Easing="{StaticResource Ease.Standard}" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="{StaticResource Ease.Standard}" />
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </ControlTheme>

        <!--  Глобальный слим-скроллбар (implicit ControlTheme).  -->
        <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="Root" Background="{TemplateBinding Background}">
                        <Track Name="PART_Track"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Orientation="{TemplateBinding Orientation}">
                            <Track.DecreaseButton>
                                <RepeatButton Name="PART_PageUpButton"
                                              Theme="{StaticResource Incy.ScrollBarPageButton}" />
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton Name="PART_PageDownButton"
                                              Theme="{StaticResource Incy.ScrollBarPageButton}" />
                            </Track.IncreaseButton>
                            <Track.Thumb>
                                <Thumb Name="thumb" Theme="{StaticResource Incy.ScrollBarThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter>

            <!--  Вертикальный: полоса-лейн 12px, пилюля 6px прижата к правому краю.  -->
            <Style Selector="^:vertical">
                <Setter Property="Width" Value="12" />
            </Style>
            <Style Selector="^:vertical /template/ Track#PART_Track">
                <Setter Property="IsDirectionReversed" Value="True" />
            </Style>
            <Style Selector="^:vertical /template/ Thumb#thumb">
                <Setter Property="Width" Value="6" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="Margin" Value="0,0,3,0" />
            </Style>
            <Style Selector="^:vertical:pointerover /template/ Thumb#thumb">
                <Setter Property="Width" Value="8" />
                <Setter Property="Margin" Value="0,0,2,0" />
            </Style>

            <!--  Горизонтальный: лейн 12px, пилюля 6px прижата к низу.  -->
            <Style Selector="^:horizontal">
                <Setter Property="Height" Value="12" />
            </Style>
            <Style Selector="^:horizontal /template/ Thumb#thumb">
                <Setter Property="Height" Value="6" />
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
                <Setter Property="Margin" Value="0,0,0,3" />
            </Style>
            <Style Selector="^:horizontal:pointerover /template/ Thumb#thumb">
                <Setter Property="Height" Value="8" />
                <Setter Property="Margin" Value="0,0,0,2" />
            </Style>

            <!--  АВТО-СКРЫТИЕ: :expanded ставит ScrollViewer (AllowAutoHide=True) при
                  наведении на область скролла ИЛИ прокрутке → пилюля проявляется до alpha
                  0.45. Свёрнут (нет :expanded) → базовая opacity 0 (ползунок скрыт).
                  Если вью форсит AllowAutoHide=False, ScrollBar коэрсит IsExpanded=True →
                  :expanded всегда активен → ползунок постоянно виден (штатный override).  -->
            <Style Selector="^:expanded /template/ Thumb#thumb">
                <Setter Property="Opacity" Value="0.45" />
            </Style>
            <!--  Наведение на полосу → ползунок ярче (более непрозрачный).  -->
            <Style Selector="^:pointerover /template/ Thumb#thumb">
                <Setter Property="Opacity" Value="0.8" />
            </Style>
            <!--  Перетаскивание → Accent + полная непрозрачность (после ховера — выигрывает).  -->
            <Style Selector="^ /template/ Thumb#thumb:pressed">
                <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                <Setter Property="Opacity" Value="1" />
            </Style>
            <!--  Отключён → ползунок скрыт.  -->
            <Style Selector="^:disabled /template/ Thumb#thumb">
                <Setter Property="Opacity" Value="0" />
            </Style>
        </ControlTheme>
    </Styles.Resources>

    <Design.PreviewWith>
        <Border Padding="20">
            <!--  Add Controls for Previewer Here  -->
        </Border>
    </Design.PreviewWith>

    <Style Selector="DataGrid">
        <Setter Property="RowHeight" Value="24" />
        <Setter Property="ScrollViewer.AllowAutoHide" Value="True" />
    </Style>

    <Style Selector="PathIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonDefaultTertiaryForeground}" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="ScrollViewer.AllowAutoHide" Value="True" />
    </Style>

    <!--  Глобально: авто-скрытие для ВСЕХ областей скролла (список серверов,
          настройки, аккаунт, покупка и т.д.). Ползунок скрыт в покое, проявляется
          на hover/scroll (оверлей-поведение). Отдельная вью может переопределить
          локально (AllowAutoHide=False → постоянный ползунок).  -->
    <Style Selector="ScrollViewer">
        <Setter Property="AllowAutoHide" Value="True" />
    </Style>

    <Style Selector="TabControl">
        <Setter Property="Theme" Value="{StaticResource LineTabControl}" />
    </Style>

    <Style Selector="Button.IconButton">
        <Setter Property="Width" Value="{StaticResource IconButtonWidth}" />
        <Setter Property="Height" Value="{StaticResource IconButtonHeight}" />
        <Setter Property="MinWidth" Value="{StaticResource IconButtonWidth}" />
        <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    </Style>
    <!--  Легаси IconButton (гик-окна) БЕЗ переопределения давал светлый оверлей темы
          Semi на hover = «белый glow». Гасим тинт и красим НАШ ховер-затемнение,
          чтобы нигде не было светлого свечения (Incy-экраны мигрируют на IconButton40).  -->
    <Style Selector="Button.IconButton /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.IconButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
    </Style>
    <Style Selector="Button.IconButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
    </Style>

    <!-- ==================================================================== -->
    <!--  БЛАНКЕТНОЕ СЕМЕЙСТВО = Font.Ui (Golos Text), НЕ брендовая гарнитура.    -->
    <!--                                                                        -->
    <!--  Раньше здесь стоял Font.Grotesk, то есть Space Grotesk назначался       -->
    <!--  КАЖДОЙ строке приложения — включая все русские. Space Grotesk не имеет  -->
    <!--  ни одного кириллического глифа, поэтому весь русский текст рисовался    -->
    <!--  необъявленным фолбэком операционной системы: разные гарнитуры на        -->
    <!--  Windows, Linux и macOS в одном и том же экране. 00-rules.md 1 называет  -->
    <!--  «брендовая гарнитура не может быть бланкетным сеттером» прямым запретом -->
    <!--  и указывает на ЭТИ строки; 5.1 требует нести здесь интерфейсную         -->
    <!--  гарнитуру. Брендовую теперь получают ТОЛЬКО роли Display / Chip /       -->
    <!--  Numeric / Wordmark — точечно, своим классом.                            -->
    <!--                                                                          -->
    <!--  Сеттеры остаются на трёх широчайших корнях: MainWindow задаёт шрифт      -->
    <!--  только своему корню, а каждый отдельный визуальный корень (легаси        -->
    <!--  суб-окна AddServer/Option/Routing/DNS, диалоги) и всплывашки в своём     -->
    <!--  TopLevel (ContextMenu/MenuFlyout, ToolTip, выпадашка ComboBox) его НЕ    -->
    <!--  наследуют и падали на дефолт темы Semi. Задаём ТОЛЬКО семейство —        -->
    <!--  веса/размеры/межбуквенное остаются за типографскими классами ниже.       -->
    <!-- ==================================================================== -->
    <Style Selector="TopLevel">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
    </Style>
    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
    </Style>
    <Style Selector="TemplatedControl">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
    </Style>

    <!-- ==================================================================== -->
    <!--  departament VPN — Incy: типографика + компоненты (тёмная тема)        -->
    <!-- ==================================================================== -->

    <!-- ==================================================================== -->
    <!--  ТИПОГРАФИЧЕСКАЯ ЛЕСТНИЦА (00-rules.md 3.4 / 5, шкала 1:1 с Android       -->
    <!--  TextAppearance.App.*). Три вещи, которых здесь не было:                  -->
    <!--                                                                          -->
    <!--  1. СЕМЕЙСТВО ПО РОЛИ, а не по привычке (D-1/D-2). Русский текст —         -->
    <!--     Font.Ui (Golos Text). Брендовую Font.Brand (Space Grotesk) получают    -->
    <!--     ровно четыре роли: Display (крупные цифры), Chip, Numeric, Wordmark.   -->
    <!--     Body/Subtitle/Caption объявляют семейство ЯВНО, а не наследуют         -->
    <!--     бланкетный сеттер — роль обязана быть самодостаточной.                 -->
    <!--                                                                          -->
    <!--  2. LineHeight ОБЪЯВЛЕН ЧИСЛОМ (D-12): 40/28/20/20/20/18/16/14/20/24.      -->
    <!--     Раньше ведущую задавал платформенный дефолт, поэтому Android и        -->
    <!--     десктоп рисовали РАЗНУЮ интерлиньяж при одинаковом кегле.              -->
    <!--                                                                          -->
    <!--  3. Межбуквенное — только из шкалы (5.6): Display -0.02em, Headline        -->
    <!--     -0.01em, Title 0, Body/Subtitle +0.01em, Caption +0.02em, Chip         -->
    <!--     +0.04em. В Avalonia LetterSpacing — это DIP, поэтому em переведён в    -->
    <!--     пиксели по кеглю роли (Body 14·0.01 = 0.14 и т.д.).                    -->
    <!-- ==================================================================== -->

    <!--  Display 34/700 — крупная цифра (баланс, счётчик). Брендовая гарнитура.  -->
    <Style Selector="TextBlock.Display">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Brand}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="LineHeight" Value="40" />
        <Setter Property="LetterSpacing" Value="-0.7" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurface}" />
    </Style>
    <!--  Headline 24/700 — заголовок экрана и пустого состояния. Русский → Ui.  -->
    <Style Selector="TextBlock.Headline">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="LineHeight" Value="28" />
        <Setter Property="LetterSpacing" Value="-0.24" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurface}" />
    </Style>
    <!--  Title 16/700 — заголовок строки, карточки, тулбара, подпись кнопки.  -->
    <Style Selector="TextBlock.Title">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurface}" />
    </Style>
    <!--  Title medium 16/500 — тот же кегль тише: вторичная/третичная кнопка,
          невыбранный сегмент. Отдельный ключ семейства: у Golos Text Medium
          собственное имя семейства, иначе вес 500 схлопнулся бы в 400.  -->
    <Style Selector="TextBlock.TitleMedium">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui.Medium}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurface}" />
    </Style>
    <Style Selector="TextBlock.Body">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="LetterSpacing" Value="0.14" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurface}" />
    </Style>
    <Style Selector="TextBlock.Subtitle">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="LetterSpacing" Value="0.13" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
    </Style>
    <Style Selector="TextBlock.Caption">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="LetterSpacing" Value="0.24" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
    </Style>
    <!--  Chip 11/500 — подпись чипа. Это латиница и короткие технические токены
          (VLESS, WS, TCP), поэтому роль по D-2 отдана брендовой гарнитуре.  -->
    <Style Selector="TextBlock.Chip">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Brand}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="LineHeight" Value="14" />
        <Setter Property="LetterSpacing" Value="0.44" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurface}" />
    </Style>
    <!--  Numeric — живая цифра (трафик · скорость · пинг · цена · остаток).
          Кегль/цвет наследует хозяина, гарнитуру и огранку задаёт роль:
          tnum (табличные — значение не «прыгает» при обновлении), lnum
          (прописные), zero (перечёркнутый ноль) для ТЕХНИЧЕСКИХ величин.  -->
    <Style Selector="TextBlock.Numeric">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Brand}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontFeatures" Value="tnum,lnum,zero" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurface}" />
    </Style>
    <!--  Numeric.Money — та же роль БЕЗ zero (D-3): перечёркнутый ноль в цене
          читается как символ валюты, а не как цифра. «1 290 ₽», не «1 29Ø ₽».  -->
    <Style Selector="TextBlock.Numeric.Money">
        <Setter Property="FontFeatures" Value="tnum,lnum" />
    </Style>
    <!--  Заголовок секции — жирный sentence-case, НЕ мелкий ALL-CAPS eyebrow  -->
    <Style Selector="TextBlock.SectionHeader">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurface}" />
    </Style>
    <!--  Wordmark 20/700 — ЕДИНСТВЕННОЕ место, где брендовая гарнитура несёт
          «слово»: логотип-надпись на первой вкладке. Не заголовок суб-страницы
          (12.1B): суб-страницы носят Title, иначе бренд обесценивается.  -->
    <Style Selector="TextBlock.Wordmark">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Brand}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="LetterSpacing" Value="-0.2" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurface}" />
    </Style>
    <!--  Ошибка поля — Caption в красном ТЕКСТОВОМ токене (#FF6069, 6.15:1),
          не в заливочном #F04452 (4.88:1). 00-rules.md 3.5.  -->
    <Style Selector="TextBlock.FieldError">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="LetterSpacing" Value="0.24" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.RedText}" />
    </Style>

    <!--  Карточка (замена MaterialCardView): поверхность, радиус 20, тонкая рамка, без тени  -->
    <Style Selector="Border.Card">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.OutlineVariant}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- ==================================================================== -->
    <!--  СТРОКА — самый повторяемый элемент продукта. Пять архетипов, одна       -->
    <!--  геометрия (22-components 8.1): 16 гуттер · 40 плитка · 12 · текстовая    -->
    <!--  колонка · 12 · ОДИН трейлинг · 16 гуттер. Минимум 56, растёт под         -->
    <!--  двухстрочный подзаголовок и никогда не обрезает.                         -->
    <!--                                                                          -->
    <!--  ПАДДИНГ 12,0 → 16,12: строка обязана дышать по вертикали, а её           -->
    <!--  горизонтальный отступ — тот же экранный гуттер 16, что у всего           -->
    <!--  остального. Радиус 12 → 16: фурнитурный радиус на объекте размером со    -->
    <!--  строку читался мельче своей высоты.                                      -->
    <!--                                                                          -->
    <!--  СТРОКА НЕ МАСШТАБИРУЕТСЯ ПРИ НАЖАТИИ (R5). Строка — это срез              -->
    <!--  поверхности; масштабируя срез, рвём волосяные линии сверху и снизу, и     -->
    <!--  это читается как баг отрисовки, а не как отклик. Отклик даёт ШАГ ФОНА     -->
    <!--  на ступень вверх (Brush.SurfaceHigh). Масштабируются ОБЪЕКТЫ — карта,     -->
    <!--  строка сервера, чип аккаунта, кнопка (см. Border.ServerRow ниже).         -->
    <!-- ==================================================================== -->
    <Style Selector="Border.Row">
        <Setter Property="MinHeight" Value="{DynamicResource Size.Row}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Button}" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.Row:pointerover">
        <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
    </Style>
    <!--  Нажатие: ступень поверхности, не масштаб. Класс вешает потребитель по
          PointerPressed/Released (как .pressed у ServerRow).  -->
    <Style Selector="Border.Row.pressed">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHigh}" />
    </Style>
    <Style Selector="Border.Row.disabled">
        <Setter Property="Opacity" Value="0.38" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <!--  Row.Value — показывает значение и открывает выбор. Геометрия базовая;
          класс существует, чтобы разметка называла роль, а не рисовала её.  -->
    <Style Selector="Border.Row.Value">
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <!--  Row.Action — действие выполняет ТРЕЙЛИНГ-контрол, а не строка.
          Поэтому у тела строки нет ни курсора-руки, ни ховера, ни нажатия:
          две мишени, делающие разное, — это ровно та ошибка, из-за которой
          мета-бар подписки срабатывал «через раз».  -->
    <Style Selector="Border.Row.Action">
        <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="Border.Row.Action:pointerover">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <!--  Row.Toggle — трейлинг тумблер, НЕинтерактивный (IsHitTestVisible=False
          у потребителя): строка владеет переключателем целиком.  -->
    <Style Selector="Border.Row.Toggle">
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <!--  Row.Destructive — заголовок красным ТЕКСТОВЫМ токеном (#FF6069, 6.15:1).
          Плитка остаётся НЕЙТРАЛЬНОЙ: красная плитка плюс красный текст — это
          один и тот же сигнал дважды, строка превращается в сирену.  -->
    <Style Selector="Border.Row.Destructive TextBlock.Title">
        <Setter Property="Foreground" Value="{DynamicResource Brush.RedText}" />
    </Style>
    <!--  Разделитель строк: 1px, инсет 68 = точка начала текста (16+40+12).
          Только МЕЖДУ строками — никогда над первой и под последней.  -->
    <Style Selector="Border.Divider">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Brush.OutlineVariant}" />
        <Setter Property="Margin" Value="68,0,0,0" />
    </Style>
    <!--  Разделитель без ведущей плитки (строка без иконки) — от гуттера.  -->
    <Style Selector="Border.Divider.Flush">
        <Setter Property="Margin" Value="0" />
    </Style>

    <!--  Плитка иконки 40 с глифом 22  -->
    <Style Selector="Border.Tile">
        <Setter Property="Width" Value="{DynamicResource Size.Tile}" />
        <Setter Property="Height" Value="{DynamicResource Size.Tile}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Tile}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Tile.Neutral}" />
    </Style>
    <Style Selector="Border.Tile.Blue">
        <Setter Property="Background" Value="{DynamicResource Brush.Tile.Blue}" />
    </Style>

    <!--  Чип/бейдж  -->
    <Style Selector="Border.ChipBadge">
        <Setter Property="Background" Value="{DynamicResource Brush.AccentContainer}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Chip}" />
        <Setter Property="Padding" Value="10,4" />
    </Style>

    <!-- ==================================================================== -->
    <!--  ОДНА система кнопок (DESIGN_PLAN §0.1). Каждый экран использует ЭТИ     -->
    <!--  классы; никакой экран НЕ задаёт свою высоту/радиус/паддинг кнопки.     -->
    <!--  Радиус = Radius.Button 16 (скруглённый прямоугольник, не капсула,      -->
    <!--  объяснение у Styles.Resources сверху). Никакого ripple/glow: един-     -->
    <!--  ственный отклик на нажатие — scale (Android press_scale/nav_press).    -->
    <!--                                                                          -->
    <!--  ЦЕНТР press-scale: RenderTransformOrigin ОБЯЗАН быть ОТНОСИТЕЛЬНЫМ        -->
    <!--  «50%,50%», а НЕ «0.5,0.5». RelativePoint.Parse трактует значение БЕЗ «%» -->
    <!--  как АБСОЛЮТНЫЕ пиксели: «0.5,0.5» → (0.5px,0.5px) ≈ левый-верхний угол,  -->
    <!--  из-за чего scale(0.97) «проваливался» влево-вверх (баг реального теста).  -->
    <!--  «50%,50%» → Relative → ToPixels = (0.5·W, 0.5·H) = истинный центр при      -->
    <!--  ЛЮБОМ размере. Visual оборачивает RenderTransform.Value через origin      -->
    <!--  (−T·value·T), поэтому TransformOperations scale(...) масштабируется        -->
    <!--  строго от центра. (Исключения: Border.ConnectDisc и Ellipse.Spinner —      -->
    <!--  они центрируются сами, там origin намеренно абсолютный no-op, см. ниже.)   -->
    <!-- ==================================================================== -->

    <!-- ==================================================================== -->
    <!--  ПЕРВИЧНАЯ. Одна на экран: то единственное, чего экран от тебя хочет.    -->
    <!--  Заливка акцентом, подпись Title 16/700 в Font.Ui (русская подпись —      -->
    <!--  русской гарнитурой; раньше стоял Grotesk 15, у которого нет кириллицы).  -->
    <!--                                                                          -->
    <!--  ВЫСОТА — MinHeight, НИКОГДА Height. Фиксированная высота обрезает        -->
    <!--  двухстрочную подпись при масштабе 200% — это дефект доступности P1       -->
    <!--  (00-rules.md 14.5), а не косметика. Height="48" здесь и был этой миной.   -->
    <!--                                                                          -->
    <!--  ПРЕСС АСИММЕТРИЧЕН (D-11): вход 90мс OutQuart живёт на СЕЛЕКТОРЕ         -->
    <!--  :pressed, возврат 160мс OutQuint — на базовом. Работает потому, что       -->
    <!--  анимацией свойства управляет тот стиль, который применён В МОМЕНТ         -->
    <!--  изменения: входя в :pressed берём его Transitions, выходя — базовые.      -->
    <!--  Прежние симметричные 120/120 «кусали» и «отпускали» одинаково вяло.       -->
    <!-- ==================================================================== -->
    <Style Selector="Button.Primary">
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Button}" />
        <Setter Property="MinHeight" Value="{DynamicResource Size.Btn}" />
        <Setter Property="MinWidth" Value="{DynamicResource Size.BtnMinWidth}" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <!--  Возврат: 160мс OutQuint — уверенное оседание, без bounce.  -->
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="{StaticResource Ease.OutQuint}" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.Primary:pressed">
        <Setter Property="RenderTransform" Value="scale(0.97)" />
        <!--  Вход: 90мс OutQuart — отклик заметен раньше 100мс (7.3).  -->
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.09" Easing="{StaticResource Ease.OutQuart}" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.Primary:disabled">
        <Setter Property="Opacity" Value="0.38" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <!--  ГЛОБАЛЬНЫЙ фикс ховера. Без переопределения дефолтная тема Semi ({x:Type
          Button}) на :pointerover ПОДМЕНЯЕТ фон PART_ContentPresenter своим токеном
          ButtonDefaultPointeroverBackground (акцент-ховер ~#5F9AFF — СВЕТЛЕЕ покоя),
          из-за чего CTA «Открыть Telegram»/«Войти» и ВСЕ Primary-кнопки на login/
          onboarding/etc СВЕТЛЕЛИ. Прибиваем фон к чуть ТЕМНЕЕ покоя (Accent → #3D7EF0),
          press на шаг темнее (#3877E0) — ровно как локально было у аккаунтной
          «Пополнить» (TopUpButton), теперь ГЛОБАЛЬНО. Покой (Brush.Accent) и текст
          (Brush.OnAccent) не трогаем; press-scale 0.97 остаётся выше. Едино в dark/
          light/mono (значения — прямой затемнённый акцент, не тема-зависимы).  -->
    <!--  Ховер-тинт CTA: плавный кроссфейд фона 150мс Ease.Standard (был жёсткий флип #4C8DFF→#3D7EF0).
          Только цвет PART_ContentPresenter — press-затемнение (#3877E0) читается поверх. Аттачится
          ТОЛЬКО не под .lite (селектор :not(.lite), приём скроллбара/спиннера): под lite ховер
          мгновенный (0 движения), не полагаясь на Button-level гашение, которое до template-части не
          достаёт. Едино dark/light/mono (значения — прямой затемнённый акцент).  -->
    <Style Selector=":is(Window):not(.lite) Button.Primary /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" Easing="{StaticResource Ease.Standard}" />
            </Transitions>
        </Setter>
    </Style>
    <!--  Сырой хекс #3D7EF0/#3877E0 заменён токенами Brush.AccentHover /
          Brush.AccentPressed: инлайн-хекс вне словаря токенов запрещён (00-rules.md 1),
          и он же замораживал тёмное значение при переключении темы.  -->
    <Style Selector="Button.Primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.AccentHover}" />
    </Style>
    <Style Selector="Button.Primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.AccentPressed}" />
    </Style>

    <!--  Первичная высокая (CTA форм: Оплатить · Войти · Подтвердить). 52 —
          тоже МИНИМУМ, а не фиксация: при 200% двухстрочная подпись растит
          кнопку, а не обрезается. Android btn_pay/btn_telegram = 52dp.  -->
    <Style Selector="Button.Primary.Tall">
        <Setter Property="MinHeight" Value="{DynamicResource Size.BtnTall}" />
    </Style>
    <!--  Компактная первичная: те же цвета и типографика, высота 48 (5.2).
          Нужна там, где первичное действие стоит В СТРОКЕ рядом с другим
          контролом и 52 разорвали бы ритм.  -->
    <Style Selector="Button.PrimaryCompact">
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Button}" />
        <Setter Property="MinHeight" Value="{DynamicResource Size.Btn}" />
        <Setter Property="MinWidth" Value="{DynamicResource Size.BtnMinWidth}" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="{StaticResource Ease.OutQuint}" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.PrimaryCompact /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <Style Selector="Button.PrimaryCompact:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.AccentHover}" />
    </Style>
    <Style Selector="Button.PrimaryCompact:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.AccentPressed}" />
    </Style>
    <Style Selector="Button.PrimaryCompact:pressed">
        <Setter Property="RenderTransform" Value="scale(0.97)" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.09" Easing="{StaticResource Ease.OutQuart}" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.PrimaryCompact:disabled">
        <Setter Property="Opacity" Value="0.38" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="Button.PrimaryCompact">
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border BorderThickness="2" CornerRadius="16" Opacity="0.4"
                        BorderBrush="{DynamicResource Brush.OnAccent}" />
            </FocusAdornerTemplate>
        </Setter>
    </Style>

    <!-- ==================================================================== -->
    <!--  ВТОРИЧНАЯ. Реалистичная альтернатива первичной либо действие без         -->
    <!--  конкурента. Нейтральная тональная заливка, подпись Title medium 16/500.   -->
    <!--  Канонический класс — Button.Secondary (см. ниже); Button.Tonal оставлен    -->
    <!--  живым синонимом, потому что на нём висит 17 разметок, а удаление стиля     -->
    <!--  — мгновенный отказ сборки. Оба селектора несут ОДНО поведение.             -->
    <!-- ==================================================================== -->
    <Style Selector="Button.Tonal, Button.Secondary">
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHighest}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurface}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Button}" />
        <Setter Property="MinHeight" Value="{DynamicResource Size.Btn}" />
        <Setter Property="MinWidth" Value="{DynamicResource Size.BtnMinWidth}" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui.Medium}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="{StaticResource Ease.OutQuint}" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.Tonal:pressed, Button.Secondary:pressed">
        <Setter Property="RenderTransform" Value="scale(0.97)" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.09" Easing="{StaticResource Ease.OutQuart}" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.Tonal:disabled, Button.Secondary:disabled">
        <Setter Property="Opacity" Value="0.38" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <!--  Ховер-тинт тонали: тот же 150мс Ease.Standard кроссфейд Brush.Hover (был жёсткий флип).
          Аттачится только не под .lite (см. Primary выше); press-тинт тот же Brush.Hover поверх.  -->
    <Style Selector=":is(Window):not(.lite) Button.Tonal /template/ ContentPresenter#PART_ContentPresenter, :is(Window):not(.lite) Button.Secondary /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" Easing="{StaticResource Ease.Standard}" />
            </Transitions>
        </Setter>
    </Style>
    <!--  Тот же фикс: без переопределения :pointerover тема Semi подменяла бы фон
          тонали своим токеном (СВЕТЛЕЕ / уход в акцент). Затемняем СУБТИЛЬНО тем же
          Brush.Hover, что несут все прочие ховеры Incy (Row/IconButton/BackNav) —
          полупрозрачное затемнение, единое в dark/light/mono, НИКОГДА не светление и
          не акцент-флип. Текст (OnSurface) и press-scale 0.97 не трогаем.  -->
    <Style Selector="Button.Tonal:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.Secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
    </Style>
    <Style Selector="Button.Tonal:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.Secondary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
    </Style>

    <!--  Контурная (акцент): прозрачный фон + 1px рамка Accent, текст Accent,
          Grotesk 15 Medium. Регистрация / Начать заново. Android btn_restart:
          materialButtonOutlinedStyle, strokeColor=colorPrimary, textColor=colorPrimary.  -->
    <Style Selector="Button.OutlinedAccent">
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.OutlineControl}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Button}" />
        <Setter Property="MinHeight" Value="{DynamicResource Size.Btn}" />
        <Setter Property="MinWidth" Value="{DynamicResource Size.BtnMinWidth}" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui.Medium}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="{StaticResource Ease.OutQuint}" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.OutlinedAccent:pressed">
        <Setter Property="RenderTransform" Value="scale(0.97)" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.09" Easing="{StaticResource Ease.OutQuart}" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.OutlinedAccent:disabled">
        <Setter Property="Opacity" Value="0.38" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <!--  Тот же фикс: тема Semi на :pointerover заливала бы контурную кнопку своим
          светлым токеном (и меняла бы рамку). Держим прозрачный контур и СУБТИЛЬНО
          затемняем заливку Brush.Hover; рамку прибиваем к Accent, чтобы Semi не увёл
          её в свой ховер-цвет. Текст (Accent) и press-scale 0.97 не трогаем — итог:
          мягкий затемняющий тинт внутри контура, без светления/акцент-флипа, dark/
          light/mono едино.  -->
    <!--  Граница контура — Brush.OutlineControl (D-9), а не Brush.Accent: обводка
          акцентом делала кнопку ВТОРОЙ акцентной поверхностью рядом с первичной,
          что 4.3 запрещает. OutlineControl держит 3.43:1 — это WCAG 1.4.11 для
          границы контрола, чего colorOutline (1.45:1) никогда не давал.  -->
    <Style Selector="Button.OutlinedAccent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.OutlineControl}" />
    </Style>
    <Style Selector="Button.OutlinedAccent:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.OutlineControl}" />
    </Style>

    <!--  Степпер (±): круг 40 (CornerRadius 20 = круг), фон Tile.Blue, глиф 20
          Accent. press scale 0.94 (как connect-диск animateConnectPress).
          Android btn_dev_minus/plus (activity_buy_tariff.xml:213-259):
          tile_size 40, cornerRadius 20, iconSize 20, iconTint=colorPrimary,
          backgroundTint=iconTileBgBlue (bg_icon_blue), inset/padding 0.  -->
    <Style Selector="Button.Stepper">
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="Width" Value="{DynamicResource Size.Tile}" />
        <Setter Property="Height" Value="{DynamicResource Size.Tile}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Background" Value="{DynamicResource Brush.Tile.Blue}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="{StaticResource Ease.OutQuart}" />
            </Transitions>
        </Setter>
    </Style>
    <!--  Глиф степпера: 20, цвет Accent (перекрывает базовый PathIcon 16/tertiary).  -->
    <Style Selector="Button.Stepper PathIcon">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <!--  Пресс 0.94 → 0.97: D-11 требует ОДИН масштаб нажатия на весь продукт.
          Асимметрия та же — вход 90 OutQuart, возврат 160 OutQuint (базовый).  -->
    <Style Selector="Button.Stepper:pressed">
        <Setter Property="RenderTransform" Value="scale(0.97)" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.09" Easing="{StaticResource Ease.OutQuart}" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.Stepper:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
    </Style>
    <Style Selector="Button.Stepper:disabled">
        <Setter Property="Opacity" Value="0.38" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <!--  Фокус степпера: круг → кольцо по контуру круга (радиус 20 + 2).  -->
    <Style Selector="Button.Stepper">
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border Margin="-2" BorderThickness="2" CornerRadius="22"
                        BorderBrush="{DynamicResource Brush.Accent}" />
            </FocusAdornerTemplate>
        </Setter>
    </Style>

    <!-- ==================================================================== -->
    <!--  departament VPN — недостающие компоненты мастер-плана §2.4 (фаза 0)   -->
    <!-- ==================================================================== -->

    <!--  Цветные варианты плитки иконки 40 (к базовому Border.Tile + .Blue)  -->
    <Style Selector="Border.Tile.Green">
        <Setter Property="Background" Value="{DynamicResource Brush.Tile.Green}" />
    </Style>
    <Style Selector="Border.Tile.Orange">
        <Setter Property="Background" Value="{DynamicResource Brush.Tile.Orange}" />
    </Style>
    <Style Selector="Border.Tile.Purple">
        <Setter Property="Background" Value="{DynamicResource Brush.Tile.Purple}" />
    </Style>
    <Style Selector="Border.Tile.Red">
        <Setter Property="Background" Value="{DynamicResource Brush.Tile.Red}" />
    </Style>
    <Style Selector="Border.Tile.Yellow">
        <Setter Property="Background" Value="{DynamicResource Brush.Tile.Yellow}" />
    </Style>

    <!--  Бейдж протокола (bg_type_chip): контейнер акцента, radius 12, паддинг 8,2.
          Текст внутри — класс Chip цвет Accent, значение через .ToUpper() («VLESS»).  -->
    <Style Selector="Border.ProtocolChip">
        <Setter Property="Background" Value="{DynamicResource Brush.AccentContainer}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Chip}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  Строка сервера (bg_server_row): default прозрачная, hover→SurfaceHigh,
          press scale 0.96, selected = заливка #1F4C8DFF + 1.5px Accent, radius 20.
          Рамка всегда 1.5px (прозрачная в покое), чтобы выбор не сдвигал раскладку.  -->
    <Style Selector="Border.ServerRow">
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="MinHeight" Value="{DynamicResource Size.Row}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <!--  BUG 1: ховер-заливка МГНОВЕННА (Android-паритет). BrushTransition
              на Background убран — при переходе курсора между строками уходящая
              строка гасла плавно, а входящая проявлялась → казалось, что подсвечены
              ДВЕ строки. Оставляем press-scale и BorderBrush-переход.  -->
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.ServerRow:pointerover">
        <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
    </Style>
    <!--  Строка сервера — СВОБОДНО СТОЯЩИЙ ОБЪЕКТ, а не срез поверхности,
          поэтому она масштабируется (R5): 0.96 → 0.97, единый жест продукта.  -->
    <Style Selector="Border.ServerRow.pressed">
        <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>
    <Style Selector="Border.ServerRow.disabled">
        <Setter Property="Opacity" Value="0.38" />
    </Style>
    <Style Selector="Border.ServerRow.selected">
        <Setter Property="Background" Value="{DynamicResource Brush.SelectedFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <!--  BUG 1: ховер уже выбранной строки НЕ стекает selected-fill + hover-fill.
          Держим заливку выбора, чтобы одновременно была затенена ровно одна строка.  -->
    <Style Selector="Border.ServerRow.selected:pointerover">
        <Setter Property="Background" Value="{DynamicResource Brush.SelectedFill}" />
    </Style>

    <!--  ==================================================================== -->
    <!--  Строка настроек (SettingRow) — продвинута из SettingsView (P2). minHeight 56,     -->
    <!--  паддинг 16/12, hover = прямоугольное затемнение Brush.Hover ВНУТРИ скруглённой     -->
    <!--  карты (карта клипует углы), focus = авто-кольцо FocusAdorner (строка становится     -->
    <!--  Focusable/IsTabStop в code-behind, как AccountChip).                                -->
    <!--                                                                                      -->
    <!--  БЕЗ press-scale: владелец не хочет «продавливания» строки при тапе. Прежний класс     -->
    <!--  .pressed (scale 0.98 по PointerPressed) не только визуально «сжимал» строку, но и      -->
    <!--  съезжал под курсором на нажатии — жест Tapped отменялся, и тап срабатывал «через раз».  -->
    <!--  Отклик на нажатие несёт сам ховер (Brush.Hover) под курсором; кольцо фокуса — a11y.      -->
    <!--  Ховер МГНОВЕННЫЙ (без BrushTransition на Background): при прокрутке колесом подсвечена    -->
    <!--  ровно одна строка (паритет ServerRow).                                                    -->
    <!--  ==================================================================== -->
    <Style Selector="Border.SettingRow">
        <Setter Property="MinHeight" Value="{DynamicResource Size.Row}" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Background" Value="Transparent" />
        <!--  Кольцо фокуса ВНУТРЕННЕЕ (отступ 3, радиус 12): строка во всю ширину карты, внешнее
              кольцо вылезло бы за скруглённый край карты. Мгновенно, переживает lite (a11y > движение).  -->
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border Margin="3" BorderThickness="2" CornerRadius="12"
                        BorderBrush="{DynamicResource Brush.Accent}" />
            </FocusAdornerTemplate>
        </Setter>
    </Style>
    <Style Selector="Border.SettingRow:pointerover">
        <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
    </Style>
    <!--  Строки-сегменты (Mode/Appearance): тело строки НЕ тап-таргет — действуют только сегмент-чипы
          справа. Полноширинный hover-фон подсвечивал бы строку без действия (ложный аффорданс), поэтому
          у .segmentRow ховер тела подавлен (реагируют сами чипы). Специфичнее базового → перекрывает.  -->
    <Style Selector="Border.SettingRow.segmentRow:pointerover">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!--  Поиск-пилюля (bg_search_pill): Surface, radius 14, 1px OutlineVariant.  -->
    <Style Selector="Border.SearchPill">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Search}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.OutlineVariant}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!--  Трафик-пилюля: трек SurfaceVariant, высота 16, radius 8 (+ .Fill = заливка Accent).  -->
    <Style Selector="Border.TrafficPill">
        <Setter Property="Height" Value="16" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Traffic}" />
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceVariant}" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.TrafficPill.Fill">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!--  Аватар (bg_avatar_circle): овал, фон Tile.Blue; инициал — TextBlock цвет Accent.
          Размер (36/48) задаёт потребитель.  -->
    <Style Selector="Border.Avatar">
        <Setter Property="CornerRadius" Value="100" />
        <Setter Property="Background" Value="{DynamicResource Brush.Tile.Blue}" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <!--  Диск connect-щита (card_connect): 176 круг, SurfaceHigh, press-scale 0.94→1.0.
          Класс .pressed навешивает потребитель по PointerPressed/Released.  -->
    <Style Selector="Border.ConnectDisc">
        <!--  ВНИМАНИЕ: origin здесь НАМЕРЕННО абсолютный «0.5,0.5» (= 0.5px ≈ no-op),
              а НЕ относительный «50%,50%». ConnectHeroView сам центрирует press-scale
              императивным TransformGroup (translate −88 → scale → translate +88).
              Относительный центр здесь удвоил бы центрирование (Visual оборачивает
              RenderTransform.Value ещё раз через origin) → диск «провалился» бы в угол.
              НЕ меняй на «50%,50%».  -->
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="Width" Value="{DynamicResource Size.ConnectDisc}" />
        <Setter Property="Height" Value="{DynamicResource Size.ConnectDisc}" />
        <Setter Property="CornerRadius" Value="88" />
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHigh}" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.ConnectDisc.pressed">
        <Setter Property="RenderTransform" Value="scale(0.94)" />
    </Style>

    <!--  Точки-пейджер карусели: неактивная 6/OutlineVariant, активная 8/Accent.  -->
    <Style Selector="Ellipse.Dot">
        <Setter Property="Width" Value="{DynamicResource Dot}" />
        <Setter Property="Height" Value="{DynamicResource Dot}" />
        <Setter Property="Fill" Value="{DynamicResource Brush.OutlineVariant}" />
    </Style>
    <Style Selector="Ellipse.Dot.active">
        <Setter Property="Width" Value="{DynamicResource Dot.Active}" />
        <Setter Property="Height" Value="{DynamicResource Dot.Active}" />
        <Setter Property="Fill" Value="{DynamicResource Brush.Accent}" />
    </Style>

    <!-- ==================================================================== -->
    <!--  Навигационный рейл (замена Android bottom-nav): пункт 76×64, глиф 24 +   -->
    <!--  подпись 11. Неактив = OnSurfaceVariant/500; актив = Accent/700 + левая    -->
    <!--  пилюля 3×28. Press scale 0.92. Без ripple/glow.                          -->
    <!-- ==================================================================== -->
    <Style Selector="Button.NavRailItem">
        <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="Width" Value="76" />
        <Setter Property="Height" Value="64" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <!--  Press-возврат = Ease.OutQuint (уверенное оседание из центра, origin 50%,50% выше).
              Длительность = Motion.Dur.PressOut 160мс — ЕДИНОЕ значение press для ОБЕИХ навигаций
              (рейл + нижний бар), убирает прежний разнобой 120/100 (P1-3).  -->
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="{StaticResource Ease.OutQuint}" />
            </Transitions>
        </Setter>
    </Style>
    <!--  Гасим стандартную заливку кнопки (нет светлого ripple темы Semi). У иконочной
          НАВИГАЦИИ ФОНА НЕТ ВООБЩЕ — ни в покое, ни на ховере, ни на нажатии: владелец
          не хочет серую плитку-фон под пунктами. Ховер-фидбек несёт САМ глиф (см. ниже:
          глиф/подпись темнеют на шаг), плюс press-scale 0.92.  -->
    <Style Selector="Button.NavRailItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style Selector="Button.NavRailItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.NavRailItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <!--  Ховер-фидбек = затемнение ГЛИФА (и подписи) на шаг, БЕЗ фона. Только для НЕактивных
          пунктов (:not(.active)) — у активного глиф остаётся Accent (синий) и не темнеет.
          Плавно через уже заданный BrushTransition Foreground (200мс Ease.Standard).  -->
    <Style Selector="Button.NavRailItem:pointerover:not(.active) PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariantHover}" />
    </Style>
    <Style Selector="Button.NavRailItem:pointerover:not(.active) TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariantHover}" />
    </Style>
    <Style Selector="Button.NavRailItem:pressed">
        <Setter Property="RenderTransform" Value="scale(0.92)" />
    </Style>
    <!--  Глиф/подпись: неактивные  -->
    <Style Selector="Button.NavRailItem PathIcon">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
        <!--  Тон серый↔accent = Ease.Standard 200мс (двусторонняя смена состояния, Android nav 200).  -->
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.2" Easing="{StaticResource Ease.Standard}" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.NavRailItem TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.2" Easing="{StaticResource Ease.Standard}" />
            </Transitions>
        </Setter>
    </Style>
    <!--  Активная левая пилюля БОЛЬШЕ НЕ per-item: три независимых пилюли заменены ОДНИМ общим
          «путешествующим» индикатором (Border x:Name="railIndicator" в MainWindow.axaml), который
          физически СКОЛЬЗИТ между слотами по Y (M3 nav-rail idiom). Его позицию/скольжение ведёт
          code-behind (MoveRailIndicator, Motion.Dur.State 220 OutQuint). Здесь остаётся только
          тинт активного пункта (глиф+подпись Accent) — он идёт параллельно скольжению индикатора.  -->
    <!--  Активный пункт: глиф+подпись Accent, вес 500→700 (тинт-кроссфейд 200мс Standard задан выше).  -->
    <Style Selector="Button.NavRailItem.active PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <Style Selector="Button.NavRailItem.active TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- ==================================================================== -->
    <!--  ОДНА иконочная кнопка Incy (DESIGN_PLAN §0.1, REVIEW_BACKLOG P1 2).     -->
    <!--                                                                          -->
    <!--  КАНОНИЧЕСКОЕ РЕШЕНИЕ: Button.IconButton40 = 40×40, прозрачная, круглая,  -->
    <!--  глиф 22 (в строках 20 через .Row), hover SurfaceHigh, pressed scale     -->
    <!--  0.92, БЕЗ ripple/glow, БЕЗ рамки. Это единый класс для тулбаров, строк  -->
    <!--  и мета-действий на ВСЕХ Incy экранах — конец дрейфа 32/36/40.           -->
    <!--                                                                          -->
    <!--  Легаси Button.IconButton (32×32, выше) НЕ трогаем: на нём висят старые   -->
    <!--  geek-экраны v2rayN (AddServer/Profiles/Clash/Option/Backup...). Incy    -->
    <!--  экраны переходят на IconButton40 в проходе дедупликации.                -->
    <!-- ==================================================================== -->
    <Style Selector="Button.IconButton40">
        <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="Width" Value="{DynamicResource Size.IconButton}" />
        <Setter Property="Height" Value="{DynamicResource Size.IconButton}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <!--  Гасим Semi-тинт и рисуем Incy hover на ContentPresenter (круг Pill).  -->
    <Style Selector="Button.IconButton40 /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
    </Style>
    <Style Selector="Button.IconButton40:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
    </Style>
    <Style Selector="Button.IconButton40:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
    </Style>
    <!--  Пресс 0.92 → 0.97 (D-11: один масштаб на продукт), асимметрия 90/160.  -->
    <Style Selector="Button.IconButton40:pressed">
        <Setter Property="RenderTransform" Value="scale(0.97)" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.09" Easing="{StaticResource Ease.OutQuart}" />
            </Transitions>
        </Setter>
    </Style>
    <!--  Ховер: глиф выходит из приглушённого в полный OnSurface — иконка без
          подписи обязана сама отвечать на курсор, фона ей для этого мало.  -->
    <Style Selector="Button.IconButton40:pointerover PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurface}" />
    </Style>
    <Style Selector="Button.IconButton40:disabled">
        <Setter Property="Opacity" Value="0.38" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <!--  Глиф 22 по умолчанию (перекрывает базовый PathIcon 16).  -->
    <Style Selector="Button.IconButton40 PathIcon">
        <Setter Property="Width" Value="{DynamicResource Size.Glyph}" />
        <Setter Property="Height" Value="{DynamicResource Size.Glyph}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
    </Style>
    <!--  Вариант «в строке»: глиф 20 (§0.4 «иконки действий в строках 20 22»).  -->
    <Style Selector="Button.IconButton40.Row PathIcon">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
    </Style>
    <!--  Вариант «акцент»: глиф Accent (активные/выбранные действия).  -->
    <Style Selector="Button.IconButton40.Accent PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    </Style>

    <!--  Бесшовный тулбар суб-страницы (§5.4 SubScreenToolbar): контейнер 56,
          фон Bg (сливается с окном), без рамки/тени. Хостит BackNav + Headline.  -->
    <Style Selector="Border.SubToolbar">
        <!--  56 — минимум, а не фиксация: при 200% заголовок Title растит тулбар,
              а не обрезается на нижней отсечке.  -->
        <Setter Property="MinHeight" Value="{DynamicResource Size.SubToolbar}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Bg}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,0" />
    </Style>
    <!--  Единственный разрешённый вариант тулбара: волосяная линия, которая
          ПРОЯВЛЯЕТСЯ при прокрутке, если граница действительно нужна.
          Класс вешает вью по ScrollViewer.Offset; больше тулбар не меняется
          ничем — ни тенью, ни цветом, ни высотой (12.1A).  -->
    <Style Selector="Border.SubToolbar.scrolled">
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.OutlineVariant}" />
    </Style>
    <Style Selector=":is(Window):not(.lite) Border.SubToolbar">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.22" Easing="{StaticResource Ease.Standard}" />
            </Transitions>
        </Setter>
    </Style>

    <!--  Back-кнопка тулбара (§5.4): семантика IconButton40 (40 круг, hover
          SurfaceHigh, press 0.92, без ripple). Глиф задаёт потребитель
          (Geo.ArrowBack). Класс существует ради читаемости разметки тулбаров.  -->
    <Style Selector="Button.BackNav">
        <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="Width" Value="{DynamicResource Size.IconButton}" />
        <Setter Property="Height" Value="{DynamicResource Size.IconButton}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.BackNav /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
    </Style>
    <Style Selector="Button.BackNav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
    </Style>
    <Style Selector="Button.BackNav:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
    </Style>
    <Style Selector="Button.BackNav:pressed">
        <Setter Property="RenderTransform" Value="scale(0.97)" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.09" Easing="{StaticResource Ease.OutQuart}" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.BackNav:disabled">
        <Setter Property="Opacity" Value="0.38" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="Button.BackNav PathIcon">
        <Setter Property="Width" Value="{DynamicResource Size.Glyph}" />
        <Setter Property="Height" Value="{DynamicResource Size.Glyph}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurface}" />
    </Style>

    <!--  Линк-действие (текст-кнопка акцента, §5.4): без рамки/фона, 40h тач-
          таргет, press scale 0.97. Пример: «Открыть Telegram», «Забыли пароль».  -->
    <!-- ==================================================================== -->
    <!--  ТРЕТИЧНАЯ. Тихое действие, которое не должно спорить с первичным:       -->
    <!--  «Отмена», «Повторить», действия внутри строки, кнопки диалога.          -->
    <!--  Прозрачный фон, подпись акцентом. Радиус 16 как у всех кнопок (D-6):    -->
    <!--  раньше стоял Radius.Chip 12 — фурнитурный радиус на КНОПКЕ.             -->
    <!--  Button.LinkAction оставлен живым синонимом (17 разметок).               -->
    <!-- ==================================================================== -->
    <Style Selector="Button.LinkAction, Button.Tertiary, Button.TextAction">
        <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="MinHeight" Value="{DynamicResource Size.Btn}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Button}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui.Medium}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="{StaticResource Ease.OutQuint}" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.LinkAction /template/ ContentPresenter#PART_ContentPresenter, Button.Tertiary /template/ ContentPresenter#PART_ContentPresenter, Button.TextAction /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Button}" />
    </Style>
    <!--  Ховер третичной: заливки в покое нет, поэтому ховер несёт САМ фон
          (6% оверлей), а не подчёркивание и не смена цвета подписи.  -->
    <Style Selector="Button.LinkAction:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.Tertiary:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.TextAction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
    </Style>
    <Style Selector="Button.LinkAction:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.Tertiary:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.TextAction:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
    </Style>
    <Style Selector="Button.LinkAction:pressed, Button.Tertiary:pressed, Button.TextAction:pressed">
        <Setter Property="RenderTransform" Value="scale(0.97)" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.09" Easing="{StaticResource Ease.OutQuart}" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.LinkAction:disabled, Button.Tertiary:disabled, Button.TextAction:disabled">
        <Setter Property="Opacity" Value="0.38" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <!--  Текстовая деструктивная (5.2 Button.DestructiveText): то же тело, но
          подпись красным ТЕКСТОВЫМ токеном. Заливочный #F04452 на тексте — 4.88:1,
          то есть ниже пола 4.5:1 только формально; на деле рядом с ним всегда
          стоит фон карты, поэтому берём #FF6069 (6.15:1).  -->
    <Style Selector="Button.DestructiveText">
        <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="MinHeight" Value="{DynamicResource Size.Btn}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Button}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.RedText}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui.Medium}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="{StaticResource Ease.OutQuint}" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.DestructiveText /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Button}" />
    </Style>
    <Style Selector="Button.DestructiveText:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
    </Style>
    <Style Selector="Button.DestructiveText:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
    </Style>
    <Style Selector="Button.DestructiveText:pressed">
        <Setter Property="RenderTransform" Value="scale(0.97)" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.09" Easing="{StaticResource Ease.OutQuart}" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.DestructiveText:disabled">
        <Setter Property="Opacity" Value="0.38" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="Button.DestructiveText">
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border Margin="-2" BorderThickness="2" CornerRadius="18"
                        BorderBrush="{DynamicResource Brush.Accent}" />
            </FocusAdornerTemplate>
        </Setter>
    </Style>

    <!-- ==================================================================== -->
    <!--  Деструктивная кнопка (promoted из DevicesView). Метрики Button.Primary  -->
    <!--  (48h, Radius.Button 16, Grotesk 15 Bold, press 0.97, disabled 0.38),    -->
    <!--  но фон Red #F04452, текст белый, hover/pressed Red затемнён (#D93844).   -->
    <!--  Фон закреплён и на ContentPresenter, чтобы hover темы Semi не подменял.  -->
    <!-- ==================================================================== -->
    <Style Selector="Button.Destructive">
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="Background" Value="{DynamicResource Brush.Red}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Button}" />
        <Setter Property="MinHeight" Value="{DynamicResource Size.Btn}" />
        <Setter Property="MinWidth" Value="{DynamicResource Size.BtnMinWidth}" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="{StaticResource Ease.OutQuint}" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.Destructive /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Red}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.Destructive:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.RedPressed}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.Destructive:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.RedPressed}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.Destructive:pressed">
        <Setter Property="RenderTransform" Value="scale(0.97)" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.09" Easing="{StaticResource Ease.OutQuart}" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.Destructive:disabled">
        <Setter Property="Opacity" Value="0.38" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <!-- ==================================================================== -->
    <!--  FOCUS-VISIBLE КОЛЬЦО (§3.4, a11y; мастер-план Фаза 0). ЕДИНЫЙ индикатор    -->
    <!--  фокуса-с-клавиатуры для кнопок / полей / account-chip на всех экранах.     -->
    <!--                                                                            -->
    <!--  Механизм — Control.FocusAdorner: кольцо рисуется в СЛОЕ АДОРНЕРОВ поверх    -->
    <!--  контрола, поэтому (1) НЕ влияет на раскладку — 0 reflow, покой рисуется     -->
    <!--  идентично; (2) НЕ обрезается родителем (карта/скролл); (3) Avalonia         -->
    <!--  показывает адорнер ТОЛЬКО при keyboard focus-visible (не по клику мышью).   -->
    <!--                                                                            -->
    <!--  Цвет — Brush.Accent через DynamicResource (тема-зависимо: синий в dark/     -->
    <!--  light, серый в mono — нейтрализация акцента работает). Мгновенно, БЕЗ        -->
    <!--  перехода → переживает lite: a11y важнее движения, поэтому кольцо НЕ гасится  -->
    <!--  под .lite (lite обнуляет Transitions, а FocusAdorner к ним не относится).   -->
    <!--  Радиус адорнера = радиус контрола + 2 (кольцо концентрично, Margin -2).     -->
    <!--  Primary/Tall (акцентная ЗАЛИВКА): внешнее синее на синем не видно →          -->
    <!--  ВНУТРЕННЕЕ кольцо Brush.OnAccent @40% (радиус контрола, без отрицательного   -->
    <!--  отступа). Применяется к CTA-классам, TextBox и Border.AccountChip (chip      -->
    <!--  станет Focusable в Фазе 3 — кольцо-фундамент уже готово и сработает тогда).  -->
    <!-- ==================================================================== -->

    <!--  Не-залитые CTA (Radius.Button 16 → кольцо 18): внешнее 2px Accent.
          Button.Destructive из этой группы ВЫВЕДЕНА: она ЗАЛИТАЯ, и синее кольцо
          снаружи красной заливки — третий цвет в одном контроле. Ей полагается
          ВНУТРЕННЕЕ белое кольцо @40% (см. ниже, R7).  -->
    <Style Selector="Button.Tonal, Button.Secondary, Button.OutlinedAccent">
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border Margin="-2" BorderThickness="2" CornerRadius="18"
                        BorderBrush="{DynamicResource Brush.Accent}" />
            </FocusAdornerTemplate>
        </Setter>
    </Style>

    <!--  Третичная / текстовое действие (Radius.Button 16 → кольцо 18).  -->
    <Style Selector="Button.LinkAction, Button.Tertiary, Button.TextAction">
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border Margin="-2" BorderThickness="2" CornerRadius="18"
                        BorderBrush="{DynamicResource Brush.Accent}" />
            </FocusAdornerTemplate>
        </Setter>
    </Style>

    <!--  Деструктивная (ЗАЛИТАЯ красным) — ВНУТРЕННЕЕ кольцо белым @40%,
          радиус контрола 16, без отрицательного отступа.  -->
    <Style Selector="Button.Destructive">
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border BorderThickness="2" CornerRadius="16" Opacity="0.4"
                        BorderBrush="White" />
            </FocusAdornerTemplate>
        </Setter>
    </Style>

    <!--  Поля ввода Incy (TextBox.Incy / IncyField, Radius.Search 14 → кольцо 16).  -->
    <Style Selector="TextBox">
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border Margin="-2" BorderThickness="2" CornerRadius="16"
                        BorderBrush="{DynamicResource Brush.Accent}" />
            </FocusAdornerTemplate>
        </Setter>
    </Style>

    <!--  Account-chip (Radius.Card 20 → кольцо 22).  -->
    <Style Selector="Border.AccountChip">
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border Margin="-2" BorderThickness="2" CornerRadius="22"
                        BorderBrush="{DynamicResource Brush.Accent}" />
            </FocusAdornerTemplate>
        </Setter>
    </Style>

    <!--  Сегмент-чип (Radius.Chip 12 → кольцо 14): инлайн-переключатели Режим/Оформление
          в настройках теперь реальные фокусируемые контролы — даём им единое кольцо фокуса.  -->
    <Style Selector="ToggleButton.Segment">
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border Margin="-2" BorderThickness="2" CornerRadius="14"
                        BorderBrush="{DynamicResource Brush.Accent}" />
            </FocusAdornerTemplate>
        </Setter>
    </Style>

    <!--  Primary/Tall — ВНУТРЕННЕЕ кольцо OnAccent @40% (радиус 16, без -2 отступа).  -->
    <Style Selector="Button.Primary">
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border BorderThickness="2" CornerRadius="16" Opacity="0.4"
                        BorderBrush="{DynamicResource Brush.OnAccent}" />
            </FocusAdornerTemplate>
        </Setter>
    </Style>

    <!-- ==================================================================== -->
    <!--  ЗАКРЫТИЕ ГЛАВНОЙ ДЫРЫ ДОСТУПНОСТИ (R7 / 12.2). Кольца фокуса не было   -->
    <!--  НИ У ОДНОЙ иконочной кнопки и НИ У ОДНОЙ из двух навигаций — то есть    -->
    <!--  тулбары, back, степперы, оверфлоу и весь рейл были достижимы ТОЛЬКО     -->
    <!--  мышью. 12.2 говорит прямо: ничто не может быть доступно только мышью.   -->
    <!--  Кольцо круглых контролов — окружность (радиус pill), у прямоугольных —  -->
    <!--  радиус контрола + 2. Адорнер НЕ гасится под .lite: доступность выше     -->
    <!--  снижения движения.                                                      -->
    <!-- ==================================================================== -->
    <Style Selector="Button.IconButton40, Button.BackNav, Button.Icon">
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border Margin="-2" BorderThickness="2" CornerRadius="100"
                        BorderBrush="{DynamicResource Brush.Accent}" />
            </FocusAdornerTemplate>
        </Setter>
    </Style>
    <!--  Легаси 32×32 иконочная кнопка гик-окон (радиус 8 → кольцо 10).  -->
    <Style Selector="Button.IconButton">
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border Margin="-2" BorderThickness="2" CornerRadius="10"
                        BorderBrush="{DynamicResource Brush.Accent}" />
            </FocusAdornerTemplate>
        </Setter>
    </Style>
    <!--  Пункт навигации: кольцо по всему пункту, радиус 14 (11.1).  -->
    <Style Selector="Button.NavRailItem, Button.NavItem">
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border Margin="-2" BorderThickness="2" CornerRadius="14"
                        BorderBrush="{DynamicResource Brush.Accent}" />
            </FocusAdornerTemplate>
        </Setter>
    </Style>
    <!--  Тумблер: кольцо вокруг ТРЕКА (7.2). Трек — стадион 52×32, поэтому 18.  -->
    <Style Selector="ToggleSwitch">
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border Margin="-2" BorderThickness="2" CornerRadius="18"
                        BorderBrush="{DynamicResource Brush.Accent}" />
            </FocusAdornerTemplate>
        </Setter>
    </Style>
    <!--  Строки и выбираемые объекты: кольцо ВНЕШНЕЕ, радиус контрола + 2.  -->
    <Style Selector="Border.Row, Border.Selectable, Border.PriceOption">
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border Margin="-2" BorderThickness="2" CornerRadius="18"
                        BorderBrush="{DynamicResource Brush.Accent}" />
            </FocusAdornerTemplate>
        </Setter>
    </Style>
    <Style Selector="Border.ServerRow, Border.Card.Pressable">
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border Margin="-2" BorderThickness="2" CornerRadius="22"
                        BorderBrush="{DynamicResource Brush.Accent}" />
            </FocusAdornerTemplate>
        </Setter>
    </Style>

    <!-- ==================================================================== -->
    <!--  Статус-чип истории платежей (promoted из PaymentHistoryView, P1 18).    -->
    <!--  Радиус 12, паддинг 8,2 (оптический вертикальный 2 — санкционированное    -->
    <!--  исключение чипа, §0.3). База = неизвестный статус (нейтрально). Вариант  -->
    <!--  несёт цвет статуса: текст = полный цвет, фон = тот же цвет @ 18%.        -->
    <!-- ==================================================================== -->
    <Style Selector="Border.StatusChip">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceVariant}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Chip}" />
        <Setter Property="Padding" Value="8,2" />
    </Style>
    <Style Selector="Border.StatusChip TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
    </Style>
    <Style Selector="Border.StatusChip.paid">
        <Setter Property="Background" Value="{DynamicResource Brush.StatusChip.Green}" />
    </Style>
    <Style Selector="Border.StatusChip.paid TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Green}" />
    </Style>
    <Style Selector="Border.StatusChip.pending">
        <Setter Property="Background" Value="{DynamicResource Brush.StatusChip.Orange}" />
    </Style>
    <Style Selector="Border.StatusChip.pending TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Icon.Orange}" />
    </Style>
    <Style Selector="Border.StatusChip.failed">
        <Setter Property="Background" Value="{DynamicResource Brush.StatusChip.Red}" />
    </Style>
    <Style Selector="Border.StatusChip.failed TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Red}" />
    </Style>
    <Style Selector="Border.StatusChip.canceled">
        <Setter Property="Background" Value="{DynamicResource Brush.StatusChip.Yellow}" />
    </Style>
    <Style Selector="Border.StatusChip.canceled TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Icon.Yellow}" />
    </Style>

    <!-- ==================================================================== -->
    <!--  Опция срока/цены (§2.3, §5.4 Border.PriceOption; promoted из BuyView     -->
    <!--  Border.OptionRow). Радиус 14 (Radius.Search), minHeight 48, рамка        -->
    <!--  ПОСТОЯННО 1.5px (§0.6 выбор не сдвигает раскладку); selected =           -->
    <!--  SelectedFill + 1.5px Accent. hover только у невыбранной.                 -->
    <!-- ==================================================================== -->
    <!--  Радиус 14 → 16 (D-7: поле, поиск, опция цены и сегментный трек носят
          радиус кнопки). Толщина рамки 1.5 держится в ОБОИХ состояниях — выбор
          меняет только ЦВЕТ, поэтому раскладка не дёргается (18.1).  -->
    <Style Selector="Border.PriceOption">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Button}" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.OutlineVariant}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.PriceOption:not(.selected):pointerover">
        <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
    </Style>
    <Style Selector="Border.PriceOption.selected">
        <Setter Property="Background" Value="{DynamicResource Brush.SelectedFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <!--  Выбранная опция — заголовок весом 700: выбор читается по ТРЁМ осям
          (заливка · цвет рамки · вес), поэтому переживает моно-тему и дальтонизм.  -->
    <Style Selector="Border.PriceOption.selected TextBlock.Title">
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Border.PriceOption.disabled">
        <Setter Property="Opacity" Value="0.38" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <!-- ==================================================================== -->
    <!--  Верх шита + grab-handle + скрим (§2.4, §5.4; promoted из BuyView).       -->
    <!--  SheetTop: Surface, радиус 24,24,0,0, 1px OutlineVariant по верху.        -->
    <!--  SheetHandle: 36×4 SurfaceHighest, радиус pill. Scrim: ~60% чёрный.       -->
    <!-- ==================================================================== -->
    <Style Selector="Border.SheetTop">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sheet}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.OutlineVariant}" />
        <Setter Property="BorderThickness" Value="1,1,1,0" />
    </Style>
    <Style Selector="Border.SheetHandle">
        <Setter Property="Width" Value="{DynamicResource Size.SheetHandleW}" />
        <Setter Property="Height" Value="{DynamicResource Size.SheetHandleH}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHighest}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.Scrim">
        <Setter Property="Background" Value="{DynamicResource Brush.Scrim}" />
    </Style>

    <!-- ==================================================================== -->
    <!--  Статус-тост (§1.4G, §5.4). Нейтральная пилюля внизу-по-центру:          -->
    <!--  SurfaceHighest, радиус pill, паддинг 22,12, мягкая тень, текст           -->
    <!--  OnSurface 14/Bold. Позицию/авто-скрытие/cross-fade задаёт оверлей.       -->
    <!-- ==================================================================== -->
    <!--  Радиус Pill → Radius.Card 20: широкая капсула с подписью внутри — ровно
          та форма, которую владелец отклонил (D-6); pill остаётся за кругами и
          треками. Паддинг 22,12 → 16,12: 22 нет ни в одной шкале.  -->
    <Style Selector="Border.Toast">
        <Setter Property="Background" Value="{DynamicResource Brush.Toast.Bg}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card}" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="BoxShadow" Value="0 8 24 0 #40000000" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.Toast TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurface}" />
    </Style>

    <!-- ==================================================================== -->
    <!--  Сегмент-переключатель (§2.11c ToggleButton.Segment): чипы 44, single-    -->
    <!--  select. Покой = прозрачный + 1px OutlineVariant, текст muted; checked =  -->
    <!--  SelectedFill + 1.5px Accent, текст Accent. press scale 0.96, без ripple. -->
    <!--  Одиночный выбор обеспечивает потребитель (RadioButton-группа/биндинг).   -->
    <!-- ==================================================================== -->
    <Style Selector="ToggleButton.Segment">
        <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <!--  Высота 44 → МИНИМУМ 40 внутри трека 48 (6.1): сегмент и кнопка на
              одной строке выравниваются, а подпись 16/500 при 200% растит сегмент,
              а не обрезается. Height здесь была той же миной, что у CTA.  -->
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Chip}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.OutlineVariant}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui.Medium}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="{StaticResource Ease.OutQuint}" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.22" Easing="{StaticResource Ease.Standard}" />
            </Transitions>
        </Setter>
    </Style>
    <!--  Трек сегментного переключателя (6.1): SurfaceHighest, радиус кнопки 16,
          внутренний паддинг 4. Сегменты кладёт потребитель в StackPanel Spacing=4.  -->
    <Style Selector="Border.SegmentTrack">
        <Setter Property="MinHeight" Value="{DynamicResource Size.Btn}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Button}" />
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHighest}" />
        <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="Border.SegmentTrack:disabled">
        <Setter Property="Opacity" Value="0.38" />
    </Style>
    <Style Selector="ToggleButton.Segment /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Chip}" />
    </Style>
    <Style Selector="ToggleButton.Segment:not(:checked):pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
    </Style>
    <Style Selector="ToggleButton.Segment:pressed">
        <Setter Property="RenderTransform" Value="scale(0.97)" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.09" Easing="{StaticResource Ease.OutQuart}" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.Segment:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.SelectedFill}" />
    </Style>
    <!--  Выбранный сегмент читается по ТРЁМ осям: заливка, цвет, вес 500 → 700.
          Вес щёлкает мгновенно (твина веса нет и он не нужен), заливка и рамка
          перетекают за Dur.State 220 Ease.Standard.  -->
    <Style Selector="ToggleButton.Segment:checked">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
    </Style>
    <!--  Выбранный сегмент НЕ реагирует на ховер: он уже в конечном состоянии.  -->
    <Style Selector="ToggleButton.Segment:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.SelectedFill}" />
    </Style>
    <Style Selector="ToggleButton.Segment:not(:checked):pointerover">
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurface}" />
    </Style>
    <Style Selector="ToggleButton.Segment:disabled">
        <Setter Property="Opacity" Value="0.38" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <!-- ==================================================================== -->
    <!--  Hero-иконка пустого состояния (§0.4, §5.4 Border.EmptyIcon): 64 синий    -->
    <!--  тайл, радиус 20, глиф 32 Accent по центру. НЕ строчный тайл 40.          -->
    <!-- ==================================================================== -->
    <Style Selector="Border.EmptyIcon">
        <Setter Property="Width" Value="{DynamicResource Size.EmptyIcon}" />
        <Setter Property="Height" Value="{DynamicResource Size.EmptyIcon}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Tile.Blue}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.EmptyIcon PathIcon">
        <Setter Property="Width" Value="{DynamicResource Size.EmptyGlyph}" />
        <Setter Property="Height" Value="{DynamicResource Size.EmptyGlyph}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ==================================================================== -->
    <!--  Скелет-примитивы (§1.5, §2.3; promoted из Account/Payment/Buy/Devices).  -->
    <!--  Один пульс на всё приложение: класс .SkeletonPulse (любой контейнер) —   -->
    <!--  alpha 0.45..1.0, 900мс, SineEaseInOut, реверс, бесконечно. Без шиммера.  -->
    <!--  Формы: SkelBar (полоса 16) и SkelCard (карта 76). Reduced-motion         -->
    <!--  снимает класс .SkeletonPulse на стороне потребителя (статичная alpha).   -->
    <!-- ==================================================================== -->
    <!--  Облегчённый режим: под lite-окном пульс НЕ навешивается (селектор не совпадает →
          анимация не аттачится → статичная непрозрачность). Конкурирующий стиль в Avalonia
          не может отменить уже запущенную анимацию, поэтому гасим на уровне СЕЛЕКТОРА.  -->
    <!--  Длительность 900 → 1000 (motion_pulse). 900мс не существует ни в одной
          шкале темпа; 1000 — объявленный токен и он же стоит на Android, так что
          обе платформы пульсируют ПРОВЕРЯЕМО одинаково. Кривая SineEaseInOut →
          Ease.Standard: ease-in-out на нашей шкале нет (8.3 — только ease-out и
          двусторонний Ease.Standard).  -->
    <Style Selector=":is(Window):not(.lite) :is(Control).SkeletonPulse">
        <Style.Animations>
            <Animation
                Duration="0:0:1"
                Easing="{StaticResource Ease.Standard}"
                IterationCount="Infinite"
                PlaybackDirection="Alternate">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0.45" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1.0" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <!--  Облегчённый режим: скелет СТАТИЧЕН на 0.7 — середина размаха пульса,
          то есть он остаётся читаемым «загрузкой», а не выглядит потухшим.  -->
    <Style Selector=":is(Window).lite :is(Control).SkeletonPulse">
        <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style Selector="Border.SkelBar">
        <Setter Property="Height" Value="16" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Chip}" />
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHighest}" />
    </Style>
    <Style Selector="Border.SkelCard">
        <Setter Property="Height" Value="{DynamicResource Size.SkeletonCard}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card}" />
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceVariant}" />
    </Style>

    <!-- ==================================================================== -->
    <!--  Индикатор-спиннер (§1.5; переиспользует вращение дуги ConnectHeroView).  -->
    <!--  Ellipse с дуговым StrokeDashArray (задаёт потребитель) + класс           -->
    <!--  .spinning для равномерного вращения 1.1с. RenderTransformOrigin         -->
    <!--  0.5,0.5 и Stroke/StrokeThickness/StrokeDashArray ставит потребитель.     -->
    <!-- ==================================================================== -->
    <Style Selector="Ellipse.Spinner">
        <Setter Property="IsHitTestVisible" Value="False" />
        <!--  ВНИМАНИЕ: origin здесь НАМЕРЕННО абсолютный «0.5,0.5» (= 0.5px ≈ no-op),
              а НЕ относительный «50%,50%». Спиннеры центрируют вращение сами —
              instance RotateTransform CenterX/CenterY (SubscriptionMetaView 9/9,
              ServerListView 7.5/7.5) или собственный instance-origin (LoginView).
              Относительный «50%,50%» здесь удвоил бы центр (Visual ещё раз обернул бы
              RenderTransform.Value через origin) → дуга «облетала» бы вместо вращения.
              НЕ меняй на «50%,50%».  -->
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
    </Style>
    <!--  Под lite-окном вращение НЕ навешивается (см. SkeletonPulse: гасим на уровне селектора,
          т.к. конкурирующий стиль не отменяет запущенную анимацию).  -->
    <Style Selector=":is(Window):not(.lite) Ellipse.Spinner.spinning">
        <Style.Animations>
            <Animation
                Duration="0:0:1.1"
                Easing="LinearEasing"
                IterationCount="Infinite">
                <KeyFrame Cue="0%">
                    <Setter Property="RotateTransform.Angle" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="RotateTransform.Angle" Value="360" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- ==================================================================== -->
    <!--  Навигационный рейл — корректная поверхность (REVIEW_BACKLOG P1 3,        -->
    <!--  DESIGN_PLAN Часть 3). Фон Bg (сливается с окном), БЕЗ правой границы.    -->
    <!--  Аддитивный класс: контейнер рейла в MainWindow переходит на него в       -->
    <!--  проходе дедупликации (сейчас там Surface + 1px правая граница).          -->
    <!--  Активный пункт (Accent глиф + левая пилюля 3×28, press 0.92, без ripple) -->
    <!--  уже задан классом Button.NavRailItem выше.                              -->
    <!-- ==================================================================== -->
    <Style Selector="Border.NavRail">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- ==================================================================== -->
    <!--  ============  КАНОНИЧЕСКИЙ СЛОВАРЬ КОМПОНЕНТОВ  ==================== -->
    <!--                                                                        -->
    <!--  Пятнадцать компонентов из 22-components R15 — и это ВЕСЬ словарь.      -->
    <!--  Всё остальное на экране обязано быть РАСКЛАДКОЙ из них, а не новым      -->
    <!--  контролом. Вью, которая рисует карточку руками, — дефект: расширяй      -->
    <!--  класс здесь.                                                            -->
    <!--                                                                          -->
    <!--  Каждый класс ниже несёт ПОЛНЫЙ набор состояний: покой · :pointerover     -->
    <!--  (6% оверлей) · :pressed (0.97, вход 90 OutQuart, возврат 160 OutQuint)   -->
    <!--  · :focus-visible (кольцо 2px, отступ 2 — ОБЯЗАТЕЛЬНО, 12.2: ничто не      -->
    <!--  достижимо только мышью) · :disabled (0.38 на ВЕСЬ контрол, а не на        -->
    <!--  подпись) · .active/.selected где применим выбор · и подача загрузки.      -->
    <!--  Класс без своих состояний — не компонент, а половина компонента.          -->
    <!--                                                                          -->
    <!--  Имена — из реестра 22-components 19: одно понятие, одно имя, обе          -->
    <!--  платформы. Старые имена (Tonal · LinkAction · IconButton40 · BackNav ·    -->
    <!--  NavRailItem · SettingRow · StatusChip · ChipBadge · ProtocolChip ·        -->
    <!--  TrafficPill · SearchPill) ОСТАВЛЕНЫ ЖИВЫМИ: на них висят разметки, а      -->
    <!--  удаление стиля — мгновенный отказ сборки. Это долг вывода, не долг         -->
    <!--  работы.                                                                   -->
    <!-- ==================================================================== -->

    <!-- ==================================================================== -->
    <!--  1. ИКОНОЧНАЯ КНОПКА (Button.Icon). Один глиф 22 в квадрате 40, без      -->
    <!--  подписи и без бейджа. Нужна подпись — это третичная кнопка.             -->
    <!--  Квадрат остаётся ФИКСИРОВАННЫМ (Width == Height): радиус pill живёт      -->
    <!--  только там, где ширина равна высоте, а «минимум» на круге превратил бы   -->
    <!--  его в стадион при первом же длинном содержимом.                          -->
    <!--  Каждому экземпляру ОБЯЗАТЕЛЬНЫ AutomationProperties.Name и ToolTip.Tip   -->
    <!--  одной и той же русской строкой — это задаёт потребитель.                 -->
    <!-- ==================================================================== -->
    <Style Selector="Button.Icon">
        <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="Width" Value="{DynamicResource Size.IconButton}" />
        <Setter Property="Height" Value="{DynamicResource Size.IconButton}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="{StaticResource Ease.OutQuint}" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.Icon /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
    </Style>
    <Style Selector="Button.Icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
    </Style>
    <Style Selector="Button.Icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
    </Style>
    <Style Selector="Button.Icon:pressed">
        <Setter Property="RenderTransform" Value="scale(0.97)" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.09" Easing="{StaticResource Ease.OutQuart}" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.Icon:disabled">
        <Setter Property="Opacity" Value="0.38" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <!--  Глиф 22 (плиточный размер): у иконочной кнопки нет подписи, поэтому
          глиф крупнее строчных 20 и мельче навигационных 24.  -->
    <Style Selector="Button.Icon PathIcon">
        <Setter Property="Width" Value="{DynamicResource Size.Glyph}" />
        <Setter Property="Height" Value="{DynamicResource Size.Glyph}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.15" Easing="{StaticResource Ease.Standard}" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.Icon:pointerover PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurface}" />
    </Style>
    <!--  В строке глиф 20 («иконки действий в строках 20»).  -->
    <Style Selector="Button.Icon.Row PathIcon">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
    </Style>
    <!--  .Filled — единственный модификатор иконочной: нейтральная заливка для
          степперов и того действия тулбара, которое обязано находиться сразу.  -->
    <Style Selector="Button.Icon.Filled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHighest}" />
    </Style>
    <Style Selector="Button.Icon.Accent PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <Style Selector="Button.Icon.Accent:pointerover PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <Style Selector="Button.Icon.Danger PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Red}" />
    </Style>
    <Style Selector="Button.Icon.Danger:pointerover PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Red}" />
    </Style>

    <!-- ==================================================================== -->
    <!--  2. КАРТА. Разрешена, только если верны ВСЕ три условия: это отдельный   -->
    <!--  объект, с которым работают как с целым; ему нужна граница, которую не    -->
    <!--  дают отступы; и он НЕ внутри другой карты. Экран настроек — это строки,  -->
    <!--  а не карты. История платежей — разделённый список, а не сетка одинаковых -->
    <!--  прямоугольников, которые ничего не делают.                               -->
    <!--  Тени нет вообще: глубину несёт лестница поверхностей.                    -->
    <!-- ==================================================================== -->
    <!--  Нажимаемая карта — ОБЪЕКТ, значит масштабируется (R5), в отличие от строки.  -->
    <Style Selector="Border.Card.Pressable">
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="{StaticResource Ease.OutQuint}" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.Card.Pressable:pointerover">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHigh}" />
    </Style>
    <Style Selector="Border.Card.Pressable.pressed">
        <Setter Property="RenderTransform" Value="scale(0.97)" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.09" Easing="{StaticResource Ease.OutQuart}" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.Card.Pressable.disabled">
        <Setter Property="Opacity" Value="0.38" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <!--  Карта-группа строк: паддинг 0 и клип углов, чтобы ховер строки не
          вылезал за скругление. Вложенных карт не бывает (4.4).  -->
    <Style Selector="Border.Card.Group">
        <Setter Property="Padding" Value="0" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <!--  Модальная карта (13.2): ширина, паддинг и радиус диалога. Ставится по
          центру поверх Border.Scrim. Диалог — последнее средство после
          «инлайн → раскрывающаяся строка → флайаут».  -->
    <Style Selector="Border.Card.Modal">
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.OutlineVariant}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ==================================================================== -->
    <!--  3. ЧИП. Чип — ЯРЛЫК, а не контрол: он никогда не кликается. Кликаемая   -->
    <!--  пилюля — это третичная кнопка или сегмент.                              -->
    <!--  Цвет НИКОГДА не единственный сигнал (6.3): в каждом статус-чипе стоит    -->
    <!--  слово. Голая цветная точка рядом с подписью, которая уже называет        -->
    <!--  состояние, — это украшение, и оно удаляется.                             -->
    <!--  Статусов ТРИ, а не четыре (R12): «Отменён» нейтрален — отменённый        -->
    <!--  платёж не является предупреждением.                                      -->
    <!-- ==================================================================== -->
    <Style Selector="Border.Chip">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="MaxWidth" Value="160" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Chip}" />
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHighest}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.Chip TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
    </Style>
    <!--  Chip.Accent — тарифный бейдж, и БОЛЬШЕ НИЧЕГО (R14.7): один на карточку
          подписки. Любой другой акцентный чип отбирает бюджет акцента у
          первичного действия экрана.  -->
    <Style Selector="Border.Chip.Accent">
        <Setter Property="Background" Value="{DynamicResource Brush.AccentContainer}" />
    </Style>
    <Style Selector="Border.Chip.Accent TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccentContainer}" />
    </Style>
    <Style Selector="Border.Chip.Status.Ok">
        <Setter Property="Background" Value="{DynamicResource Brush.StatusChip.Green}" />
    </Style>
    <Style Selector="Border.Chip.Status.Ok TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ping.Good}" />
    </Style>
    <Style Selector="Border.Chip.Status.Warn">
        <Setter Property="Background" Value="{DynamicResource Brush.StatusChip.Orange}" />
    </Style>
    <Style Selector="Border.Chip.Status.Warn TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.AmberText}" />
    </Style>
    <Style Selector="Border.Chip.Status.Error">
        <Setter Property="Background" Value="{DynamicResource Brush.StatusChip.Red}" />
    </Style>
    <Style Selector="Border.Chip.Status.Error TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.RedText}" />
    </Style>
    <Style Selector="Border.Chip:disabled">
        <Setter Property="Opacity" Value="0.38" />
    </Style>

    <!-- ==================================================================== -->
    <!--  4. ПОЛЕ ВВОДА. Подпись СВЕРХУ и всегда видима; плейсхолдер — это ПРИМЕР -->
    <!--  значения, а не подпись. Строка помощи/ошибки присутствует в разметке     -->
    <!--  ДАЖЕ пустой, иначе раскладка прыгает при первой же ошибке.               -->
    <!--  Валидация — по потере фокуса, не по каждому нажатию клавиши.             -->
    <!--  Граница — Brush.OutlineControl (D-9, 3.43:1): colorOutline даёт 1.45:1    -->
    <!--  и не имеет права рисовать границу контрола.                              -->
    <!-- ==================================================================== -->
    <Style Selector="Border.Field">
        <Setter Property="MinHeight" Value="{DynamicResource Size.Field}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Button}" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHighest}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.OutlineControl}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.Field:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.OnSurfaceVariant}" />
    </Style>
    <!--  Фокус поля — рамка 2px акцентом ВНУТРИ габарита (толщина растёт внутрь,
          раскладка не сдвигается) плюс общее кольцо адорнера снаружи.  -->
    <Style Selector="Border.Field.focused">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.Field.error">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Red}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.Field:disabled">
        <Setter Property="Opacity" Value="0.38" />
    </Style>
    <!--  Только для чтения: ни рамки, ни заливки — это уже не поле, а значение.  -->
    <Style Selector="Border.Field.readonly">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <!--  Подпись над полем — Subtitle, sentence-case, без двоеточия.  -->
    <Style Selector="TextBlock.FieldLabel">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="TextBlock.FieldLabel.error">
        <Setter Property="Foreground" Value="{DynamicResource Brush.RedText}" />
    </Style>
    <!--  Сам TextBox внутри Border.Field: без своей рамки и фона (их несёт
          обёртка), чтобы не было ДВУХ границ одна в другой.  -->
    <Style Selector="TextBox.Field">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurface}" />
    </Style>
    <!--  Плейсхолдер держит 4.5:1 (14.1): приглушённый серый по умолчанию Semi
          этот пол не проходит и потому здесь переопределён.  -->
    <Style Selector="TextBox.Field /template/ TextBlock#PART_Watermark">
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
    </Style>
    <Style Selector="TextBox.Field:disabled">
        <Setter Property="Opacity" Value="0.38" />
    </Style>
    <!--  Числовое поле (сумма · порт · HWID) — роль Numeric: табличные цифры,
          значение не «прыгает» при вводе.  -->
    <Style Selector="TextBox.Field.Numeric">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Brand}" />
        <Setter Property="FontFeatures" Value="tnum,lnum,zero" />
    </Style>

    <!-- ==================================================================== -->
    <!--  5. ТУМБЛЕР. Геометрия трека/кнопки живёт в ControlTheme (GlobalResources), -->
    <!--  здесь — состояния уровня контрола, которых у него не было: 0.38 на ВЕСЬ    -->
    <!--  тумблер при выключении и запрет курсора-руки в этом состоянии.             -->
    <!--  Промежуточного состояния у тумблера НЕ СУЩЕСТВУЕТ: тумблер, ждущий сеть,   -->
    <!--  заменяется в строке инлайн-спиннером 20 и не принимает нажатий.            -->
    <!-- ==================================================================== -->
    <Style Selector="ToggleSwitch">
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ToggleSwitch:disabled">
        <Setter Property="Opacity" Value="0.38" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <!-- ==================================================================== -->
    <!--  6. ПУНКТ НАВИГАЦИИ (Button.NavItem + .rail / .bar / .active).           -->
    <!--  Четыре назначения, один активный класс на обеих платформах.             -->
    <!--  Активное состояние читается по ТРЁМ осям (цвет · вес 700 · индикатор),  -->
    <!--  поэтому переживает моно-тему.                                           -->
    <!--  НАЖАТИЕ НЕ ДАЁТ НИЧЕГО: ни ripple, ни свечения, ни масштаба — прямое     -->
    <!--  требование владельца. Отклик несёт сам переход на экран.                 -->
    <!-- ==================================================================== -->
    <Style Selector="Button.NavItem">
        <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.NavItem.rail">
        <Setter Property="Width" Value="76" />
        <Setter Property="Height" Value="64" />
    </Style>
    <Style Selector="Button.NavItem.bar">
        <Setter Property="MinHeight" Value="{DynamicResource Size.Row}" />
    </Style>
    <Style Selector="Button.NavItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.NavItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.NavItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.NavItem PathIcon">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.22" Easing="{StaticResource Ease.Standard}" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.NavItem TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui.Medium}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="LineHeight" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.22" Easing="{StaticResource Ease.Standard}" />
            </Transitions>
        </Setter>
    </Style>
    <!--  Ховер трогает только НЕактивный пункт: активный уже акцентный.  -->
    <Style Selector="Button.NavItem:pointerover:not(.active) PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariantHover}" />
    </Style>
    <Style Selector="Button.NavItem:pointerover:not(.active) TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariantHover}" />
    </Style>
    <Style Selector="Button.NavItem.active PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <Style Selector="Button.NavItem.active TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <!--  Активный индикатор — стадион 64×34 (нативная форма M3-навигации,
          сохранена карве-аутом «треки» в D-6). Позицию ведёт оболочка.  -->
    <Style Selector="Border.NavIndicator">
        <Setter Property="Width" Value="64" />
        <Setter Property="Height" Value="34" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
        <Setter Property="Background" Value="{DynamicResource Brush.AccentContainer}" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <!--  Активная подпись рейла: вес 500 → 700 (раньше в части мест был только цвет).  -->
    <Style Selector="Button.NavRailItem.active TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- ==================================================================== -->
    <!--  7. ПУСТОЕ СОСТОЯНИЕ. Одна грамматика на весь продукт: нейтральная       -->
    <!--  плитка 64 · Headline · одна строка Subtitle · одно действие.            -->
    <!--  Плитка НЕЙТРАЛЬНАЯ, а не акцентная: пустой экран не является главной    -->
    <!--  поверхностью действия и не тратит бюджет акцента на украшение.          -->
    <!-- ==================================================================== -->
    <Style Selector="StackPanel.EmptyState">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="Spacing" Value="8" />
    </Style>
    <Style Selector="StackPanel.EmptyState TextBlock.Headline">
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="StackPanel.EmptyState TextBlock.Subtitle">
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!--  Нейтральный вариант плитки пустого состояния (базовый Border.EmptyIcon
          синий — он остаётся для тех экранов, где пусто И это первичный шаг).  -->
    <Style Selector="Border.EmptyIcon.Neutral">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHighest}" />
    </Style>
    <Style Selector="Border.EmptyIcon.Neutral PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
    </Style>
    <!--  Оффлайн — это НЕ ошибка (15): экран оставляет данные, помечает их
          устаревшими и показывает одну тихую полосу над содержимым.  -->
    <Style Selector="Border.OfflineBar">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHigh}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Chip}" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <!-- ==================================================================== -->
    <!--  8. СКЕЛЕТ. Работает ровно потому, что он — СИЛУЭТ настоящего            -->
    <!--  содержимого: столько же блоков, тех же высот, в тех же позициях.        -->
    <!--  Три плоских прямоугольника вместо карточки тарифа всё равно «хлопнут»   -->
    <!--  при подмене. Появляется через 300мс, уходит кроссфейдом 220.            -->
    <!-- ==================================================================== -->
    <Style Selector="Border.Skeleton">
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Chip}" />
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHighest}" />
    </Style>

    <!-- ==================================================================== -->
    <!--  9. ПРОГРЕСС. Две формы: детерминированная полоса и инлайн-спиннер.      -->
    <!--  Полоса 6 высотой, трек SurfaceHighest, заливка СПЛОШНАЯ акцентом —      -->
    <!--  без градиента: градиент не кодирует ничего, чего не кодирует сплошная    -->
    <!--  заливка той же ширины. Подпись стоит РЯДОМ с полосой, никогда поверх:    -->
    <!--  11px по движущейся заливке измеряется 2.9:1.                             -->
    <!-- ==================================================================== -->
    <Style Selector="Border.Meter">
        <Setter Property="Height" Value="{DynamicResource Size.Meter}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHighest}" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.Meter.Fill">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <!--  Сверх лимита: заливка краснеет, а подпись рядом называет причину словом.  -->
    <Style Selector="Border.Meter.Fill.over">
        <Setter Property="Background" Value="{DynamicResource Brush.Red}" />
    </Style>
    <Style Selector="Border.Meter:disabled">
        <Setter Property="Opacity" Value="0.38" />
    </Style>

    <!-- ==================================================================== -->
    <!--  10. ЗАГРУЗКА КОНТРОЛА. Контракт (2.7): ширина УДЕРЖИВАЕТСЯ, подпись     -->
    <!--  ПРЯЧЕТСЯ (а не удаляется), дуга 20 крутится 1100мс линейно в СОБСТВЕННОМ -->
    <!--  цвете подписи, и это НЕ вид «отключено»: непрозрачность остаётся 1.0,     -->
    <!--  потому что выцветший спиннер читается как «сломано», а не «работает».     -->
    <!--  Поэтому загрузка вешается на IsHitTestVisible, а НЕ на IsEnabled.         -->
    <!--  Фокус сохраняется, чтобы клавиатурного пользователя не выбросило вверх.   -->
    <!-- ==================================================================== -->
    <Style Selector="Button.loading">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <!--  Подпись прячется ПРОЗРАЧНОСТЬЮ: ширина кнопки остаётся прежней, и
          трёхбуквенная подпись со спиннером не дают двух разных ширин.  -->
    <Style Selector="Button.loading TextBlock">
        <Setter Property="Opacity" Value="0" />
    </Style>
    <!--  Инлайн-дуга: 20 внутри кнопки, 2px, круглые торцы. Цвет ставит
          потребитель по хозяину (OnAccent в первичной, OnSurface во вторичной,
          Accent в третичной, белый в деструктивной).  -->
    <Style Selector="Ellipse.Spinner.Inline">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeLineCap" Value="Round" />
    </Style>

    <!-- ==================================================================== -->
    <!--  11. ИНДИКАТОР ВЫБОРА (Border.Selectable + .selected). Самая трогаемая   -->
    <!--  поверхность продукта и та, к которой 7.1 строже всего: минимум ДВЕ оси,  -->
    <!--  никогда один тинт, и НИКАКОГО сдвига геометрии.                          -->
    <!--  Толщина рамки одинакова в обоих состояниях, радиус не меняется, слот     -->
    <!--  галочки зарезервирован ВСЕГДА — поэтому при выборе ничто не              -->
    <!--  переразмечается. Именно этим текущая опция цены и грешила: радиус        -->
    <!--  14 → 20 и штрих 1 → 1.5 на выборе, из-за чего строка видимо прыгала.     -->
    <!-- ==================================================================== -->
    <Style Selector="Border.Selectable">
        <Setter Property="MinHeight" Value="{DynamicResource Size.Row}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Button}" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.OutlineVariant}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.22" Easing="{StaticResource Ease.Standard}" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.22" Easing="{StaticResource Ease.Standard}" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.Selectable:not(.selected):pointerover">
        <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
    </Style>
    <Style Selector="Border.Selectable.pressed">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHigh}" />
    </Style>
    <Style Selector="Border.Selectable.selected">
        <Setter Property="Background" Value="{DynamicResource Brush.SelectedFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <!--  Уже выбранная строка не складывает заливку выбора с ховером: в списке
          одновременно подсвечена ровно одна строка.  -->
    <Style Selector="Border.Selectable.selected:pointerover">
        <Setter Property="Background" Value="{DynamicResource Brush.SelectedFill}" />
    </Style>
    <Style Selector="Border.Selectable.selected TextBlock.Title">
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <!--  Слот галочки зарезервирован всегда: невыбранный — alpha 0, выбранный — 1.
          Ничто не переразмечается, потому что место занято в обоих случаях.  -->
    <Style Selector="Border.Selectable PathIcon.Check">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <Style Selector="Border.Selectable.selected PathIcon.Check">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.Selectable.disabled">
        <Setter Property="Opacity" Value="0.38" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <!-- ==================================================================== -->
    <!--  «Облегчённый режим» (lite / reduced-motion) для слабых ПК: НОЛЬ            -->
    <!--  декоративного движения. Класс .lite ставит окно (MainWindow) по           -->
    <!--  _config.UiItem.LiteMode; :is(Window) нужно, т.к. это подкласс Window.      -->
    <!--                                                                            -->
    <!--  Два рычага (Avalonia не даёт конкурирующему стилю ОТМЕНИТЬ уже            -->
    <!--  запущенную keyframe-анимацию — только не-совпадение селектора её           -->
    <!--  снимает):                                                                 -->
    <!--   1) Transitions → пусто на ВСЕХ интерактивных элементах: press/hover/     -->
    <!--      reveal/nav-crossfade переключаются МГНОВЕННО, без движения.            -->
    <!--   2) Циклические keyframe-анимации, ОПРЕДЕЛЁННЫЕ здесь (Ellipse.Spinner.   -->
    <!--      spinning, :is(Control).SkeletonPulse), гасятся на уровне СЕЛЕКТОРА      -->
    <!--      выше (:is(Window):not(.lite) …) — под lite не аттачатся.               -->
    <!--                                                                            -->
    <!--  Анимации героя (ConnectArc.spinning / Glow.breathing / Sonar.pulsing /     -->
    <!--  Panel.assembling) гасит сам ConnectHeroView по ReducedMotion (LiteMode),   -->
    <!--  page-crossfade — MainWindow (PageTransition=null). Локальные копии          -->
    <!--  Ellipse.Spinner.spinning (LoginView) и StackPanel.SkeletonPulse (BuyView)  -->
    <!--  живут в тех вью — их класс должен гаситься по LiteMode на стороне вью.      -->
    <!-- ==================================================================== -->

    <!--  Все кнопки (Primary/Tonal/Outlined/Stepper/IconButton*/BackNav/LinkAction/ -->
    <!--  Destructive/NavRailItem) — press-scale/hover-переходы мгновенны.            -->
    <Style Selector=":is(Window).lite Button">
        <Setter Property="Transitions">
            <Transitions />
        </Setter>
    </Style>
    <Style Selector=":is(Window).lite ToggleButton">
        <Setter Property="Transitions">
            <Transitions />
        </Setter>
    </Style>
    <Style Selector=":is(Window).lite Border.ServerRow">
        <Setter Property="Transitions">
            <Transitions />
        </Setter>
    </Style>
    <Style Selector=":is(Window).lite Border.PriceOption">
        <Setter Property="Transitions">
            <Transitions />
        </Setter>
    </Style>
    <!--  Диск connect-щита: press-scale 0.94 мгновенно (без пружины 160мс).  -->
    <Style Selector=":is(Window).lite Border.ConnectDisc">
        <Setter Property="Transitions">
            <Transitions />
        </Setter>
    </Style>
    <Style Selector=":is(Window).lite Button.NavRailItem PathIcon">
        <Setter Property="Transitions">
            <Transitions />
        </Setter>
    </Style>
    <Style Selector=":is(Window).lite Button.NavRailItem TextBlock">
        <Setter Property="Transitions">
            <Transitions />
        </Setter>
    </Style>
    <!--  Скроллбар: ширина/opacity/цвет ползунка переключаются МГНОВЕННО под lite.
          Стиль перекрывает Transitions из ControlTheme ползунка (Style > ControlTheme).  -->
    <Style Selector=":is(Window).lite ScrollBar /template/ Thumb#thumb">
        <Setter Property="Transitions">
            <Transitions />
        </Setter>
    </Style>

    <!--  iOS-тумблер (P0-фикс): его переходы трека/кнопки/заливки живут ВНУТРИ шаблона
          ControlTheme, поэтому оконный gate «:is(Window).lite ToggleButton» их НЕ достаёт
          (он гасит Transitions самого контрола, а не его template-children). Гасим переходы
          прямо на частях шаблона — под lite тумблер СНАПает без хода кнопки и кроссфейда трека.
          Селектор бьёт по любому ToggleSwitch с iOS-шаблоном (части track/knobFill только у него).  -->
    <Style Selector=":is(Window).lite ToggleSwitch /template/ Border#track">
        <Setter Property="Transitions">
            <Transitions />
        </Setter>
    </Style>
    <Style Selector=":is(Window).lite ToggleSwitch /template/ Panel#PART_SwitchKnob">
        <Setter Property="Transitions">
            <Transitions />
        </Setter>
    </Style>
    <Style Selector=":is(Window).lite ToggleSwitch /template/ Ellipse#knobFill">
        <Setter Property="Transitions">
            <Transitions />
        </Setter>
    </Style>

    <!--  Новые классы канонического словаря — те же два рычага. Переходы гасим
          на уровне контрола; циклические keyframe-анимации у них не заводятся
          (SkeletonPulse и Spinner уже отсечены селектором :not(.lite) выше).
          FocusAdorner НЕ гасится нигде: доступность выше снижения движения.  -->
    <Style Selector=":is(Window).lite Border.Selectable">
        <Setter Property="Transitions">
            <Transitions />
        </Setter>
    </Style>
    <Style Selector=":is(Window).lite Border.Card">
        <Setter Property="Transitions">
            <Transitions />
        </Setter>
    </Style>
    <Style Selector=":is(Window).lite Border.SubToolbar">
        <Setter Property="Transitions">
            <Transitions />
        </Setter>
    </Style>
    <Style Selector=":is(Window).lite Button.NavItem PathIcon">
        <Setter Property="Transitions">
            <Transitions />
        </Setter>
    </Style>
    <Style Selector=":is(Window).lite Button.NavItem TextBlock">
        <Setter Property="Transitions">
            <Transitions />
        </Setter>
    </Style>
    <Style Selector=":is(Window).lite Button.Icon PathIcon">
        <Setter Property="Transitions">
            <Transitions />
        </Setter>
    </Style>

</Styles>
