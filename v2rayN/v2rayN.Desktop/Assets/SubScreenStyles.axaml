    <!--  ==================== Кнопка «назад» ====================
          40×40, глиф 22, смещена на −8 влево (screens.md): оптический край стрелки садится на ту же
          вертикаль 16, что и текст заголовка и края карточек. Отклик — только прогиб (0.92), без свечения.  -->
    <Style Selector="Button.SubBack">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <!--  КРУГ, а не квадрат: подложка под наведением/нажатием была прямоугольной (владелец:
              «где кнопки назад, там сделай круг, а не квадрат на фоне»). Бокс 40×40 → радиус 20.  -->
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill40}" />
        <Setter Property="Margin" Value="-8,0,0,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Duration="0:0:0.09" Property="RenderTransform" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.SubBack:pressed">
        <Setter Property="RenderTransform" Value="scale(0.90)" />
    </Style>

    <!--  ==================== Заголовок и пояснение ====================  -->
    <Style Selector="TextBlock.SubTitle">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Grotesk}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="LetterSpacing" Value="-0.22" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurface}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!--  Пояснение под заголовком: 13/1.5, ширина ограничена 560 — длинная строка не растягивается
          на всю колонку и читается одним взглядом.  -->
    <Style Selector="TextBlock.SubNote">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="19.5" />
        <Setter Property="MaxWidth" Value="560" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
    </Style>
    <!--  Заголовок группы: 16/700 sentence-case, отступы 18 сверху / 8 снизу, инсет 4 (прототип).  -->
    <Style Selector="TextBlock.SubGroupLabel">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Grotesk}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Margin" Value="4,18,4,8" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurface}" />
    </Style>
    <!--  Сноска под группой: 12/1.5, инсет 4, отступ 10 сверху.  -->
    <Style Selector="TextBlock.SubFoot">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="Margin" Value="4,10,4,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
    </Style>

    <!--  ==================== Карточка группы ====================
          Поверхность, скругление 16, контур 1. ClipToBounds — чтобы ховер крайней строки не вылезал
          прямыми углами за скруглённый край карточки.  -->
    <Style Selector="Border.SubCard">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.OutlineVariant}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <!--  ==================== Строка настроек ====================
          Высота от 56, паддинг 16×9. Отклик — ТОЛЬКО ховер (шаг фона), без прогиба: press-scale
          из строк настроек убран осознанно (коммит «Settings rows: remove press-scale») — строка
          уезжала из-под курсора и жест Tapped отменялся, тап срабатывал через раз.
          Кольцо фокуса внутреннее — строка во всю ширину карточки, внешнее вылезло бы за скругление.  -->
    <Style Selector="Border.SubRow">
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border
                    Margin="3"
                    BorderBrush="{DynamicResource Brush.Accent}"
                    BorderThickness="2"
                    CornerRadius="12" />
            </FocusAdornerTemplate>
        </Setter>
    </Style>
    <!--  Ховер только у СТРОК-ДЕЙСТВИЙ (.tap): строка без действия не должна подсвечиваться —
          это ложный аффорданс (ровно то же правило, что у .segmentRow в GlobalStyles).  -->
    <Style Selector="Border.SubRow.tap">
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.SubRow.tap:pointerover">
        <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
    </Style>
    <Style Selector="Border.SubRow.tap:disabled">
        <Setter Property="Opacity" Value="0.45" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <!--  Разделитель на всю ширину карточки перед каждой строкой кроме первой (tokens.md).  -->
    <Style Selector="Border.SubDivider">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Brush.OutlineVariant}" />
    </Style>

    <!--  ==================== Плитка иконки ====================
          40 со скруглением 10, глиф 22 (tokens.md «Строка настроек»). Одна нейтральная плитка на все
          строки — никаких радужных цветных плиток.  -->
    <Style Selector="Border.SubTile">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{DynamicResource Brush.Tile.Neutral}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.SubTile > PathIcon">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
    </Style>
    <!--  Плитка с буквой (список программ): та же плитка, инициал 15/700.  -->
    <Style Selector="Border.SubTile > TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Grotesk}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
    </Style>

    <!--  ==================== Тексты строки ====================  -->
    <Style Selector="TextBlock.SubName">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="LineHeight" Value="18.2" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurface}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.SubName.accent">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <Style Selector="TextBlock.SubName.danger">
        <Setter Property="Foreground" Value="{DynamicResource Brush.RedText}" />
    </Style>
    <Style Selector="TextBlock.SubName.mono">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Numeric}" />
        <Setter Property="FontFeatures" Value="tnum,lnum,zero" />
    </Style>
    <Style Selector="TextBlock.SubSub">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="16.2" />
        <Setter Property="Margin" Value="0,3,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!--  Значение справа: 12.5, ограничено 200 с многоточием. Обрезается ЗНАЧЕНИЕ, а не заголовок —
          подпись, срезанная на полуслове, хуже, чем её отсутствие.  -->
    <Style Selector="TextBlock.SubValue">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="MaxWidth" Value="200" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
    </Style>
    <Style Selector="TextBlock.SubValue.strong">
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurface}" />
    </Style>
    <Style Selector="TextBlock.SubValue.accent">
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    </Style>

    <!--  Шеврон 18 / каретка 18 / копирование 19 — приглушённые, отступ слева как в прототипе.  -->
    <Style Selector="PathIcon.SubChevron">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
    </Style>
    <Style Selector="PathIcon.SubCopyGlyph">
        <Setter Property="Width" Value="19" />
        <Setter Property="Height" Value="19" />
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
    </Style>

    <!--  ==================== Радио ====================
          20 с обводкой 2, точка 9. Геометрия строки НЕ меняется между выбранным и невыбранным:
          рамка всегда есть (меняется только её цвет), точка всегда занимает место (меняется только
          прозрачность). Ровно то же правило, что у списка серверов на Главной.  -->
    <Style Selector="Border.SubRadio">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Outline}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Duration="0:0:0.22" Property="BorderBrush" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.SubRadio.on">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <Style Selector="Border.SubRadio > Ellipse">
        <Setter Property="Width" Value="9" />
        <Setter Property="Height" Value="9" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Duration="0:0:0.22" Property="Opacity" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.SubRadio.on > Ellipse">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!--  ==================== Чекбокс ====================
          22 со скруглением 7, обводка 2, галочка 15. Как и радио — размеры фиксированы, меняются
          только цвета и прозрачность галочки.  -->
    <Style Selector="Border.SubCheck">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Outline}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Duration="0:0:0.22" Property="BorderBrush" />
                <BrushTransition Duration="0:0:0.22" Property="Background" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.SubCheck.on">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <Style Selector="Border.SubCheck > PathIcon">
        <Setter Property="Width" Value="15" />
        <Setter Property="Height" Value="15" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Duration="0:0:0.22" Property="Opacity" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.SubCheck.on > PathIcon">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!--  ==================== Поле поиска ====================
          Высота 46, скругление 14, контур 1 (tokens.md «поле поиска и мелкая карточка 14»).
          БЕЗ глифа лупы: в кадрах прототипа (B_log, B_perapp) поле поиска — только плейсхолдер.  -->
    <Style Selector="Border.SubSearch">
        <Setter Property="Height" Value="46" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Outline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="15,0" />
    </Style>
    <Style Selector="Border.SubSearch > Grid > TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurface}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <!--  Часть шаблона у Semi зовётся PART_ContentPresenterBorder (PART_BorderElement — имя из
          наших ControlTheme TextBox.Incy*). Селектор с чужим именем не совпадал ни с чем, и Semi
          рисовал под курсором серую подложку внутри поля.  -->
    <Style Selector="Border.SubSearch > Grid > TextBox:focus /template/ Border#PART_ContentPresenterBorder">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.SubSearch > Grid > TextBox:pointerover /template/ Border#PART_ContentPresenterBorder">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!--  ==================== Поле-значение внутри строки ====================
          Порт/адрес правятся прямо в строке — без модалок. Выглядит как значение (12.5, справа),
          рамка появляется только на фокусе, чтобы строка не превращалась в форму.  -->
    <Style Selector="TextBox.SubField">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurface}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="TextBox.SubField /template/ Border#PART_ContentPresenterBorder">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.SubField:pointerover /template/ Border#PART_ContentPresenterBorder">
        <Setter Property="Background" Value="{DynamicResource Brush.PressBg}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.SubField:focus /template/ Border#PART_ContentPresenterBorder">
        <Setter Property="Background" Value="{DynamicResource Brush.PressBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox.SubField:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!--  ==================== Пустое состояние ====================
          Карточка от 230 в высоту: плитка 54 со скруглением 14 и глифом 26 → заголовок 15/700 →
          пояснение 12.5 по центру. Пустой экран — тоже экран, а не «ничего не нашлось».  -->
    <Style Selector="Border.SubEmpty">
        <Setter Property="MinHeight" Value="230" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.OutlineVariant}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.SubEmptyTile">
        <Setter Property="Width" Value="54" />
        <Setter Property="Height" Value="54" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Brush.Tile.Neutral}" />
    </Style>
    <Style Selector="Border.SubEmptyTile > PathIcon">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
    </Style>
    <Style Selector="TextBlock.SubEmptyTitle">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Grotesk}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurface}" />
    </Style>
    <Style Selector="TextBlock.SubEmptyText">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
    </Style>

    <!--  ==================== Моноширинный блок (строки журнала) ====================  -->
    <Style Selector="Border.SubMono">
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="{DynamicResource Brush.PressBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.OutlineVariant}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBlock.SubMonoLine">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Numeric}" />
        <Setter Property="FontFeatures" Value="tnum,lnum,zero" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
    </Style>
</Styles>
