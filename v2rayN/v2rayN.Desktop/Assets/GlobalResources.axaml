<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:v2rayN.Desktop.Converters">
    <!--  departament VPN — server-remark → circular flag image (Assets/Flags/<iso>.png, globe fallback xx.png)  -->
    <conv:RemarkToFlagConverter x:Key="RemarkToFlag" />
    <!--  ProfileItemModel → Incy row strings: EConfigType → protocol chip, item → transport line.  -->
    <conv:ConfigTypeToProtocolConverter x:Key="ConfigTypeToProtocol" />
    <conv:ProfileTransportConverter x:Key="ProfileTransport" />

