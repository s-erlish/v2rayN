<UserControl
    x:Class="v2rayN.Desktop.Views.RoutingSubView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:v2rayN.Desktop.Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:v="clr-namespace:v2rayN.Desktop.Views"
    d:DesignWidth="560"
    d:DesignHeight="680"
    Background="{DynamicResource Brush.Bg}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <StreamGeometry x:Key="Geo.Sub.Back">M20,11H7.83l5.59,-5.59L12,4l-8,8 8,8 1.41,-1.41L7.83,13H20v-2z</StreamGeometry>
        <StreamGeometry x:Key="Geo.Sub.Check">M9,16.17 4.83,12l-1.42,1.41L9,19 21,7l-1.41,-1.41z</StreamGeometry>
        <!--  «{0} правил» — язык-зависимый формат (L.F) поверх целочисленного RuleNum.  -->
        <v:RuleCountConverter x:Key="RuleCountConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.IconButton">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.09" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.IconButton:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)" />
        </Style>

        <!--  Строка профиля маршрутизации: тап = сделать активным. Press scale, hover-подсветка.  -->
        <Style Selector="Border.RouteRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Tile}" />
            <Setter Property="Cursor" Value="Hand" />
            <!--  Кроссфейд заливки снят (F1) — её ведёт ховер. Press-scale остаётся.  -->
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.09" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.RouteRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
        </Style>
        <Style Selector="Border.RouteRow:pressed">
            <Setter Property="RenderTransform" Value="scale(0.99)" />
        </Style>
    </UserControl.Styles>

    <DockPanel MaxWidth="620">
        <Grid
            DockPanel.Dock="Top"
            MinHeight="56"
            Margin="16,8,16,0"
            ColumnDefinitions="Auto,*">
            <Button
                x:Name="btnBack"
                Grid.Column="0"
                Width="40"
                Height="40"
                Padding="0"
                VerticalAlignment="Center"
                Classes="IconButton"
                ToolTip.Tip="{loc:T Common_Back}">
                <PathIcon
                    Width="22"
                    Height="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Data="{StaticResource Geo.Sub.Back}"
                    Foreground="{DynamicResource Brush.OnSurface}" />
            </Button>
            <TextBlock
                Grid.Column="1"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Classes="Headline"
                Text="{loc:T Settings_Routing}"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,12,16,24" Spacing="8">

                <TextBlock
                    Classes="Subtitle"
                    Text="{loc:T Routing_Intro}"
                    TextWrapping="Wrap" />

                <TextBlock Margin="0,6,0,0" Classes="SectionHeader" Text="{loc:T Routing_RuleSets}" />
                <Border Classes="Card" Padding="8,6">
                    <ItemsControl x:Name="listRoutings">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:CompileBindings="False">
                                <Border
                                    Classes="RouteRow"
                                    Padding="12,10"
                                    Tapped="OnRoutingRowTapped">
                                    <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="48">
                                        <!--  Галочка активного набора (иначе прозрачная — сохраняет выравнивание).  -->
                                        <PathIcon
                                            Grid.Column="0"
                                            Width="20"
                                            Height="20"
                                            Margin="4,0,12,0"
                                            VerticalAlignment="Center"
                                            Data="{StaticResource Geo.Sub.Check}"
                                            Foreground="{DynamicResource Brush.Accent}"
                                            IsVisible="{Binding IsActive}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock
                                                Classes="Body"
                                                Text="{Binding Remarks}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Margin="0,3,0,0"
                                                Classes="Subtitle"
                                                Text="{Binding RuleNum, Converter={StaticResource RuleCountConverter}}" />
                                        </StackPanel>
                                        <Border
                                            Grid.Column="2"
                                            Margin="12,0,0,0"
                                            Padding="10,4"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource Brush.SurfaceHigh}"
                                            CornerRadius="{StaticResource Radius.Chip}"
                                            IsVisible="{Binding IsActive}">
                                            <TextBlock
                                                Classes="Chip"
                                                Foreground="{DynamicResource Brush.OnSurfaceVariant}"
                                                Text="{loc:T Routing_Active}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <TextBlock Margin="0,6,0,0" Classes="SectionHeader" Text="{loc:T Routing_DomainStrategy}" />
                <Border Classes="Card" Padding="16,4">
                    <Grid ColumnDefinitions="*,Auto" MinHeight="56">
                        <StackPanel Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock Classes="Body" Text="{loc:T Routing_DomainResolution}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Classes="Subtitle"
                                Text="{loc:T Routing_DomainHint}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox
                            x:Name="cmbStrategy"
                            Grid.Column="1"
                            MinWidth="170"
                            VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <TextBlock Margin="0,6,0,0" Classes="SectionHeader" Text="{loc:T Routing_Maintenance}" />
                <Border Classes="Card" Padding="16,4">
                    <Grid ColumnDefinitions="*,Auto" MinHeight="56">
                        <StackPanel Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock Classes="Body" Text="{loc:T Routing_DefaultRules}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Classes="Subtitle"
                                Text="{loc:T Routing_DefaultRulesHint}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            x:Name="btnResetRules"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Content="{loc:T Routing_Reset}" />
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
