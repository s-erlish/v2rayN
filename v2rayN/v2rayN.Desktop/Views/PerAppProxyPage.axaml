<UserControl
    x:Class="v2rayN.Desktop.Views.PerAppProxyPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:v2rayN.Desktop.Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:v="clr-namespace:v2rayN.Desktop.Views"
    d:DesignWidth="800"
    d:DesignHeight="900"
    mc:Ignorable="d">

    <!--  Фон НЕ задан: подэкран прозрачный, шелл под ним погашен (ApplySubPageShellGate).  -->

    <UserControl.Styles>
        <StyleInclude Source="avares://departament/Assets/SubScreenStyles.axaml" />

        <!--  Каретка строки «Режим»: поворот на 180° за 300 мс, пока окошко открыто (motion.md).  -->
        <Style Selector="PathIcon.ModeCaret">
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Duration="0:0:0.30" Property="RenderTransform" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="PathIcon.ModeCaret.open">
            <Setter Property="RenderTransform" Value="rotate(180deg)" />
        </Style>
        <!--  Значение гаснет до приглушённого, пока окошко открыто (motion.md).  -->
        <Style Selector="TextBlock.ModeValue.open">
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="760"
            Margin="20,10,20,20"
            HorizontalAlignment="Center">

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button
                    x:Name="btnBack"
                    Classes="SubBack"
                    ToolTip.Tip="{loc:T Common_Back}">
                    <PathIcon
                        Width="22"
                        Height="22"
                        Data="{DynamicResource Geo.Sub.Back}"
                        Foreground="{DynamicResource Brush.OnSurface}" />
                </Button>
                <TextBlock Classes="SubTitle" Text="{loc:T Settings_PerApp}" />
            </StackPanel>

            <!--  ==================== Включение + режим ====================
                  ClipToBounds=False — контракт ValuePopup: карточка не имеет права обрезать
                  раскрытое окошко нижней кромкой, поэтому маскировать углы перестаёт она и
                  начинают сами крайние строки (CornerRadius 15 = 16 карточки минус её контур).  -->
            <Border
                Classes="SubCard"
                ClipToBounds="False"
                Margin="0,14,0,0">
                <StackPanel>
                    <Border
                        x:Name="RowEnabled"
                        Classes="SubRow tap"
                        CornerRadius="15,15,0,0">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Classes="SubTile">
                                <PathIcon Data="{DynamicResource Geo.Sub.Grid}" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                Margin="16,0,12,0"
                                VerticalAlignment="Center">
                                <TextBlock Classes="SubName" Text="{loc:T PerApp_SplitTunnel}" />
                                <TextBlock
                                    Classes="SubSub"
                                    Text="{loc:T PerApp_SplitTunnelHint}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="switchEnabled"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Theme="{DynamicResource ToggleSwitch.iOS}" />
                        </Grid>
                    </Border>

                    <Border Classes="SubDivider" />

                    <!--  «Режим» — каретка и окошко у значения, НЕ переключатель по кругу: два
                          варианта, которые меняются местами по тапу, не дают увидеть набор целиком
                          и требуют угадывать, что будет дальше. Окошко — ОБЩИЙ компонент ValuePopup.  -->
                    <Border
                        x:Name="RowMode"
                        Classes="SubRow tap"
                        CornerRadius="0,0,15,15">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <Border Grid.Column="0" Classes="SubTile">
                                <PathIcon Data="{DynamicResource Geo.Sub.Globe}" />
                            </Border>
                            <TextBlock
                                Grid.Column="1"
                                Margin="16,0,12,0"
                                VerticalAlignment="Center"
                                Classes="SubName"
                                Text="{loc:T PerApp_Mode}" />
                            <TextBlock
                                x:Name="txtModeValue"
                                Grid.Column="2"
                                Classes="SubValue strong ModeValue" />
                            <PathIcon
                                x:Name="ModeCaret"
                                Grid.Column="3"
                                Classes="SubChevron ModeCaret"
                                Data="{DynamicResource Geo.Sub.Caret}" />

                            <!--  Компонент занимает 0×0 и не двигает раскладку строки.  -->
                            <v:ValuePopup
                                x:Name="ModePopup"
                                Grid.Column="3"
                                Anchor="{Binding #RowMode}"
                                PopupWidth="196"
                                Trigger="{Binding #RowMode}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!--  ==================== Поиск ====================  -->
            <Border Classes="SubSearch" Margin="0,14,0,0">
                <Grid ColumnDefinitions="Auto,*">
                    <PathIcon
                        Grid.Column="0"
                        Width="18"
                        Height="18"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Data="{DynamicResource Geo.Sub.Search}"
                        Foreground="{DynamicResource Brush.OnSurfaceVariant}" />
                    <TextBox
                        x:Name="txtFilter"
                        Grid.Column="1"
                        PlaceholderText="{loc:T PerApp_Search}" />
                </Grid>
            </Border>

            <!--  ==================== Программы ====================
                  Плитка с инициалом, имя, исполняемый файл, чекбокс. Подпись — имя файла целиком;
                  если оно не влезло, срезается ОНО, а не заголовок строки.  -->
            <TextBlock x:Name="txtProgramsLabel" Classes="SubGroupLabel" />
            <Border Classes="SubCard" x:Name="AppsCard">
                <ItemsControl x:Name="listApps">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                            <StackPanel>
                                <Border Classes="SubDivider" IsVisible="{Binding ShowDivider}" />
                                <Border Classes="SubRow tap" Tapped="OnAppRowTapped">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Classes="SubTile">
                                            <TextBlock Text="{Binding Letter}" />
                                        </Border>
                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="16,0,12,0"
                                            VerticalAlignment="Center">
                                            <TextBlock Classes="SubName" Text="{Binding Display}" />
                                            <TextBlock Classes="SubSub" Text="{Binding Identifier}" />
                                        </StackPanel>
                                        <Border
                                            Grid.Column="2"
                                            Classes="SubCheck"
                                            Classes.on="{Binding IsChecked}">
                                            <PathIcon Data="{DynamicResource Geo.Sub.Check}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!--  Пустое состояние списка — вместо пустой карточки, которая читается как поломка.  -->
            <Border x:Name="AppsEmpty" Classes="SubEmpty" IsVisible="False">
                <StackPanel VerticalAlignment="Center" Spacing="12">
                    <Border Classes="SubEmptyTile">
                        <PathIcon Data="{DynamicResource Geo.Sub.Grid}" />
                    </Border>
                    <TextBlock Classes="SubEmptyTitle" Text="{loc:T PerApp_EmptyTitle}" />
                    <TextBlock Classes="SubEmptyText" Text="{loc:T PerApp_EmptyText}" />
                </StackPanel>
            </Border>

            <!--  ==================== Действия ====================
                  Обновить список процессов и добавить .exe вручную — этого нет в прототипе, но на
                  ПК без них экран нерабочий: список берётся из живых процессов, а закрытую сейчас
                  программу иначе не выбрать. Отдельной группой, акцентом — как «Копировать»/«Очистить».  -->
            <Border Classes="SubCard" Margin="0,14,0,0">
                <StackPanel>
                    <Border
                        x:Name="RowRefresh"
                        Classes="SubRow tap"
                        CornerRadius="15,15,0,0">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" Classes="SubTile">
                                <PathIcon Data="{DynamicResource Geo.Sub.Refresh}" />
                            </Border>
                            <TextBlock
                                Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Classes="SubName accent"
                                Text="{loc:T Common_Refresh}" />
                        </Grid>
                    </Border>
                    <Border Classes="SubDivider" />
                    <Border
                        x:Name="RowAddExe"
                        Classes="SubRow tap"
                        CornerRadius="0,0,15,15">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" Classes="SubTile">
                                <PathIcon Data="{DynamicResource Geo.Sub.File}" />
                            </Border>
                            <TextBlock
                                Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Classes="SubName accent"
                                Text="{loc:T PerApp_AddExe}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Classes="SubFoot" Text="{loc:T PerApp_TunHint}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
