<UserControl
    x:Class="v2rayN.Desktop.Views.CheckUpdateView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:v2rayN.Desktop.Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:v="clr-namespace:v2rayN.Desktop.Views"
    d:DesignWidth="800"
    d:DesignHeight="620"
    mc:Ignorable="d">

    <!--  Фон НЕ задан: подэкран прозрачный, шелл под ним погашен (ApplySubPageShellGate).  -->

    <UserControl.Styles>
        <StyleInclude Source="avares://departament/Assets/SubScreenStyles.axaml" />
    </UserControl.Styles>

    <UserControl.Resources>
        <v:UpdateAnswerVisibleConverter x:Key="AnswerVisible" />

        <!--  ==================== Глиф «скачать и поставить» ====================
              Строк-действий две, и они разные по последствиям, поэтому и глифы разные: у «Проверить
              обновление» — круговая стрелка (только спросить), у «Обновить сейчас» — стрелка В приёмник
              (скачать и записать). Раньше здесь стоял Geo.Sub.Backup — глиф резервной копии, он обещает
              не то действие. 24-я сетка, как остальные глифы лекала.  -->
        <StreamGeometry x:Key="Geo.Update.Install">M19,9h-4V3H9v6H5l7,7 7,-7zM5,18v2h14v-2H5z</StreamGeometry>

        <!--  ==================== ТУМБЛЕР СТРОКИ ====================
              tokens.md «Тумблер»: 46×28, скругление 14, обводка 2.
                · выключен — трек «вариант поверхности» с контуром, бегунок 14, ход 5, цвет
                  приглушённых чернил;
                · включён  — трек и контур акцентные, бегунок 20, ход 20, белый.
              Обводка входит в габарит (box-sizing: border-box в прототипе), поэтому ход бегунка
              отсчитывается от ВНУТРЕННЕЙ кромки: 5 и 20 — координаты внутри поля 42×24.
              Движение 220 мс ease-out-quart (motion.md «Тумблер»): трек, контур, положение и РАЗМЕР.

              Общий ToggleSwitch.iOS сюда не годится: там трек 52×32 и бегунок 26 постоянного размера
              без обводки — другая фигура, в кадре прототипа её нет. Прототип держит ОДИН тумблер на все
              экраны, поэтому правильное место этой ControlTheme — Assets/GlobalResources.axaml рядом с
              ToggleSwitch.iOS; файл занят, заявка на промоушен — в отчёте. Ровно та же ControlTheme уже
              лежит локально в SettingsView.axaml (ToggleSwitch.Row) — после промоушена обе копии
              удаляются одним движением.

              Габарит трека НЕИЗМЕНЕН — его можно ставить прямо в шаблоне. Всё, что переключается
              состоянием (цвета, размер и ход бегунка), задаётся ТОЛЬКО селекторами: значение,
              записанное в шаблоне, стало бы локальным и перебило бы стиль :checked.  -->
        <ControlTheme x:Key="ToggleSwitch.Row" TargetType="ToggleSwitch">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        x:Name="track"
                        Width="46"
                        Height="28"
                        BorderThickness="2"
                        CornerRadius="14">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition
                                    Duration="0:0:0.22"
                                    Easing="{StaticResource Ease.OutQuart}"
                                    Property="Background" />
                                <BrushTransition
                                    Duration="0:0:0.22"
                                    Easing="{StaticResource Ease.OutQuart}"
                                    Property="BorderBrush" />
                            </Transitions>
                        </Border.Transitions>
                        <!--  PART_MovingKnobs / PART_SwitchKnob — обязательные части ToggleSwitch (AVLN2205).  -->
                        <Panel x:Name="PART_MovingKnobs">
                            <Panel
                                x:Name="PART_SwitchKnob"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                                <Panel.Transitions>
                                    <Transitions>
                                        <TransformOperationsTransition
                                            Duration="0:0:0.22"
                                            Easing="{StaticResource Ease.OutQuart}"
                                            Property="RenderTransform" />
                                        <DoubleTransition
                                            Duration="0:0:0.22"
                                            Easing="{StaticResource Ease.OutQuart}"
                                            Property="Width" />
                                        <DoubleTransition
                                            Duration="0:0:0.22"
                                            Easing="{StaticResource Ease.OutQuart}"
                                            Property="Height" />
                                    </Transitions>
                                </Panel.Transitions>
                                <Ellipse x:Name="knobFill">
                                    <Ellipse.Transitions>
                                        <Transitions>
                                            <BrushTransition
                                                Duration="0:0:0.22"
                                                Easing="{StaticResource Ease.OutQuart}"
                                                Property="Fill" />
                                        </Transitions>
                                    </Ellipse.Transitions>
                                </Ellipse>
                            </Panel>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>

            <!--  ВЫКЛЮЧЕН  -->
            <Style Selector="^ /template/ Border#track">
                <Setter Property="Background" Value="{DynamicResource Brush.SurfaceVariant}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Outline}" />
            </Style>
            <Style Selector="^ /template/ Panel#PART_SwitchKnob">
                <Setter Property="Width" Value="14" />
                <Setter Property="Height" Value="14" />
                <Setter Property="RenderTransform" Value="translateX(5px)" />
            </Style>
            <Style Selector="^ /template/ Ellipse#knobFill">
                <Setter Property="Fill" Value="{DynamicResource Brush.OnSurfaceVariant}" />
            </Style>

            <!--  ВКЛЮЧЁН  -->
            <Style Selector="^:checked /template/ Border#track">
                <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
            </Style>
            <Style Selector="^:checked /template/ Panel#PART_SwitchKnob">
                <Setter Property="Width" Value="20" />
                <Setter Property="Height" Value="20" />
                <Setter Property="RenderTransform" Value="translateX(20px)" />
            </Style>
            <Style Selector="^:checked /template/ Ellipse#knobFill">
                <Setter Property="Fill" Value="White" />
            </Style>

            <Style Selector="^:disabled">
                <Setter Property="Opacity" Value="0.38" />
            </Style>
        </ControlTheme>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <!--  HorizontalAlignment НЕ Center: у центрированного StackPanel ширина = ширине САМОЙ ШИРОКОЙ
              строки, и карточка сжимается вдвое. Stretch (по умолчанию) отдаёт всю ширину, MaxWidth её
              ограничивает, а остаток раскладка делит поровну — блок и растягивается, и остаётся по центру.

              MaxWidth 720, а НЕ 760: в прототипе колонка 760 при `box-sizing:border-box`, поля 20 внутри —
              карточка выходит 720 (замерено по кадру: 360…1080 при рейле 74). В Avalonia Margin лежит
              СНАРУЖИ MaxWidth, поэтому 760 + поля дали бы карточку 760 — на 40 шире кадра.
              В узком окне (420) MaxWidth не срабатывает, и те же поля 20 дают карточку 380 — как в
              узком кадре.  -->
        <StackPanel MaxWidth="720" Margin="20,10,20,20">

            <!--  Отступ 2 сверху — из лекала прототипа (`padding:2px 0 0` на строке заголовка): без него
                  весь экран стоит на 2 выше кадра (карточка на 104 от верха окна вместо 106).
                  Место этой двойки — в общем лекале (SubScreenStyles), заявка в отчёте.  -->
            <StackPanel
                Margin="0,2,0,0"
                Orientation="Horizontal"
                Spacing="10">
                <Button
                    x:Name="btnBack"
                    Classes="SubBack"
                    ToolTip.Tip="{loc:T Common_Back}">
                    <PathIcon
                        Width="22"
                        Height="22"
                        Data="{DynamicResource Geo.Sub.Back}"
                        Foreground="{DynamicResource Brush.OnSurface}" />
                </Button>
                <TextBlock Classes="SubTitle" Text="{loc:T Update_Title}" />
            </StackPanel>

            <!--  ==================== Предварительные выпуски + действия ====================
                  Действий ДВА, потому что в движке их два и они разные: «Проверить обновление»
                  только спрашивает у релизов, есть ли новая версия, а «Обновить сейчас» качает и
                  ставит. Одна кнопка на оба означала бы, что нажатие «просто посмотреть» молча
                  подменит ядро.

                  Пока команда идёт, глиф строки в плитке подменяется вращающимся кругом — тем же
                  приёмом, что пинг и обновление подписки (motion.md «Пинг и обновление подписки»:
                  «на месте иконки вращается круг»). Текстового «Проверяем…» справа нет: в кадре у
                  строк-действий правого слота не существует, а слово, появляющееся и исчезающее,
                  дёргало бы строку.  -->
            <Border Classes="SubCard" Margin="0,14,0,0">
                <StackPanel>
                    <Border x:Name="RowPreRelease" Classes="SubRow tap">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Classes="SubTile">
                                <PathIcon Data="{DynamicResource Geo.Sub.Frag}" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                Margin="16,0,8,0"
                                VerticalAlignment="Center">
                                <TextBlock Classes="SubName" Text="{loc:T Update_PreRelease}" />
                                <TextBlock
                                    Classes="SubSub"
                                    Text="{loc:T Update_PreReleaseHint}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="togEnableCheckPreReleaseUpdate"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Theme="{StaticResource ToggleSwitch.Row}" />
                        </Grid>
                    </Border>

                    <Border Classes="SubDivider" />

                    <Border x:Name="RowCheckOnly" Classes="SubRow tap">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" Classes="SubTile">
                                <Panel>
                                    <PathIcon
                                        x:Name="icoCheckOnly"
                                        Width="22"
                                        Height="22"
                                        Data="{DynamicResource Geo.Sub.Refresh}"
                                        Foreground="{DynamicResource Brush.OnSurfaceVariant}" />
                                    <Ellipse
                                        x:Name="spinCheckOnly"
                                        Width="18"
                                        Height="18"
                                        Classes="Spinner"
                                        IsVisible="False"
                                        Stroke="{DynamicResource Brush.OnSurfaceVariant}"
                                        StrokeDashArray="7.1,21.2"
                                        StrokeLineCap="Round"
                                        StrokeThickness="2">
                                        <!--  Явный центр вращения (половина 18 = 9): глобальный
                                              Ellipse.Spinner.spinning крутит RotateTransform.Angle,
                                              origin к нему не применяется — без CenterX/CenterY дуга
                                              «облетала» бы вместо вращения.  -->
                                        <Ellipse.RenderTransform>
                                            <RotateTransform
                                                Angle="0"
                                                CenterX="9"
                                                CenterY="9" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Panel>
                            </Border>
                            <TextBlock
                                x:Name="txtCheckOnly"
                                Grid.Column="1"
                                Margin="16,0,8,0"
                                VerticalAlignment="Center"
                                Classes="SubName accent"
                                Text="{loc:T Update_Check}" />
                        </Grid>
                    </Border>

                    <Border Classes="SubDivider" />

                    <Border x:Name="RowInstall" Classes="SubRow tap">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" Classes="SubTile">
                                <Panel>
                                    <PathIcon
                                        x:Name="icoInstall"
                                        Width="22"
                                        Height="22"
                                        Data="{DynamicResource Geo.Update.Install}"
                                        Foreground="{DynamicResource Brush.OnSurfaceVariant}" />
                                    <Ellipse
                                        x:Name="spinInstall"
                                        Width="18"
                                        Height="18"
                                        Classes="Spinner"
                                        IsVisible="False"
                                        Stroke="{DynamicResource Brush.OnSurfaceVariant}"
                                        StrokeDashArray="7.1,21.2"
                                        StrokeLineCap="Round"
                                        StrokeThickness="2">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform
                                                Angle="0"
                                                CenterX="9"
                                                CenterY="9" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Panel>
                            </Border>
                            <TextBlock
                                x:Name="txtInstall"
                                Grid.Column="1"
                                Margin="16,0,8,0"
                                VerticalAlignment="Center"
                                Classes="SubName accent"
                                Text="{loc:T Update_Now}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!--  ==================== Компоненты ====================
                  В кадре этой группы нет, но в ветке обновляемых частей несколько (приложение, ядра,
                  Geo-базы) и выбор реально хранится в конфиге. Убрать группу значило бы выключить
                  выбор, а не упростить экран.

                  Подпись строки — ЖИВОЙ ответ проверки (Remarks движка). До первой проверки движок
                  держит там свою менюшную надпись «Обновить» — как подзаголовок она читается как
                  обещание действия, которого в строке нет, поэтому до ответа подписи нет вовсе.  -->
            <TextBlock Classes="SubGroupLabel" Text="{loc:T Update_Components}" />
            <Border Classes="SubCard">
                <ItemsControl x:Name="listComponents">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                            <StackPanel>
                                <Border Classes="SubDivider" IsVisible="{Binding ShowDivider}" />
                                <Border Classes="SubRow tap" Tapped="OnComponentRowTapped">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Classes="SubTile">
                                            <PathIcon Data="{DynamicResource Geo.Sub.File}" />
                                        </Border>
                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="16,0,8,0"
                                            VerticalAlignment="Center">
                                            <TextBlock Classes="SubName" Text="{Binding Title}" />
                                            <TextBlock
                                                Classes="SubSub"
                                                IsVisible="{Binding Model.Remarks, Converter={StaticResource AnswerVisible}}"
                                                Text="{Binding Model.Remarks}" />
                                        </StackPanel>
                                        <ToggleSwitch
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            IsChecked="{Binding IsOn, Mode=TwoWay}"
                                            Theme="{StaticResource ToggleSwitch.Row}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <TextBlock x:Name="txtFoot" Classes="SubFoot" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
