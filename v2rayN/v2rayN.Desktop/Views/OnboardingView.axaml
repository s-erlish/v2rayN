<UserControl
    x:Class="v2rayN.Desktop.Views.OnboardingView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vms="clr-namespace:v2rayN.Desktop.ViewModels"
    d:DesignHeight="720"
    d:DesignWidth="1120"
    x:DataType="vms:HomeViewModel"
    Design.DataContext="{x:Static dd:DesignData.Home}"
    mc:Ignorable="d">

    <!--  ================================================================================
          Первый запуск (нет подписок): приветствие на всю ширину окна под chrome — без рейла,
          без списка серверов, без connect-щита. Появляется, пока HomeViewModel.IsEmpty=true;
          после добавления подписки MainWindow показывает обычный шелл.
          Раскладка: центрированная колонка (~440) на радиальном фоне Главной (Brush.HomeGradient).
          Тексты verbatim из Android strings(-ru).xml: home_welcome_title / home_empty_subtitle /
          home_empty_add_qr / home_empty_add_clipboard / home_or_sign_in / auth_sign_in_telegram /
          auth_sign_in_site. Дизайн: Incy (pure dark + один синий), sentence-case, без AI-slop.
          Действия проводит code-behind по DataContext (HomeViewModel).
          =================================================================================  -->

    <Border Background="{DynamicResource Brush.HomeGradient}">
        <StackPanel
            Width="440"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <!--  Брендовый знак departament (эмблема-акцент + вордмарк Space Grotesk).  -->
            <StackPanel HorizontalAlignment="Center">
                <Border
                    Width="44"
                    Height="44"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource Brush.Accent}"
                    CornerRadius="13">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{DynamicResource Font.Grotesk}"
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="{DynamicResource Brush.OnAccent}"
                        Text="d" />
                </Border>
                <TextBlock
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    FontFamily="{DynamicResource Font.Grotesk}"
                    FontSize="16"
                    FontWeight="Medium"
                    Foreground="{DynamicResource Brush.OnSurface}"
                    Text="departament" />
            </StackPanel>

            <!--  Приветствие (home_welcome_title).  -->
            <TextBlock
                Margin="0,24,0,0"
                HorizontalAlignment="Center"
                Classes="Headline"
                Text="Приветствуем!"
                TextAlignment="Center" />

            <!--  Подзаголовок (home_empty_subtitle).  -->
            <TextBlock
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Classes="Subtitle"
                Text="Добавьте подписку, чтобы начать пользоваться"
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <!--  Добавить по QR-коду (home_empty_add_qr) — глиф ic_scan_24dp.  -->
            <Button
                x:Name="AddQrButton"
                Margin="0,24,0,0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Classes="Primary">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <Path
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        Data="F1 M181.333333 384a32 32 0 0 1-64 0v-111.146667a155.52 155.52 0 0 1 155.52-155.52H384a32 32 0 0 1 0 64h-111.146667a91.52 91.52 0 0 0-91.52 91.52V384zM640 181.333333a32 32 0 0 1 0-64h111.146667a155.52 155.52 0 0 1 155.52 155.52V384a32 32 0 0 1-64 0v-111.146667a91.52 91.52 0 0 0-91.52-91.52H640zM842.666667 640a32 32 0 0 1 64 0v111.146667a155.52 155.52 0 0 1-155.52 155.52H640a32 32 0 0 1 0-64h111.146667a91.52 91.52 0 0 0 91.52-91.52V640zM384 842.666667a32 32 0 0 1 0 64h-111.146667a155.52 155.52 0 0 1-155.52-155.52V640a32 32 0 0 1 64 0v111.146667a91.52 91.52 0 0 0 91.52 91.52H384z m-192-298.666667a32 32 0 0 1 0-64h640a32 32 0 0 1 0 64H192z"
                        Fill="{DynamicResource Brush.OnAccent}"
                        Stretch="Uniform" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource Brush.OnAccent}"
                        Text="Добавить по QR-коду" />
                </StackPanel>
            </Button>

            <!--  Добавить из буфера обмена (home_empty_add_clipboard) — глиф ic_copy.  -->
            <Button
                x:Name="AddClipboardButton"
                Margin="0,8,0,0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Classes="OutlinedAccent">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <Path
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        Data="F1 M16,1L4,1c-1.1,0 -2,0.9 -2,2v14h2L4,3h12L16,1zM19,5L8,5c-1.1,0 -2,0.9 -2,2v14c0,1.1 0.9,2 2,2h11c1.1,0 2,-0.9 2,-2L21,7c0,-1.1 -0.9,-2 -2,-2zM19,21L8,21L8,7h11v14z"
                        Fill="{DynamicResource Brush.Accent}"
                        Stretch="Uniform" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource Brush.Accent}"
                        Text="Добавить из буфера обмена" />
                </StackPanel>
            </Button>

            <!--  Разделитель-подпись (home_or_sign_in).  -->
            <TextBlock
                Margin="0,16,0,0"
                HorizontalAlignment="Center"
                Classes="Caption"
                Text="Или войдите в свой аккаунт"
                TextAlignment="Center" />

            <!--  Войти через Telegram (auth_sign_in_telegram) — глиф ic_telegram_24dp.  -->
            <Button
                x:Name="LoginTelegramButton"
                Margin="0,8,0,0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Classes="Tonal">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <Path
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        Data="F1 M912.2,154A85.3,85.3 0,0 0,853.3 128a85.3,85.3 0,0 0,-33.3 6.8l-708.3,306.8a42.7,42.7 0,0 0,-26.5 42.7V512a42.7,42.7 0,0 0,29.4 42.7L298.7,616.1l55.5,187.3a75.9,75.9 0,0 0,56.3 53.3,62.7 62.7,0 0,0 15.4,0 73.8,73.8 0,0 0,50.8 -20.5l67.8,-64 131.4,103.7a85.3,85.3 0,0 0,90 9.4l14.1,-7.3a88.3,88.3 0,0 0,46.5 -62.7L938.7,235.1a90,90 0,0 0,-26.5 -81.1zM763.7,805.1a25.2,25.2 0,0 1,-12.8 17.5l-14.1,7.3a19.6,19.6 0,0 1,-9 2.1,19.6 19.6,0 0,1 -12.4,-4.7l-160.4,-128a20.9,20.9 0,0 0,-27.7 0l-94.7,89.2a11.1,11.1 0,0 1,-6 2.1V640a21.8,21.8 0,0 1,6.8 -15.8c136.1,-128 217.6,-199.7 266.2,-240.6a15.8,15.8 0,0 0,5.1 -11.1,13.7 13.7,0 0,0 -4.3,-11.1 14.9,14.9 0,0 0,-17.9 -4.3l-322.6,203.5a21.3,21.3 0,0 1,-18.3 0L149.3,494.9l694.2,-301.2a16.6,16.6 0,0 1,7.7 0,22.2 22.2,0 0,1 16.2,7.7 26.9,26.9 0,0 1,6.8 23.5z"
                        Fill="{DynamicResource Brush.OnSurface}"
                        Stretch="Uniform" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource Brush.OnSurface}"
                        Text="Войти через Telegram" />
                </StackPanel>
            </Button>

            <!--  Войти через сайт (auth_sign_in_site) — глиф ic_globe_24dp.  -->
            <Button
                x:Name="LoginSiteButton"
                Margin="0,8,0,0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Classes="OutlinedAccent">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <Path
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        Data="F1 M12,2C6.48,2 2,6.48 2,12s4.48,10 10,10 10,-4.48 10,-10S17.52,2 12,2zM11,19.93c-3.95,-0.49 -7,-3.85 -7,-7.93 0,-0.62 0.08,-1.21 0.21,-1.79L9,15v1c0,1.1 0.9,2 2,2v1.93zM17.9,17.39c-0.26,-0.81 -1,-1.39 -1.9,-1.39h-1v-3c0,-0.55 -0.45,-1 -1,-1H8v-2h2c0.55,0 1,-0.45 1,-1V7h2c1.1,0 2,-0.9 2,-2v-0.41c2.93,1.19 5,4.06 5,7.41 0,2.08 -0.8,3.97 -2.1,5.39z"
                        Fill="{DynamicResource Brush.Accent}"
                        Stretch="Uniform" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource Brush.Accent}"
                        Text="Войти через сайт" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
