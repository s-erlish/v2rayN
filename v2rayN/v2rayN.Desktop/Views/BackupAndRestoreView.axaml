<UserControl
    x:Class="v2rayN.Desktop.Views.BackupAndRestoreView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:v2rayN.Desktop.Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignWidth="800"
    d:DesignHeight="620"
    mc:Ignorable="d">

    <!--  Фон НЕ задан: подэкран прозрачный, шелл под ним погашен (ApplySubPageShellGate).  -->

    <UserControl.Styles>
        <StyleInclude Source="avares://departament/Assets/SubScreenStyles.axaml" />
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="760"
            Margin="20,10,20,20"
            HorizontalAlignment="Center">

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button
                    x:Name="btnBack"
                    Classes="SubBack"
                    ToolTip.Tip="{loc:T Common_Back}">
                    <PathIcon
                        Width="22"
                        Height="22"
                        Data="{DynamicResource Geo.Sub.Back}"
                        Foreground="{DynamicResource Brush.OnSurface}" />
                </Button>
                <TextBlock Classes="SubTitle" Text="{loc:T Backup_WebDav}" />
            </StackPanel>
            <TextBlock
                Margin="0,8,0,0"
                Classes="SubNote"
                Text="{loc:T Backup_WebDavIntro}" />

            <!--  ==================== Сервер ====================
                  Поля правятся прямо в строках — без формы и без модалок: это те же четыре значения,
                  что и на всех остальных подэкранах, а не отдельный диалог настройки.  -->
            <TextBlock Classes="SubGroupLabel" Text="{loc:T Backup_WebDavServer}" />
            <Border Classes="SubCard">
                <StackPanel>
                    <Border Classes="SubRow">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Classes="SubTile">
                                <PathIcon Data="{DynamicResource Geo.Sub.Globe}" />
                            </Border>
                            <TextBlock
                                Grid.Column="1"
                                Margin="16,0,12,0"
                                VerticalAlignment="Center"
                                Classes="SubName"
                                Text="{loc:T Backup_WebDavUrl}" />
                            <TextBox
                                x:Name="txtWebDavUrl"
                                Grid.Column="2"
                                MinWidth="260"
                                Classes="SubField" />
                        </Grid>
                    </Border>

                    <Border Classes="SubDivider" />
                    <Border Classes="SubRow">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Classes="SubTile">
                                <PathIcon Data="{DynamicResource Geo.Sub.Lock}" />
                            </Border>
                            <TextBlock
                                Grid.Column="1"
                                Margin="16,0,12,0"
                                VerticalAlignment="Center"
                                Classes="SubName"
                                Text="{loc:T LocalProxy_Login}" />
                            <TextBox
                                x:Name="txtWebDavUserName"
                                Grid.Column="2"
                                MinWidth="180"
                                Classes="SubField" />
                        </Grid>
                    </Border>

                    <Border Classes="SubDivider" />
                    <Border Classes="SubRow">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Classes="SubTile">
                                <PathIcon Data="{DynamicResource Geo.Sub.Lock}" />
                            </Border>
                            <TextBlock
                                Grid.Column="1"
                                Margin="16,0,12,0"
                                VerticalAlignment="Center"
                                Classes="SubName"
                                Text="{loc:T LocalProxy_Password}" />
                            <TextBox
                                x:Name="txtWebDavPassword"
                                Grid.Column="2"
                                MinWidth="180"
                                Classes="SubField"
                                PasswordChar="•" />
                        </Grid>
                    </Border>

                    <Border Classes="SubDivider" />
                    <Border Classes="SubRow">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Classes="SubTile">
                                <PathIcon Data="{DynamicResource Geo.Sub.File}" />
                            </Border>
                            <TextBlock
                                Grid.Column="1"
                                Margin="16,0,12,0"
                                VerticalAlignment="Center"
                                Classes="SubName"
                                Text="{loc:T Backup_WebDavFolder}" />
                            <TextBox
                                x:Name="txtWebDavDirName"
                                Grid.Column="2"
                                MinWidth="180"
                                Classes="SubField" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!--  ==================== Действия ====================
                  Порядок — по возрастанию последствий: проверить связь, выгрузить копию, и только
                  потом восстановление, которое заменит текущие серверы.  -->
            <TextBlock Classes="SubGroupLabel" Text="{loc:T Backup_SecActions}" />
            <Border Classes="SubCard">
                <StackPanel>
                    <Border x:Name="RowCheck" Classes="SubRow tap">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" Classes="SubTile">
                                <PathIcon Data="{DynamicResource Geo.Sub.Router}" />
                            </Border>
                            <TextBlock
                                x:Name="txtCheck"
                                Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Classes="SubName accent"
                                Text="{loc:T Backup_WebDavCheck}" />
                        </Grid>
                    </Border>

                    <Border Classes="SubDivider" />
                    <Border x:Name="RowUpload" Classes="SubRow tap">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" Classes="SubTile">
                                <PathIcon Data="{DynamicResource Geo.Sub.Backup}" />
                            </Border>
                            <TextBlock
                                x:Name="txtUpload"
                                Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Classes="SubName accent"
                                Text="{loc:T Backup_CloudUpload}" />
                        </Grid>
                    </Border>

                    <Border Classes="SubDivider" />
                    <Border x:Name="RowDownload" Classes="SubRow tap">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" Classes="SubTile">
                                <PathIcon Data="{DynamicResource Geo.Sub.Refresh}" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="txtDownload"
                                    Classes="SubName accent"
                                    Text="{loc:T Backup_CloudRestore}" />
                                <TextBlock
                                    Classes="SubSub"
                                    Text="{loc:T Backup_RestoreFileHint}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock x:Name="txtMsg" Classes="SubFoot" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
