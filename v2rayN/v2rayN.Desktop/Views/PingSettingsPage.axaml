<UserControl
    x:Class="v2rayN.Desktop.Views.PingSettingsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:v2rayN.Desktop.Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignWidth="800"
    d:DesignHeight="620"
    mc:Ignorable="d">

    <!--  Фон НЕ задан: подэкран прозрачный, шелл под ним погашен (ApplySubPageShellGate).  -->

    <UserControl.Styles>
        <StyleInclude Source="avares://departament/Assets/SubScreenStyles.axaml" />
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <!--  Колонка подэкрана: карточки 720 + поля по 20 = внешний габарит 760, как в прототипе
              (`max-width:760;padding:0 20px`). В Avalonia Margin лежит СНАРУЖИ MaxWidth, поэтому
              ту же геометрию даёт 720 + поля 20 — ровно как в колонке вкладки настроек, чтобы
              карточки не меняли ширину при входе в подэкран.
              Выравнивание Stretch, а НЕ Center — см. SubScreenStyles.axaml, «Ширина колонки»:
              Center отдаёт панели её желаемую ширину, и карточка съёживается по самой длинной
              строке, у каждого экрана до своей.  -->
        <StackPanel
            MaxWidth="720"
            Margin="20,10,20,20"
            HorizontalAlignment="Stretch">

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button
                    x:Name="btnBack"
                    Classes="SubBack"
                    ToolTip.Tip="{loc:T Common_Back}">
                    <PathIcon
                        Width="22"
                        Height="22"
                        Data="{DynamicResource Geo.Sub.Back}"
                        Foreground="{DynamicResource Brush.OnSurface}" />
                </Button>
                <TextBlock Classes="SubTitle" Text="{loc:T Settings_Ping}" />
            </StackPanel>
            <TextBlock
                Margin="0,8,0,0"
                Classes="SubNote"
                Text="{loc:T Ping_Intro}" />

            <!--  ==================== Метод ====================
                  Радио. Спецификация просит четыре метода, ядро умеет два: HTTP-запрос и ICMP
                  в ESpeedActionType отсутствуют, а SpeedtestService сводит неизвестный метод к
                  реальной задержке. Показывать неработающий выбор — врать пользователю, поэтому
                  строк две, а сноска под группой честно называет причину.  -->
            <Border Classes="SubCard" Margin="0,14,0,0">
                <StackPanel>
                    <Border x:Name="RowReal" Classes="SubRow tap">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Classes="SubName" Text="{loc:T Ping_RealTitle}" />
                                <TextBlock
                                    Classes="SubSub"
                                    Text="{loc:T Ping_RealHint}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Border x:Name="DotReal" Grid.Column="1" Classes="SubRadio">
                                <Ellipse />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Classes="SubDivider" />
                    <Border x:Name="RowTcp" Classes="SubRow tap">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Classes="SubName" Text="{loc:T Ping_TcpTitle}" />
                                <TextBlock
                                    Classes="SubSub"
                                    Text="{loc:T Ping_TcpHint}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Border x:Name="DotTcp" Grid.Column="1" Classes="SubRadio">
                                <Ellipse />
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
            <TextBlock Classes="SubFoot" Text="{loc:T Ping_Unsupported}" />

            <!--  ==================== Параметры проверки ====================
                  Адрес и тайм-аут правятся прямо в строке (TextBox.SubField): значение справа, рамка
                  появляется только на фокусе — строка не превращается в форму.  -->
            <TextBlock Classes="SubGroupLabel" Text="{loc:T Ping_Params}" />
            <Border Classes="SubCard">
                <StackPanel>
                    <Border Classes="SubRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock
                                Grid.Column="0"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Classes="SubName"
                                Text="{loc:T Ping_TestAddress}" />
                            <TextBox
                                x:Name="txtPingUrl"
                                Grid.Column="1"
                                MinWidth="260"
                                Classes="SubField"
                                PlaceholderText="https://www.gstatic.com/generate_204" />
                        </Grid>
                    </Border>

                    <Border Classes="SubDivider" />
                    <Border Classes="SubRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock
                                Grid.Column="0"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Classes="SubName"
                                Text="{loc:T Ping_Timeout}" />
                            <TextBox
                                x:Name="txtTimeout"
                                Grid.Column="1"
                                Classes="SubField"
                                MaxLength="3"
                                PlaceholderText="5" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
