<UserControl
    x:Class="v2rayN.Desktop.Views.PingSettingsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignWidth="520"
    d:DesignHeight="440"
    Background="{DynamicResource Brush.Bg}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <StreamGeometry x:Key="Geo.Sub.Back">M20,11H7.83l5.59,-5.59L12,4l-8,8 8,8 1.41,-1.41L7.83,13H20v-2z</StreamGeometry>
        <!--  Галочка выбранного метода (ic_check_24dp)  -->
        <StreamGeometry x:Key="Geo.Sub.Check">M9,16.17L4.83,12l-1.42,1.41L9,19 21,7l-1.41,-1.41z</StreamGeometry>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.IconButton">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.09" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.IconButton:pressed">
            <Setter Property="RenderTransform" Value="scale(0.92)" />
        </Style>

        <!--  Строка выбора метода пинга: minHeight 56, hover→Hover (затемнение) внутри клипующей карты.  -->
        <Style Selector="Border.MethodRow">
            <Setter Property="MinHeight" Value="{DynamicResource Size.Row}" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.MethodRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
        </Style>
        <!--  Галочка выбранного метода: 22, акцент, по правому краю.  -->
        <Style Selector="PathIcon.MethodCheck">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <!--  Разделитель 1px, инсет слева 16.  -->
        <Style Selector="Border.MethodDivider">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="16,0,0,0" />
            <Setter Property="Background" Value="{DynamicResource Brush.OutlineVariant}" />
        </Style>
    </UserControl.Styles>

    <DockPanel MaxWidth="620">
        <Grid
            DockPanel.Dock="Top"
            MinHeight="56"
            Margin="16,8,16,0"
            ColumnDefinitions="Auto,*">
            <Button
                x:Name="btnBack"
                Grid.Column="0"
                Width="40"
                Height="40"
                Padding="0"
                VerticalAlignment="Center"
                Classes="IconButton"
                ToolTip.Tip="Назад">
                <PathIcon
                    Width="22"
                    Height="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Data="{StaticResource Geo.Sub.Back}"
                    Foreground="{DynamicResource Brush.OnSurface}" />
            </Button>
            <TextBlock
                Grid.Column="1"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Classes="Headline"
                Text="Пинг"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <StackPanel Margin="16,12,16,24" Spacing="8">
            <TextBlock
                Classes="Subtitle"
                Text="Как измерять задержку серверов. Ниже — адрес и тайм-аут проверки."
                TextWrapping="Wrap" />

            <!--  Метод проверки задержки — одна карта с 4 выбираемыми строками (как в Android).  -->
            <Border
                Classes="Card"
                ClipToBounds="True"
                Padding="0">
                <StackPanel>
                    <Border x:Name="RowReal" Classes="MethodRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Classes="Body" Text="Реальная задержка" />
                                <TextBlock
                                    Classes="Subtitle"
                                    Text="Через ядро, как при подключении"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <PathIcon
                                x:Name="CheckReal"
                                Grid.Column="1"
                                Classes="MethodCheck"
                                Data="{StaticResource Geo.Sub.Check}" />
                        </Grid>
                    </Border>

                    <Border Classes="MethodDivider" />

                    <Border x:Name="RowTcp" Classes="MethodRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Classes="Body" Text="TCP" />
                                <TextBlock
                                    Classes="Subtitle"
                                    Text="TCP-подключение к серверу"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <PathIcon
                                x:Name="CheckTcp"
                                Grid.Column="1"
                                Classes="MethodCheck"
                                Data="{StaticResource Geo.Sub.Check}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Border Classes="Card" Padding="16,12">
                <StackPanel Spacing="6">
                    <TextBlock Classes="Subtitle" Text="Адрес проверки задержки" />
                    <TextBox
                        x:Name="txtPingUrl"
                        VerticalContentAlignment="Center"
                        Watermark="https://www.gstatic.com/generate_204" />
                </StackPanel>
            </Border>

            <Border Classes="Card" Padding="16,12">
                <StackPanel Spacing="6">
                    <TextBlock Classes="Subtitle" Text="Тайм-аут проверки, сек" />
                    <TextBox
                        x:Name="txtTimeout"
                        MaxLength="3"
                        VerticalContentAlignment="Center"
                        Watermark="5" />
                </StackPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</UserControl>
