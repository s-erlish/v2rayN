<UserControl
    x:Class="v2rayN.Desktop.Views.PingSettingsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignWidth="520"
    d:DesignHeight="440"
    Background="{DynamicResource Brush.Bg}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <StreamGeometry x:Key="Geo.Sub.Back">M20,11H7.83l5.59,-5.59L12,4l-8,8 8,8 1.41,-1.41L7.83,13H20v-2z</StreamGeometry>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.IconButton">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.09" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.IconButton:pressed">
            <Setter Property="RenderTransform" Value="scale(0.92)" />
        </Style>
    </UserControl.Styles>

    <DockPanel MaxWidth="620">
        <Grid
            DockPanel.Dock="Top"
            MinHeight="56"
            Margin="16,8,16,0"
            ColumnDefinitions="Auto,*">
            <Button
                x:Name="btnBack"
                Grid.Column="0"
                Width="40"
                Height="40"
                Padding="0"
                VerticalAlignment="Center"
                Classes="IconButton"
                ToolTip.Tip="Назад">
                <PathIcon
                    Width="22"
                    Height="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Data="{StaticResource Geo.Sub.Back}"
                    Foreground="{DynamicResource Brush.OnSurface}" />
            </Button>
            <TextBlock
                Grid.Column="1"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Classes="Headline"
                Text="Пинг"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <StackPanel Margin="16,12,16,24" Spacing="8">
            <TextBlock
                Classes="Subtitle"
                Text="Задержка серверов измеряется реальной проверкой через ядро. Ниже — адрес и тайм-аут проверки."
                TextWrapping="Wrap" />

            <Border Classes="Card" Padding="16,12">
                <StackPanel Spacing="6">
                    <TextBlock Classes="Subtitle" Text="Адрес проверки задержки" />
                    <TextBox
                        x:Name="txtPingUrl"
                        VerticalContentAlignment="Center"
                        Watermark="https://www.gstatic.com/generate_204" />
                </StackPanel>
            </Border>

            <Border Classes="Card" Padding="16,12">
                <StackPanel Spacing="6">
                    <TextBlock Classes="Subtitle" Text="Тайм-аут проверки, сек" />
                    <TextBox
                        x:Name="txtTimeout"
                        MaxLength="3"
                        VerticalContentAlignment="Center"
                        Watermark="5" />
                </StackPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</UserControl>
