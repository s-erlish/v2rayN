<UserControl
    x:Class="v2rayN.Desktop.Views.ProviderSettingsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignWidth="560"
    d:DesignHeight="620"
    Background="{DynamicResource Brush.Bg}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <StreamGeometry x:Key="Geo.Sub.Back">M20,11H7.83l5.59,-5.59L12,4l-8,8 8,8 1.41,-1.41L7.83,13H20v-2z</StreamGeometry>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.IconButton">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.09" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.IconButton:pressed">
            <Setter Property="RenderTransform" Value="scale(0.92)" />
        </Style>
    </UserControl.Styles>

    <DockPanel MaxWidth="620">
        <Grid
            DockPanel.Dock="Top"
            MinHeight="56"
            Margin="16,8,16,0"
            ColumnDefinitions="Auto,*">
            <Button
                x:Name="btnBack"
                Grid.Column="0"
                Width="40"
                Height="40"
                Padding="0"
                VerticalAlignment="Center"
                Classes="IconButton"
                ToolTip.Tip="Назад">
                <PathIcon
                    Width="22"
                    Height="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Data="{StaticResource Geo.Sub.Back}"
                    Foreground="{DynamicResource Brush.OnSurface}" />
            </Button>
            <TextBlock
                Grid.Column="1"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Classes="Headline"
                Text="Настройки провайдеров"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,12,16,24" Spacing="8">

                <TextBlock Classes="SectionHeader" Text="Обновление" />
                <Border Classes="Card" Padding="16,4">
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto" MinHeight="56">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Classes="Body" Text="Автообновление" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Classes="Subtitle"
                                    Text="Автоматически обновлять подписки"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="switchAutoUpdate"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Theme="{DynamicResource ToggleSwitch.iOS}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Brush.OutlineVariant}" />
                        <Grid ColumnDefinitions="*,Auto" MinHeight="56">
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Classes="Body"
                                Text="Интервал обновления" />
                            <ComboBox
                                x:Name="cmbInterval"
                                Grid.Column="1"
                                MinWidth="140"
                                VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Classes="SectionHeader" Text="Сеть" />
                <Border Classes="Card" Padding="16,4">
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto" MinHeight="56">
                            <StackPanel Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Classes="Body" Text="Идентификатор устройства (HWID)" />
                                <TextBlock
                                    x:Name="txtHwid"
                                    Margin="0,4,0,0"
                                    Classes="Subtitle"
                                    Text="—"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button
                                x:Name="btnCopyHwid"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Content="Копировать" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Classes="SectionHeader" Text="User-Agent" />
                <Border Classes="Card" Padding="16,12">
                    <StackPanel Spacing="8">
                        <TextBox
                            x:Name="txtUserAgent"
                            VerticalContentAlignment="Center"
                            Watermark="INCY/1.0" />
                        <TextBlock
                            Classes="Subtitle"
                            Text="Отправляется ядром на исходящих соединениях."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
