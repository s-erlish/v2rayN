<UserControl
    x:Class="v2rayN.Desktop.Views.ProviderSettingsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:v2rayN.Desktop.Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:v="clr-namespace:v2rayN.Desktop.Views"
    d:DesignWidth="800"
    d:DesignHeight="620"
    mc:Ignorable="d">

    <!--  Фон НЕ задан: подэкран прозрачный, шелл под ним погашен (ApplySubPageShellGate).  -->

    <UserControl.Styles>
        <StyleInclude Source="avares://departament/Assets/SubScreenStyles.axaml" />

        <!--  Каретка строки «Интервал обновления»: поворот на 180° за 300 мс, пока окошко открыто.  -->
        <Style Selector="PathIcon.IntervalCaret">
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Duration="0:0:0.30" Property="RenderTransform" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="PathIcon.IntervalCaret.open">
            <Setter Property="RenderTransform" Value="rotate(180deg)" />
        </Style>
        <Style Selector="TextBlock.IntervalValue.open">
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="760"
            Margin="20,10,20,20"
            HorizontalAlignment="Center">

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button
                    x:Name="btnBack"
                    Classes="SubBack"
                    ToolTip.Tip="{loc:T Common_Back}">
                    <PathIcon
                        Width="22"
                        Height="22"
                        Data="{DynamicResource Geo.Sub.Back}"
                        Foreground="{DynamicResource Brush.OnSurface}" />
                </Button>
                <TextBlock Classes="SubTitle" Text="{loc:T Provider_Title}" />
            </StackPanel>
            <TextBlock
                Margin="0,8,0,0"
                Classes="SubNote"
                Text="{loc:T Provider_Intro}" />

            <!--  ==================== Обновление ====================
                  ClipToBounds=False — контракт ValuePopup: карточка не имеет права обрезать
                  раскрытое окошко нижней кромкой, поэтому углы маскируют сами крайние строки
                  (15 = 16 карточки минус её контур).  -->
            <TextBlock Classes="SubGroupLabel" Text="{loc:T Provider_SecUpdates}" />
            <Border Classes="SubCard" ClipToBounds="False">
                <StackPanel>
                    <Border
                        x:Name="RowAutoUpdate"
                        Classes="SubRow tap"
                        CornerRadius="15,15,0,0">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Classes="SubTile">
                                <PathIcon Data="{DynamicResource Geo.Sub.Refresh}" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                Margin="16,0,12,0"
                                VerticalAlignment="Center">
                                <TextBlock Classes="SubName" Text="{loc:T Provider_AutoUpdate}" />
                                <TextBlock
                                    Classes="SubSub"
                                    Text="{loc:T Provider_AutoUpdateHint}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="switchAutoUpdate"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Theme="{DynamicResource ToggleSwitch.iOS}" />
                        </Grid>
                    </Border>

                    <!--  Зависимая строка: интервала не существует при выключенном автообновлении —
                          «раз в 24 ч» под выключенным тумблером это обещание, которого никто не даёт.  -->
                    <StackPanel x:Name="intervalRow" IsVisible="False">
                        <Border Classes="SubDivider" />
                        <Border
                            x:Name="RowInterval"
                            Classes="SubRow tap"
                            CornerRadius="0,0,15,15">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                <Border Grid.Column="0" Classes="SubTile" Opacity="0" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="16,0,12,0"
                                    VerticalAlignment="Center"
                                    Classes="SubName"
                                    Text="{loc:T Provider_Interval}" />
                                <TextBlock
                                    x:Name="txtIntervalValue"
                                    Grid.Column="2"
                                    Classes="SubValue strong IntervalValue" />
                                <PathIcon
                                    x:Name="IntervalCaret"
                                    Grid.Column="3"
                                    Classes="SubChevron IntervalCaret"
                                    Data="{DynamicResource Geo.Sub.Caret}" />

                                <!--  Компонент занимает 0×0 и не двигает раскладку строки.  -->
                                <v:ValuePopup
                                    x:Name="IntervalPopup"
                                    Grid.Column="3"
                                    Anchor="{Binding #RowInterval}"
                                    PopupWidth="190"
                                    Trigger="{Binding #RowInterval}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ==================== Сеть ====================  -->
            <TextBlock Classes="SubGroupLabel" Text="{loc:T Provider_SecNetwork}" />
            <Border Classes="SubCard">
                <StackPanel>
                    <Border Classes="SubRow">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Classes="SubTile">
                                <PathIcon Data="{DynamicResource Geo.Sub.Device}" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                Margin="16,0,12,0"
                                VerticalAlignment="Center">
                                <TextBlock Classes="SubName" Text="{loc:T Provider_Hwid}" />
                                <TextBlock x:Name="txtHwid" Classes="SubSub" />
                            </StackPanel>
                            <Button
                                x:Name="btnCopyHwid"
                                Grid.Column="2"
                                Margin="6,0,-8,0"
                                Classes="IconButton40 Row"
                                ToolTip.Tip="{loc:T Common_Copy}">
                                <PathIcon Data="{DynamicResource Geo.Sub.Copy}" />
                            </Button>
                        </Grid>
                    </Border>

                    <Border Classes="SubDivider" />
                    <Border Classes="SubRow">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Classes="SubTile">
                                <PathIcon Data="{DynamicResource Geo.Sub.Globe}" />
                            </Border>
                            <TextBlock
                                Grid.Column="1"
                                Margin="16,0,12,0"
                                VerticalAlignment="Center"
                                Classes="SubName"
                                Text="User-Agent" />
                            <TextBox
                                x:Name="txtUserAgent"
                                Grid.Column="2"
                                MinWidth="180"
                                Classes="SubField"
                                PlaceholderText="DepartamentVPN/1.0" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
            <TextBlock Classes="SubFoot" Text="{loc:T Provider_UserAgentHint}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
