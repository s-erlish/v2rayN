<UserControl
    x:Class="v2rayN.Desktop.Views.DnsSubView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:v2rayN.Desktop.Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignWidth="800"
    d:DesignHeight="720"
    mc:Ignorable="d">

    <!--  Фон НЕ задан: подэкран прозрачный, под ним непрерывный фон окна, шелл погашен
          (MainWindow.ApplySubPageShellGate). Собственный Brush.Bg рисовал бы вторую плоскость поверх.  -->

    <UserControl.Styles>
        <StyleInclude Source="avares://departament/Assets/SubScreenStyles.axaml" />
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <!--  Колонка подэкрана: карточки 720 + поля по 20 = внешний габарит 760, как в прототипе
              (`max-width:760;padding:0 20px`). В Avalonia Margin лежит СНАРУЖИ MaxWidth, поэтому
              ту же геометрию даёт 720 + поля 20 — ровно как в колонке вкладки настроек, чтобы
              карточки не меняли ширину при входе в подэкран.
              Выравнивание Stretch, а НЕ Center — см. SubScreenStyles.axaml, «Ширина колонки»:
              Center отдаёт панели её желаемую ширину, и карточка съёживается по самой длинной
              строке, у каждого экрана до своей.  -->
        <StackPanel
            MaxWidth="720"
            Margin="20,10,20,20"
            HorizontalAlignment="Stretch">

            <!--  ==================== Лекало: назад 40 (−8) → заголовок 22/700 → пояснение 13 ====================  -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button
                    x:Name="btnBack"
                    Classes="SubBack">
                    <PathIcon
                        Width="22"
                        Height="22"
                        Data="{DynamicResource Geo.Sub.Back}"
                        Foreground="{DynamicResource Brush.OnSurface}" />
                </Button>
                <TextBlock Classes="SubTitle" Text="DNS" />
            </StackPanel>
            <TextBlock
                Margin="0,8,0,0"
                Classes="SubNote"
                Text="{loc:T Dns_Intro}" />

            <!--  ==================== Пресеты ====================
                  Радио-выбор. Геометрия строки одинаковая у выбранного и невыбранного: кружок всегда
                  занимает место, меняются только цвет обводки и прозрачность точки (Border.SubRadio).  -->
            <TextBlock Classes="SubGroupLabel" Text="{loc:T Dns_Presets}" />
            <Border Classes="SubCard">
                <StackPanel>
                    <Border x:Name="RowCloudflare" Classes="SubRow tap">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Classes="SubName" Text="Cloudflare" />
                                <TextBlock Classes="SubSub" Text="1.1.1.1" />
                            </StackPanel>
                            <Border x:Name="DotCloudflare" Grid.Column="1" Classes="SubRadio">
                                <Ellipse />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Classes="SubDivider" />
                    <Border x:Name="RowGoogle" Classes="SubRow tap">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Classes="SubName" Text="Google" />
                                <TextBlock Classes="SubSub" Text="8.8.8.8" />
                            </StackPanel>
                            <Border x:Name="DotGoogle" Grid.Column="1" Classes="SubRadio">
                                <Ellipse />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Classes="SubDivider" />
                    <Border x:Name="RowBoth" Classes="SubRow tap">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Classes="SubName" Text="Cloudflare + Google" />
                                <TextBlock Classes="SubSub" Text="1.1.1.1, 8.8.8.8" />
                            </StackPanel>
                            <Border x:Name="DotBoth" Grid.Column="1" Classes="SubRadio">
                                <Ellipse />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Classes="SubDivider" />
                    <Border x:Name="RowAdGuard" Classes="SubRow tap">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Classes="SubName" Text="AdGuard" />
                                <TextBlock Classes="SubSub" Text="94.140.14.14" />
                            </StackPanel>
                            <Border x:Name="DotAdGuard" Grid.Column="1" Classes="SubRadio">
                                <Ellipse />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Classes="SubDivider" />
                    <Border x:Name="RowQuad9" Classes="SubRow tap">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Classes="SubName" Text="Quad9" />
                                <TextBlock Classes="SubSub" Text="9.9.9.9" />
                            </StackPanel>
                            <Border x:Name="DotQuad9" Grid.Column="1" Classes="SubRadio">
                                <Ellipse />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Classes="SubDivider" />
                    <Border x:Name="RowCustom" Classes="SubRow tap">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Classes="SubName" Text="{loc:T Dns_Custom}" />
                                <TextBlock Classes="SubSub" Text="{loc:T Dns_CustomSub}" />
                            </StackPanel>
                            <Border x:Name="DotCustom" Grid.Column="1" Classes="SubRadio">
                                <Ellipse />
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!--  Поле своего адреса — только когда выбран «Свой сервер». Отдельной карточкой, а не внутри
                  строки: адрес длинный, в значении строки он бы срезался на полуслове.  -->
            <StackPanel x:Name="customPanel" IsVisible="False">
                <TextBlock Classes="SubGroupLabel" Text="{loc:T Dns_CustomAddress}" />
                <Border Classes="SubCard" Padding="16,14">
                    <StackPanel Spacing="10">
                        <TextBox
                            x:Name="txtCustomDoh"
                            VerticalContentAlignment="Center"
                            PlaceholderText="https://example.com/dns-query" />
                        <TextBlock
                            Classes="SubSub"
                            Margin="0"
                            Text="{loc:T Dns_CustomHint}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--  ==================== Дополнительно ====================
                  FakeIP — реальная настройка ядра (SimpleDNSItem.FakeIP), которая на этом экране жила
                  и до редизайна. В прототипе её нет, но молча выбросить рабочий переключатель — потерять
                  функцию, поэтому она остаётся отдельной группой под пресетами.  -->
            <TextBlock Classes="SubGroupLabel" Text="{loc:T Dns_Advanced}" />
            <Border Classes="SubCard">
                <Border x:Name="RowFakeIp" Classes="SubRow tap">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Classes="SubName" Text="FakeIP" />
                            <TextBlock
                                Classes="SubSub"
                                Text="{loc:T Dns_AdvancedHint}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="switchFakeIp"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Theme="{DynamicResource ToggleSwitch.iOS}" />
                    </Grid>
                </Border>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
