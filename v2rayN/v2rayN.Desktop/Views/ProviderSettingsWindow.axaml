<Window
    x:Class="v2rayN.Desktop.Views.ProviderSettingsWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Настройки провайдеров"
    Width="560"
    Height="560"
    Background="{DynamicResource Brush.Bg}"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <DockPanel>
        <Grid
            Margin="16,14,16,10"
            ColumnDefinitions="*,Auto"
            DockPanel.Dock="Top">
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Classes="Headline"
                Text="Настройки провайдеров" />
            <Button
                x:Name="btnDone"
                Grid.Column="1"
                Classes="Primary"
                Content="Готово" />
        </Grid>
        <Border
            Height="1"
            Background="{DynamicResource Brush.OutlineVariant}"
            DockPanel.Dock="Top" />

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,12,16,24" Spacing="8">

                <TextBlock Classes="SectionHeader" Text="Обновление" />
                <Border Classes="Card" Padding="16,4">
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto" MinHeight="56">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Classes="Body" Text="Автообновление" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Classes="Subtitle"
                                    Text="Автоматически обновлять подписки"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="switchAutoUpdate"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Theme="{DynamicResource ToggleSwitch.iOS}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Brush.OutlineVariant}" />
                        <Grid ColumnDefinitions="*,Auto" MinHeight="56">
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Classes="Body"
                                Text="Интервал обновления" />
                            <ComboBox
                                x:Name="cmbInterval"
                                Grid.Column="1"
                                MinWidth="140"
                                VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Classes="SectionHeader" Text="Сеть" />
                <Border Classes="Card" Padding="16,4">
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto" MinHeight="56">
                            <StackPanel Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Classes="Body" Text="Идентификатор устройства (HWID)" />
                                <TextBlock
                                    x:Name="txtHwid"
                                    Margin="0,4,0,0"
                                    Classes="Subtitle"
                                    Text="—"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button
                                x:Name="btnCopyHwid"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Content="Копировать" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Classes="SectionHeader" Text="User-Agent" />
                <Border Classes="Card" Padding="16,12">
                    <StackPanel Spacing="8">
                        <TextBox
                            x:Name="txtUserAgent"
                            VerticalContentAlignment="Center"
                            Watermark="INCY/1.0" />
                        <TextBlock
                            Classes="Subtitle"
                            Text="Отправляется ядром на исходящих соединениях."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
