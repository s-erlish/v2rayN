<UserControl
    x:Class="v2rayN.Desktop.Views.CompactServersView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:loc="clr-namespace:v2rayN.Desktop.Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:v2rayN.Desktop.Views"
    xmlns:vms="clr-namespace:v2rayN.Desktop.ViewModels"
    d:DesignHeight="820"
    d:DesignWidth="400"
    x:DataType="vms:HomeViewModel"
    Design.DataContext="{x:Static dd:DesignData.Home}"
    mc:Ignorable="d">

    <!--  ================================================================================
          КОМПАКТНАЯ ВКЛАДКА «СЕРВЕРА» (CA-4) — 1:1 с Android layout_servers_header + rv_servers.
          Заголовок (title + «N серверов · M провайдеров» + обновить/пинг/«+») и поиск-пилюля
          сверху; ниже — ServerListView (тот же, что и на «Главной»), со своим скроллом, т.к. здесь
          у него ограниченная высота. Поиск двусторонне связан с Profiles.ServerFilter (живой фильтр).
          В широкой раскладке этой вкладки нет — серверы живут в левой колонке «Главной».
          =================================================================================  -->

    <UserControl.Styles>
        <!--  Placeholder Semi по умолчанию не следует токенам — красим watermark в OnSurfaceVariant
              (контраст ≥4.5:1 во всех темах). Держит borderless-поле прозрачным поверх пилюли.  -->
        <Style Selector="Border.SearchPill TextBox">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.SearchPill TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.SearchPill TextBox /template/ TextBlock#PART_Watermark">
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <StreamGeometry x:Key="Srv.Refresh">M17.65,6.35C16.2,4.9 14.21,4 12,4c-4.42,0 -7.99,3.58 -7.99,8s3.57,8 7.99,8c3.73,0 6.84,-2.55 7.73,-6h-2.08c-0.82,2.33 -3.04,4 -5.65,4 -3.31,0 -6,-2.69 -6,-6s2.69,-6 6,-6c1.66,0 3.14,0.69 4.22,1.78L13,11h7V4l-2.35,2.35z</StreamGeometry>
        <StreamGeometry x:Key="Srv.Ping">M12,11c-1.1,0 -2,0.9 -2,2s0.9,2 2,2 2,-0.9 2,-2 -0.9,-2 -2,-2zM18,13c0,-3.31 -2.69,-6 -6,-6s-6,2.69 -6,6c0,2.22 1.21,4.15 3,5.19l1,-1.74c-1.19,-0.7 -2,-1.97 -2,-3.45 0,-2.21 1.79,-4 4,-4s4,1.79 4,4c0,1.48 -0.81,2.75 -2,3.45l1,1.74c1.79,-1.04 3,-2.97 3,-5.19zM12,3C6.48,3 2,7.48 2,13c0,3.7 2.01,6.92 4.99,8.65l1,-1.73C5.61,18.53 4,15.96 4,13c0,-4.42 3.58,-8 8,-8s8,3.58 8,8c0,2.96 -1.61,5.53 -4,6.92l1,1.73c2.98,-1.73 5,-4.95 5,-8.65 0,-5.52 -4.48,-10 -10,-10z</StreamGeometry>
        <StreamGeometry x:Key="Srv.Filter">M10,18h4v-2h-4v2zM3,6v2h18V6H3zm3,7h12v-2H6v2z</StreamGeometry>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*">

        <!--  Заголовок вкладки + действия + поиск.  -->
        <StackPanel
            Grid.Row="0"
            Margin="16,10,10,6"
            Spacing="10">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" VerticalAlignment="Center">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Classes="Headline" Text="{loc:T Servers_Title}" />
                    <TextBlock Classes="Caption" Text="{Binding Subtitle}" />
                </StackPanel>
                <Button
                    x:Name="BtnRefresh"
                    Grid.Column="1"
                    Classes="IconButton40"
                    Command="{Binding RefreshSubscriptionCmd}">
                    <PathIcon Data="{StaticResource Srv.Refresh}" Foreground="{DynamicResource Brush.Accent}" />
                </Button>
                <Button
                    x:Name="BtnPing"
                    Grid.Column="2"
                    Classes="IconButton40"
                    Command="{Binding Profiles.FastRealPingCmd}">
                    <PathIcon Data="{StaticResource Srv.Ping}" Foreground="{DynamicResource Brush.Accent}" />
                </Button>
                <Button
                    x:Name="BtnAdd"
                    Grid.Column="3"
                    Classes="IconButton40 Accent">
                    <PathIcon Data="M11,5 H13 V11 H19 V13 H13 V19 H11 V13 H5 V11 H11 Z" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem Command="{Binding AddViaClipboardCmd}" Header="{loc:T Common_AddFromClipboard}" />
                            <MenuItem Command="{Binding AddViaQrCmd}" Header="{loc:T Common_AddViaQr}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <!--  Поиск-пилюля: глобальный Border.SearchPill (Surface, radius 14, 1px OutlineVariant),
                  чтобы поле корректно перетемизировалось во всех трёх темах; глиф-фильтр + borderless-
                  поле; TextChanged в code-behind даёт живой фильтр (см. CompactServersView.axaml.cs).  -->
            <Border Classes="SearchPill" Height="48">
                <Grid Margin="14,0,10,0" ColumnDefinitions="Auto,*">
                    <PathIcon
                        Grid.Column="0"
                        Width="20"
                        Height="20"
                        Margin="0,0,10,0"
                        Data="{StaticResource Srv.Filter}"
                        Foreground="{DynamicResource Brush.OnSurfaceVariant}" />
                    <TextBox
                        x:Name="SearchBox"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{DynamicResource Brush.OnSurface}"
                        Text="{Binding Profiles.ServerFilter, Mode=TwoWay}"
                        Watermark="{loc:T Servers_SearchPlaceholder}" />
                </Grid>
            </Border>
        </StackPanel>

        <!--  Список серверов (свой скролл — здесь высота ограничена).  -->
        <views:ServerListView Grid.Row="1" />
    </Grid>
</UserControl>
