<UserControl
    x:Class="v2rayN.Desktop.Views.AccountView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:v2rayN.Desktop.Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vms="clr-namespace:v2rayN.Desktop.ViewModels"
    x:DataType="vms:AccountViewModel"
    mc:Ignorable="d">

    <!--
        Экран «Аккаунт» (порт Android activity_account.xml + item_subscription_card.xml,
        AccountFragment.kt / SubscriptionPagerAdapter.kt). Две зоны: HERO (профиль-карта +
        карточка подписки как СОСЕДНИЕ, не вложенные) и секция «Управление». Incy: pure dark,
        один синий акцент, Space Grotesk, токен-отступы/радиусы/плитки, sentence-case Russian,
        0 elevation, 1px OutlineVariant, без вложенных карт и градиентов.

        DATA-DRIVEN: КАЖДОЕ значение приходит из departament-API через AccountViewModel
        (UserProfileDto / SubInfoDto / PaymentDto). Никаких заглушек: пусто до входа и реального
        ответа. Карточка подписки — ровно одно из 4 состояний: скелет / активная / пусто / ошибка.
    -->

    <UserControl.Resources>
        <!--  Векторные глифы (порт Android drawable/ic_acc_*; 24dp).  -->
        <StreamGeometry x:Key="Geo.Acc.Add">M19,13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z</StreamGeometry>
        <!--  Выход из аккаунта (дверь + стрелка).  -->
        <StreamGeometry x:Key="Geo.Acc.Logout">M17,7l-1.41,1.41L18.17,11H8v2h10.17l-2.58,2.58L17,17l5,-5zM4,5h8V3H4c-1.1,0 -2,0.9 -2,2v14c0,1.1 0.9,2 2,2h8v-2H4V5z</StreamGeometry>
        <StreamGeometry x:Key="Geo.Acc.Copy">M16,1L4,1c-1.1,0 -2,0.9 -2,2v14h2L4,3h12L16,1zM19,5L8,5c-1.1,0 -2,0.9 -2,2v14c0,1.1 0.9,2 2,2h11c1.1,0 2,-0.9 2,-2L21,7c0,-1.1 -0.9,-2 -2,-2zM19,21L8,21L8,7h11v14z</StreamGeometry>
        <StreamGeometry x:Key="Geo.Acc.Upgrade">M16,6l2.29,2.29 -4.88,4.88 -4,-4L2,16.59 3.41,18l6,-6 4,4 6.3,-6.29L22,12V6z</StreamGeometry>
        <StreamGeometry x:Key="Geo.Acc.Devices">M4,6h18V4H4c-1.1,0 -2,0.9 -2,2v11H0v3h14v-3H4V6zM23,8h-6c-0.55,0 -1,0.45 -1,1v10c0,0.55 0.45,1 1,1h6c0.55,0 1,-0.45 1,-1V9c0,-0.55 -0.45,-1 -1,-1zM22,18h-4v-8h4v8z</StreamGeometry>
        <StreamGeometry x:Key="Geo.Acc.History">M13,3c-4.97,0 -9,4.03 -9,9H1l3.89,3.89 0.07,0.14L9,12H6c0,-3.87 3.13,-7 7,-7s7,3.13 7,7 -3.13,7 -7,7c-1.93,0 -3.68,-0.79 -4.94,-2.06l-1.42,1.42C8.27,19.99 10.51,21 13,21c4.97,0 9,-4.03 9,-9s-4.03,-9 -9,-9zM12,8v5l4.28,2.54 0.72,-1.21 -3.5,-2.08V8H12z</StreamGeometry>
        <StreamGeometry x:Key="Geo.Acc.Chevron">M8.6,4.6L7.2,6l6,6l-6,6l1.4,1.4L16,12z</StreamGeometry>
        <!--  Telegram (paper plane) — для CTA входа.  -->
        <StreamGeometry x:Key="Geo.Acc.Telegram">M9.78,18.65l0.28,-4.23l7.68,-6.92c0.34,-0.31 -0.07,-0.46 -0.52,-0.19L7.74,13.3L3.64,12c-0.88,-0.25 -0.89,-0.86 0.2,-1.3l15.97,-6.16c0.73,-0.33 1.43,0.18 1.15,1.3l-2.72,12.81c-0.19,0.91 -0.74,1.13 -1.5,0.71L12.6,16.3l-1.99,1.93c-0.23,0.23 -0.42,0.42 -0.83,0.42z</StreamGeometry>
        <!--  Инфо-круг — для состояния ошибки.  -->
        <StreamGeometry x:Key="Geo.Acc.Alert">M12,2A10,10 0 1,0 12,22A10,10 0 0,0 12,2M13,17h-2v-2h2v2M13,13h-2V7h2v6z</StreamGeometry>
    </UserControl.Resources>

    <UserControl.Styles>
        <!--  ПРОБЛЕМА 1: реф-строка БОЛЬШЕ не подсвечивается целиком. Контейнер —
              просто раскладка (без фона/курсора/ховера). Единственный элемент с
              hover-откликом — кнопка копирования (Button.IconButton40) справа; чип
              с кодом не подсвечивается. Клик по коду копирует его через кнопку.  -->
        <Style Selector="Border.RefRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <!--  ПРОБЛЕМА 2: «Пополнить» на ховере НЕ уезжает в другой синий (глобальный
              Semi-hover #5F9AFF светлее), а чуть ТЕМНЕЕТ (Accent → #3D7EF0, press
              #3877E0). Покой = Accent (класс Button.Primary). Фон закреплён на
              ContentPresenter, иначе тема Semi подменяет его своим hover-цветом.  -->
        <Style Selector="Button#TopUpButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#3D7EF0" />
        </Style>
        <Style Selector="Button#TopUpButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#3877E0" />
        </Style>

        <!--  BUG 5: строки «Управление» (BuyRow/DevicesRow/HistoryRow/LogoutRow) и кнопка
              копирования реф-кода на ховере ТОЛЬКО ЧУТЬ ТЕМНЕЮТ и НИКОГДА не синеют.
              Явно и локально прибиваем hover/press к Brush.Hover (полупрозрачное
              затемнение — тёмная/светлая/mono одинаково), чтобы НИ базовая тема Semi
              (её сплошной hover уходит в светло-синий #5F9AFF), НИ акцент не подменяли
              фон синим. Синими остаются ТОЛЬКО «Пополнить» (accent-CTA выше, намеренно)
              и ПОКОЙНЫЕ акцентные детали BuyRow (плитка + заголовок) — но НЕ их ховер.
              Глобальный Border.Row/ServerRow не трогаем — это локальная гарантия вида.  -->
        <Style Selector="Border.Row:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
        </Style>
        <Style Selector="Button#CopyReferralButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
        </Style>
        <Style Selector="Button#CopyReferralButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
        </Style>

        <!--  ПРОБЛЕМА 3: заголовок строки «Управление» — вес Medium (не Bold),
              Space Grotesk. Строки читаются как остальной интерфейс, а не тяжело.
              Плюс одна строка + эллипсис: на ~360px «История платежей» / «Купить
              подписку» деградируют в «…», а не режутся и не наезжают на значение.  -->
        <Style Selector="Border.Row TextBlock.Title">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Grotesk}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!--  Скелет-примитивы (полоса SkelBar, пульс SkeletonPulse) — общие из
              GlobalStyles: один источник, корректно гаснут в lite-режиме.  -->
    </UserControl.Styles>

    <!--  Прозрачный фон: общий Incy-градиент рисуется под хостом страниц (MainWindow), показываем его.
          Две взаимоисключающие поверхности: ВОШЁЛ → прокручиваемый аккаунт; НЕ ВОШЁЛ → один
          центрированный гейт входа (ShowLoginCta = !IsLoggedIn во VM).  -->
    <Panel>

        <!-- ================= ВОШЁЛ: прокручиваемый контент аккаунта ================= -->
        <ScrollViewer
            Background="Transparent"
            HorizontalScrollBarVisibility="Disabled"
            IsVisible="{Binding IsLoggedIn}"
            VerticalScrollBarVisibility="Auto">

            <!--  Центрированная колонка ~560; на узком окне ужимается с 16dp-гаттером.  -->
            <StackPanel MaxWidth="560" Margin="16,12,16,24">

            <!-- ============ HERO: профиль-карта ============ -->
            <Border Classes="Card" IsVisible="{Binding HasProfile}">
                <StackPanel>

                    <!--  Строка 1: аватар + @никнейм во всю ширину. @никнейм (Username = «@serumfx»)
                          больше не делит строку с «Пополнить», поэтому виден целиком и обрезается
                          многоточием, а не выдавливается кнопкой на ~360px.  -->
                    <Grid ColumnDefinitions="Auto,*">
                        <!--  Аватар 48 с инициалом. Без бейджа-камеры: пикера фото нет.  -->
                        <Border
                            Grid.Column="0"
                            Classes="Avatar"
                            Width="48"
                            Height="48"
                            VerticalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{DynamicResource Font.Grotesk}"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Brush.Accent}"
                                Text="{Binding AvatarInitial}" />
                        </Border>

                        <TextBlock
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Classes="Title"
                            Text="{Binding Username}"
                            TextWrapping="NoWrap"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <!--  Строка 2: баланс (слева, обрезается) + «Пополнить» (справа, фикс. ширина).
                          Кнопка ушла из строки имени сюда — @никнейм получает всю ширину.  -->
                    <Grid Margin="0,16,0,0" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <!--  Баланс: тихая подпись над крупной бренд-цифрой (tnum для ровных знаков).  -->
                            <TextBlock
                                Classes="Caption"
                                IsVisible="{Binding HasBalance}"
                                Text="{loc:T Account_Balance}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Classes="Display Numeric"
                                FontFamily="{DynamicResource Font.Numeric}"
                                FontFeatures="tnum,lnum,zero"
                                IsVisible="{Binding HasBalance}"
                                Text="{Binding BalanceText}"
                                TextWrapping="NoWrap"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!--  «Пополнить»: синяя пилюля (shared Button.Primary), «+» + текст OnAccent.
                              Тап открывает флайаут «Пополнение баланса» → Platega-чекаут.  -->
                        <Button
                            x:Name="TopUpButton"
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Classes="Primary">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                                <PathIcon
                                    Width="18"
                                    Height="18"
                                    VerticalAlignment="Center"
                                    Data="{StaticResource Geo.Acc.Add}"
                                    Foreground="{DynamicResource Brush.OnAccent}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource Brush.OnAccent}"
                                    Text="{loc:T Account_TopUp}" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <StackPanel
                                        Width="248"
                                        Spacing="12"
                                        x:DataType="vms:AccountViewModel">
                                        <TextBlock Classes="Title" Text="{loc:T Account_TopUpTitle}" />
                                        <TextBlock
                                            Classes="Caption"
                                            Text="{loc:T Account_TopUpHint}" />
                                        <TextBox
                                            x:Name="TopUpAmountBox"
                                            Watermark="{loc:T Account_AmountRub}"
                                            Text="{Binding TopUpAmount, Mode=TwoWay}"
                                            FontFamily="{DynamicResource Font.Numeric}"
                                            FontFeatures="tnum,lnum,zero" />
                                        <Button
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Classes="Primary"
                                            Command="{Binding TopUpCmd}"
                                            Content="{loc:T Account_Continue}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                    <!--  Реф-код: чип с кодом + кнопка копирования. Копирует код в буфер
                          (тост «Скопировано»). Подсвечивается ТОЛЬКО кнопка на своём ховере.  -->
                    <Border
                        x:Name="ReferralRow"
                        Margin="0,12,0,0"
                        Classes="RefRow"
                        IsVisible="{Binding HasReferral}">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                            <Border
                                Padding="12,8"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Brush.SurfaceVariant}"
                                CornerRadius="{StaticResource Radius.Chip}">
                                <TextBlock
                                    Classes="Caption"
                                    MaxWidth="240"
                                    Text="{Binding ReferralText}"
                                    TextWrapping="NoWrap"
                                    TextTrimming="CharacterEllipsis" />
                            </Border>
                            <!--  Кнопка копирования: канонический IconButton40 (40 круг,
                                  прозрачный, hover = мягкое затемнение, press scale 0.92,
                                  глиф 20). Единственный элемент реф-строки с hover-откликом.  -->
                            <Button
                                x:Name="CopyReferralButton"
                                Classes="IconButton40 Row"
                                VerticalAlignment="Center"
                                ToolTip.Tip="{loc:T Account_CopyReferralCode}">
                                <PathIcon Data="{StaticResource Geo.Acc.Copy}" />
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ============ HERO: карточка подписки (сосед, не вложенная) — 4 состояния ============ -->

            <!--  Состояние СКЕЛЕТ: пульсирующие плейсхолдеры пока идёт первая загрузка.
                  Класс SkeletonPulse — общий пульс из GlobalStyles (гаснет в lite-режиме).  -->
            <Border
                Classes="Card SkeletonPulse"
                Margin="0,12,0,0"
                MinHeight="152"
                IsVisible="{Binding ShowSkeleton}">
                <StackPanel VerticalAlignment="Top" Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Border
                            Grid.Column="0"
                            Classes="SkelBar"
                            Width="180"
                            HorizontalAlignment="Left" />
                        <Border
                            Grid.Column="1"
                            Width="52"
                            Height="24"
                            Background="{DynamicResource Brush.SurfaceHighest}"
                            CornerRadius="{StaticResource Radius.Chip}" />
                    </Grid>
                    <Border
                        Classes="SkelBar"
                        Width="220"
                        HorizontalAlignment="Left" />
                    <Border
                        Classes="SkelBar"
                        Width="140"
                        HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!--  Состояние АКТИВНАЯ ПОДПИСКА.  -->
            <Border
                Classes="Card"
                Margin="0,12,0,0"
                MinHeight="152"
                IsVisible="{Binding ShowActiveSub}">
                <StackPanel VerticalAlignment="Top">
                    <!--  Шапка: имя подписки (обрезается) + тариф-бейдж.  -->
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Classes="Title"
                            Text="{Binding SubName}"
                            TextTrimming="CharacterEllipsis" />
                        <!--  Тариф-бейдж: плитка Tile.Blue radius 12 pad 8,4, текст Chip цвет Accent.  -->
                        <Border
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Padding="8,4"
                            VerticalAlignment="Center"
                            Background="{DynamicResource Brush.Tile.Blue}"
                            CornerRadius="{StaticResource Radius.Chip}"
                            IsVisible="{Binding HasTariffBadge}">
                            <TextBlock
                                Classes="Chip"
                                Foreground="{DynamicResource Brush.Accent}"
                                Text="{Binding TariffBadge}" />
                        </Border>
                    </Grid>

                    <TextBlock
                        Margin="0,12,0,0"
                        Classes="Subtitle"
                        IsVisible="{Binding HasSubExpiry}"
                        Text="{Binding SubExpiry}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Classes="Subtitle"
                        FontFamily="{DynamicResource Font.Numeric}"
                        FontFeatures="tnum,lnum,zero"
                        Text="{Binding SubDevicesText}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </StackPanel>
            </Border>

            <!--  Состояние ПУСТО: нет активной подписки (обучающая копия, sentence-case).  -->
            <Border
                Classes="Card"
                Margin="0,12,0,0"
                MinHeight="120"
                IsVisible="{Binding ShowEmpty}">
                <StackPanel VerticalAlignment="Center" Spacing="6">
                    <TextBlock Classes="Title" Text="{loc:T Account_FirstSub}" />
                    <TextBlock
                        Classes="Subtitle"
                        MaxWidth="420"
                        HorizontalAlignment="Left"
                        Text="{loc:T Account_NoSubHint}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--  Состояние ОШИБКА: не удалось загрузить + причина + «Повторить».  -->
            <Border
                Classes="Card"
                Margin="0,12,0,0"
                MinHeight="120"
                IsVisible="{Binding ShowError}">
                <StackPanel VerticalAlignment="Center" Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Classes="Tile">
                            <PathIcon
                                Width="22"
                                Height="22"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="{StaticResource Geo.Acc.Alert}"
                                Foreground="{DynamicResource Brush.OnSurfaceVariant}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Classes="Title" Text="{loc:T Common_CouldntLoad}" />
                            <TextBlock
                                Classes="Subtitle"
                                Text="{Binding ErrorText}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                    <Button
                        HorizontalAlignment="Left"
                        Classes="Primary"
                        Command="{Binding RetryCmd}"
                        Content="{loc:T Common_Retry}" />
                </StackPanel>
            </Border>

            <!-- ============ Секция «Управление» ============ -->
            <TextBlock
                Margin="0,24,0,8"
                Classes="SectionHeader"
                Text="{loc:T Common_Manage}" />

            <!--  Padding 0 + ClipToBounds: строки во всю ширину, hover клипается к radius 20.  -->
            <Border
                Classes="Card"
                Padding="0"
                ClipToBounds="True">
                <StackPanel>

                    <!--  «Купить подписку» — промо: синий тайл (тренд-вверх) + акцентный текст.  -->
                    <Border
                        x:Name="BuyRow"
                        Padding="16,8"
                        Classes="Row"
                        CornerRadius="0"
                        Cursor="Hand">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
                            <Border Grid.Column="0" Classes="Tile Blue">
                                <PathIcon
                                    Width="22"
                                    Height="22"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="{StaticResource Geo.Acc.Upgrade}"
                                    Foreground="{DynamicResource Brush.Accent}" />
                            </Border>
                            <TextBlock
                                Grid.Column="1"
                                Margin="16,0,8,0"
                                VerticalAlignment="Center"
                                Classes="Title"
                                Foreground="{DynamicResource Brush.Accent}"
                                Text="{loc:T Common_BuySubscription}"
                                TextTrimming="CharacterEllipsis" />
                            <PathIcon
                                Grid.Column="3"
                                Width="18"
                                Height="18"
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                Data="{StaticResource Geo.Acc.Chevron}"
                                Foreground="{DynamicResource Brush.OnSurfaceVariant}" />
                        </Grid>
                    </Border>

                    <Border
                        Height="1"
                        Margin="72,0,0,0"
                        Background="{DynamicResource Brush.OutlineVariant}" />

                    <!--  «Устройства» — нейтральный тайл + значение «N / ∞» (tnum).  -->
                    <Border
                        x:Name="DevicesRow"
                        Padding="16,8"
                        Classes="Row"
                        CornerRadius="0"
                        Cursor="Hand">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
                            <Border Grid.Column="0" Classes="Tile">
                                <PathIcon
                                    Width="22"
                                    Height="22"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="{StaticResource Geo.Acc.Devices}"
                                    Foreground="{DynamicResource Brush.OnSurfaceVariant}" />
                            </Border>
                            <TextBlock
                                Grid.Column="1"
                                Margin="16,0,8,0"
                                VerticalAlignment="Center"
                                Classes="Title"
                                Text="{loc:T Account_Devices}" />
                            <TextBlock
                                Grid.Column="2"
                                Margin="0,0,8,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Classes="Subtitle"
                                FontFamily="{DynamicResource Font.Numeric}"
                                FontFeatures="tnum,lnum,zero"
                                IsVisible="{Binding HasDevicesRowValue}"
                                MaxWidth="120"
                                Text="{Binding DevicesRowValue}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                            <PathIcon
                                Grid.Column="3"
                                Width="18"
                                Height="18"
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                Data="{StaticResource Geo.Acc.Chevron}"
                                Foreground="{DynamicResource Brush.OnSurfaceVariant}" />
                        </Grid>
                    </Border>

                    <Border
                        Height="1"
                        Margin="72,0,0,0"
                        Background="{DynamicResource Brush.OutlineVariant}" />

                    <!--  «История платежей» — нейтральный тайл + дата последнего платежа.  -->
                    <Border
                        x:Name="HistoryRow"
                        Padding="16,8"
                        Classes="Row"
                        CornerRadius="0"
                        Cursor="Hand">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
                            <Border Grid.Column="0" Classes="Tile">
                                <PathIcon
                                    Width="22"
                                    Height="22"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="{StaticResource Geo.Acc.History}"
                                    Foreground="{DynamicResource Brush.OnSurfaceVariant}" />
                            </Border>
                            <TextBlock
                                Grid.Column="1"
                                Margin="16,0,8,0"
                                VerticalAlignment="Center"
                                Classes="Title"
                                Text="{loc:T Common_PaymentHistory}" />
                            <TextBlock
                                Grid.Column="2"
                                Margin="0,0,8,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Classes="Subtitle"
                                FontFamily="{DynamicResource Font.Numeric}"
                                FontFeatures="tnum,lnum,zero"
                                IsVisible="{Binding HasHistoryRowValue}"
                                MaxWidth="120"
                                Text="{Binding HistoryRowValue}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                            <PathIcon
                                Grid.Column="3"
                                Width="18"
                                Height="18"
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                Data="{StaticResource Geo.Acc.Chevron}"
                                Foreground="{DynamicResource Brush.OnSurfaceVariant}" />
                        </Grid>
                    </Border>

                    <!--  Разделитель + «Выйти из аккаунта» — только для вошедшего пользователя.  -->
                    <Border
                        Height="1"
                        Margin="72,0,0,0"
                        Background="{DynamicResource Brush.OutlineVariant}"
                        IsVisible="{Binding IsLoggedIn}" />
                    <Border
                        x:Name="LogoutRow"
                        Padding="16,8"
                        Classes="Row"
                        CornerRadius="0"
                        Cursor="Hand"
                        IsVisible="{Binding IsLoggedIn}">
                        <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                            <Border Grid.Column="0" Classes="Tile">
                                <PathIcon
                                    Width="22"
                                    Height="22"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="{StaticResource Geo.Acc.Logout}"
                                    Foreground="{DynamicResource Brush.OnSurfaceVariant}" />
                            </Border>
                            <TextBlock
                                Grid.Column="1"
                                Margin="16,0,8,0"
                                VerticalAlignment="Center"
                                Classes="Title"
                                Text="{loc:T Account_SignOut}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= НЕ ВОШЁЛ: центрированный гейт входа ================= -->
        <!--  Только приглашение войти — без баланса/подписки/«Управления». Карточка по центру
              экрана (VerticalAlignment=Center), два способа: Telegram (акцент) и сайт (тональная).  -->
        <Grid IsVisible="{Binding ShowLoginCta}" Margin="16">
            <Border
                Classes="Card"
                MaxWidth="380"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center">
                <StackPanel Spacing="20">

                    <!--  Круг-аватар с глифом Telegram — акцентная точка входа.  -->
                    <Border
                        Classes="Avatar"
                        Width="56"
                        Height="56"
                        HorizontalAlignment="Center">
                        <PathIcon
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="{StaticResource Geo.Acc.Telegram}"
                            Foreground="{DynamicResource Brush.Accent}" />
                    </Border>

                    <StackPanel Spacing="6">
                        <TextBlock
                            HorizontalAlignment="Center"
                            Classes="Title"
                            Text="{loc:T Account_SignInTitle}"
                            TextAlignment="Center" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Classes="Subtitle"
                            Text="{loc:T Account_SignInHint}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="12">
                        <!--  «Войти через Telegram»: акцентная CTA 52dp, центрированные глиф + подпись
                              на одной оси. Прямой запуск LoginTelegramCmd (открывает deep-link).  -->
                        <Button
                            x:Name="LoginTelegramButton"
                            HorizontalAlignment="Stretch"
                            Classes="Primary Tall"
                            Command="{Binding LoginTelegramCmd}">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="10"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <PathIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Data="{StaticResource Geo.Acc.Telegram}"
                                    Foreground="{DynamicResource Brush.OnAccent}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource Brush.OnAccent}"
                                    Text="{loc:T Common_SignInTelegram}" />
                            </StackPanel>
                        </Button>

                        <!--  «Войти через сайт»: тональная вторичная. Открывает полную форму входа
                              (email/пароль/2FA) через существующее событие LoginRequested → LoginView.  -->
                        <Button
                            x:Name="LoginSiteButton"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Classes="Tonal"
                            Content="{loc:T Common_SignInWebsite}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Panel>
</UserControl>
