<Window
    x:Class="v2rayN.Desktop.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
    xmlns:loc="clr-namespace:v2rayN.Desktop.Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:v2rayN.Desktop.Views"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="departament VPN"
    Width="372"
    Height="630"
    MinWidth="340"
    MinHeight="560"
    x:DataType="vms:MainWindowViewModel"
    Background="{DynamicResource Brush.Bg}"
    Design.DataContext="{x:Static dd:DesignData.MainWindow}"
    WindowDecorations="None"
    FontFamily="{DynamicResource Font.Grotesk}"
    Icon="/Assets/NotifyShieldOn.ico"
    ShowInTaskbar="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <!--  Кнопки окна (min/max/close) в стиле Incy: прозрачные, hover SurfaceHigh; close hover красный.  -->
    <Window.Styles>
        <Style Selector="Button.WinBtn">
            <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.WinBtn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.WinBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.WinBtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.WinBtnBg">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.WinBtn:pointerover Border.WinBtnBg">
            <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
        </Style>
        <Style Selector="Button.WinBtn.close:pointerover Border.WinBtnBg">
            <Setter Property="Background" Value="{DynamicResource Brush.Red}" />
        </Style>

        <!--  ==================== Свёртка нав-рейла ====================
              Кнопка внизу рейла (btnRailToggle) сворачивает/разворачивает ЛЕВУЮ навигацию
              (раньше прятала окно в трей — убрано; трей живёт в App.axaml + title-bar «мин»).
              Состоянием управляет класс .railCollapsed на bodyRoot (ставит code-behind):
                • navItems (StackPanel вкладок) едет Width 76→0 + Opacity 1→0 (OutQuint 200мс),
                  ClipToBounds режет 76-пиксельные пункты, столбец Auto рефлоит контент;
                • шеврон разворачивается на 180° вокруг СОБСТВЕННОГО центра (RenderTransformOrigin
                  0.5,0.5 на самом Path, НЕ на кейфрейме): ‹ (свернуть) ⇄ › (развернуть) — вращение
                  на месте, без смещения.
              В .lite (reduced-motion) переходы обнуляются — состояние переключается мгновенно.  -->

        <!--  Кнопка-переключатель рейла: слим 30×30, круглый hover, press-scale.
              Bug3 (мерцание на hover): press-scale и его transition ПЕРЕНЕСЕНЫ на ВНУТРЕННИЙ Border
              (чисто визуальная подложка), а НЕ на саму кнопку. Раньше scale(0.92) на самой кнопке менял
              её хит-бокс, из-за чего :pointerover у границы «дребезжал» (то входит, то выходит → hover-
              фон мигал). Теперь хит-область кнопки фиксирована 30×30 (Background=Transparent, хит-тестится),
              а сжимается только подложка — состояние hover стабильно, без мерцания.  -->
        <Style Selector="Button.RailToggle">
            <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <!--  Подложка: круглый hover + press-scale ОТ ЦЕНТРА. Origin «50%,50%» = 0.5·W,0.5·H (относительный);
              «0.5,0.5» в этой сборке трактуется как 0.5px ≈ угол → масштаб «проваливался» из угла. Обе
              анимации (RenderTransform press + Background hover) держим ЗДЕСЬ, плавные, не конфликтуют с
              хит-тестом кнопки (эта styled-строка перекрывает Transitions базового Border.WinBtnBg).  -->
        <Style Selector="Button.RailToggle Border.WinBtnBg">
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.RailToggle:pointerover Border.WinBtnBg">
            <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
        </Style>
        <Style Selector="Button.RailToggle:pressed Border.WinBtnBg">
            <Setter Property="RenderTransform" Value="scale(0.92)" />
        </Style>

        <!--  Шеврон переключателя: по умолчанию ‹ (свернуть). Крутится вокруг своего центра.
              Центр — относительный «50%,50%»: «0.5,0.5» в этой сборке трактуется как 0.5px ≈ угол,
              и разворот на 180° уводил глиф ЗА пределы кнопки → шеврон «исчезал» в свёрнутом виде.  -->
        <Style Selector="Path.RailToggleGlyph">
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2">
                        <TransformOperationsTransition.Easing>
                            <SplineEasing X1="0.22" Y1="1" X2="0.36" Y2="1" />
                        </TransformOperationsTransition.Easing>
                    </TransformOperationsTransition>
                </Transitions>
            </Setter>
        </Style>
        <!--  Свёрнуто → шеврон 180° = › (развернуть).  -->
        <Style Selector="Grid.railCollapsed Path.RailToggleGlyph">
            <Setter Property="RenderTransform" Value="rotate(180deg)" />
        </Style>

        <!--  Столбец вкладок: развёрнут 76, ClipToBounds; плавная свёртка ширины/непрозрачности.  -->
        <Style Selector="StackPanel.RailItems">
            <Setter Property="Width" Value="76" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.2">
                        <DoubleTransition.Easing>
                            <SplineEasing X1="0.22" Y1="1" X2="0.36" Y2="1" />
                        </DoubleTransition.Easing>
                    </DoubleTransition>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Grid.railCollapsed StackPanel.RailItems">
            <Setter Property="Width" Value="0" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <!--  Reduced-motion: переходы свёртки/шеврона мгновенны (состояние без анимации).  -->
        <Style Selector=":is(Window).lite StackPanel.RailItems">
            <Setter Property="Transitions">
                <Transitions />
            </Setter>
        </Style>
        <Style Selector=":is(Window).lite Path.RailToggleGlyph">
            <Setter Property="Transitions">
                <Transitions />
            </Setter>
        </Style>
        <!--  Reduced-motion: press-scale/hover подложки мгновенны (транзишены живут на Border.WinBtnBg).  -->
        <Style Selector=":is(Window).lite Button.RailToggle Border.WinBtnBg">
            <Setter Property="Transitions">
                <Transitions />
            </Setter>
        </Style>

        <!--  ==================== Индикатор подключения в рейле (C5) ====================
              Серый (покой) ↔ синий (подключение/подключено). Цвет берётся из ТЕМА-ТОКЕНОВ
              (Brush.OnSurfaceVariant / Brush.Accent), а НЕ из хардкод-hex, поэтому следует за
              темой (тёмная/светлая/моно). Смена цвета плавная — BrushTransition 200мс Ease.Standard;
              класс .on ставит code-behind по IsConnected||IsConnecting. Под .lite переход обнуляется
              (состояние переключается мгновенно, как остальная свёртка рейла).  -->
        <Style Selector="Ellipse.ConnDot">
            <Setter Property="Fill" Value="{DynamicResource Brush.OnSurfaceVariant}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Fill" Duration="0:0:0.2">
                        <BrushTransition.Easing>
                            <SplineEasing X1="0.2" Y1="0" X2="0" Y2="1" />
                        </BrushTransition.Easing>
                    </BrushTransition>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Ellipse.ConnDot.on">
            <Setter Property="Fill" Value="{DynamicResource Brush.Accent}" />
        </Style>
        <Style Selector=":is(Window).lite Ellipse.ConnDot">
            <Setter Property="Transitions">
                <Transitions />
            </Setter>
        </Style>
    </Window.Styles>

    <dialogHost:DialogHost
        Background="#B3000000"
        CloseOnClickAway="True"
        DisableOpeningAnimation="True">
        <Panel>
            <Grid RowDefinitions="28,*">

                <!--  ==================== Кастомная строка окна (chrome, высота 28) ====================
                      Слим-рамка-заголовок (было 40 → 32 → 28 — владелец: «слишком толстая»); держит
                      мини-вордмарк (лого 18 + «departament» 14) + drag + системные кнопки 44×22.
                      Глифы уменьшены (~11px) под тонкую полосу.  -->
                <Grid
                    x:Name="titleBar"
                    Grid.Row="0"
                    Background="Transparent">
                    <!--  Мини-вордмарк слева  -->
                    <StackPanel
                        Margin="14,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="7">
                        <Border
                            Width="18"
                            Height="18"
                            Background="{DynamicResource Brush.Accent}"
                            CornerRadius="6">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{DynamicResource Font.Grotesk}"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Brush.OnAccent}"
                                Text="d" />
                        </Border>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource Font.Grotesk}"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="{DynamicResource Brush.OnSurface}"
                            Text="departament" />
                    </StackPanel>

                    <!--  Системные кнопки справа  -->
                    <StackPanel
                        Margin="0,0,6,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="2">
                        <Button x:Name="btnMin" Classes="WinBtn">
                            <Border Classes="WinBtnBg">
                                <Path
                                    Width="11"
                                    Height="11"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="M0,5.5 H11"
                                    Stretch="None"
                                    Stroke="{DynamicResource Brush.OnSurfaceVariant}"
                                    StrokeLineCap="Round"
                                    StrokeThickness="1.4" />
                            </Border>
                        </Button>
                        <Button x:Name="btnMax" Classes="WinBtn">
                            <Border Classes="WinBtnBg">
                                <Path
                                    Width="10"
                                    Height="10"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="M0.5,0.5 H9.5 V9.5 H0.5 Z"
                                    Stretch="None"
                                    Stroke="{DynamicResource Brush.OnSurfaceVariant}"
                                    StrokeJoin="Round"
                                    StrokeThickness="1.4" />
                            </Border>
                        </Button>
                        <Button
                            x:Name="btnClose"
                            Classes="WinBtn close">
                            <Border Classes="WinBtnBg">
                                <Path
                                    Width="11"
                                    Height="11"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="M0.5,0.5 L10.5,10.5 M10.5,0.5 L0.5,10.5"
                                    Stretch="None"
                                    Stroke="{DynamicResource Brush.OnSurface}"
                                    StrokeLineCap="Round"
                                    StrokeThickness="1.4" />
                            </Border>
                        </Button>
                    </StackPanel>
                </Grid>

                <!--  ==================== Тело (Row 1): единый адаптивный шелл ↔ онбординг ====================
                      Пустой старт (нет подписок): виден ТОЛЬКО онбординг на всю ширину под chrome.
                      После добавления подписки (HomeViewModel.IsEmpty=false) виден bodyRoot.
                      Видимостью управляет ApplyShellVisibility.  -->
                <Panel Grid.Row="1">

                    <!--  ==================== Единый адаптивный шелл (bodyRoot) ====================
                          ОДИН общий contentHost на ОБЕ раскладки. Chrome перекладывается вокруг него:
                          широкая = [рейл(Auto) | контент(*)], компакт = [контент(*) / нижняя-нав(Auto)].
                          Строки/столбцы и Grid.Row/Column детей ставит код (ApplyLayoutMode) — сами
                          контролы НЕ переносятся между деревьями. Ключ к устойчивости свопа: Настройки/
                          Аккаунт (общие экземпляры) всегда живут в ЕДИНОМ contentHost, поэтому смена
                          ширины физически не может «перецепить» живой контрол в другой хост (был краш:
                          компакт→Настройки→расширение). Класс .railCollapsed на bodyRoot управляет
                          свёрткой рейла (стили выше по Grid.railCollapsed).  -->
                    <Grid x:Name="bodyRoot" IsVisible="False">

                        <!--  Сквозная (full-bleed) подложка Главной ПОД рейлом и контентом сразу: рейл
                              больше НЕ красит собственный плоский прямоугольник (на светлой теме плоский
                              Bg #F4F7FC был светлее края градиента #DFE6F1 → читался «белым блоком» при
                              свёрнутом рейле). Теперь свёрнутая полоса делит ТОТ ЖЕ градиент, что и
                              контент: на тёмной теме край градиента == Bg (изменение невидимо), на светлой
                              «белый блок» исчезает. Span на обе раскладки; клик сквозной.  -->
                        <Border
                            Grid.Row="0"
                            Grid.Column="0"
                            Grid.RowSpan="2"
                            Grid.ColumnSpan="2"
                            Background="{DynamicResource Brush.HomeGradient}"
                            IsHitTestVisible="False" />

                        <!--  Левый icon-рейл (широкая раскладка). Фон прозрачный → берёт сквозную
                              подложку выше (в свёрнутом виде НЕ остаётся плоского блока ни в одной теме).  -->
                        <Border
                            x:Name="railHost"
                            Grid.Column="0"
                            Background="Transparent">
                            <DockPanel LastChildFill="False">

                                <!--  3 вкладки (Главная · Настройки · Аккаунт). Список серверов живёт
                                      в левой колонке «Главной», отдельной вкладки «Сервера» нет.
                                      (Бренд-марка «d» убрана — владелец её не хочет в рейле.)  -->
                                <StackPanel
                                    x:Name="navItems"
                                    Margin="0,12,0,0"
                                    Classes="RailItems"
                                    ClipToBounds="True"
                                    DockPanel.Dock="Top">
                                    <Button x:Name="navHome" Classes="NavRailItem">
                                        <Grid>
                                            <Border Classes="NavPill" />
                                            <StackPanel
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Spacing="4">
                                                <PathIcon Data="{StaticResource Geo.Nav.Home}" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    Classes="Chip"
                                                    Text="{loc:T Nav_Home}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="navSettings" Classes="NavRailItem">
                                        <Grid>
                                            <Border Classes="NavPill" />
                                            <StackPanel
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Spacing="4">
                                                <PathIcon Data="{StaticResource Geo.Nav.Settings}" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    Classes="Chip"
                                                    Text="{loc:T Nav_Settings}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="navAccount" Classes="NavRailItem">
                                        <Grid>
                                            <Border Classes="NavPill" />
                                            <StackPanel
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Spacing="4">
                                                <PathIcon Data="{StaticResource Geo.Nav.Account}" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    Classes="Chip"
                                                    Text="{loc:T Nav_Account}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </StackPanel>

                                <!--  Низ рейла (ВСЕГДА виден): индикатор подключения + кнопка свёртки.
                                      Шеврон ‹ сворачивает рейл, › разворачивает — навигация не «застревает».  -->
                                <StackPanel
                                    Margin="0,0,0,12"
                                    HorizontalAlignment="Center"
                                    DockPanel.Dock="Bottom"
                                    Spacing="10">
                                    <Ellipse
                                        x:Name="railStatusDot"
                                        Width="8"
                                        Height="8"
                                        HorizontalAlignment="Center"
                                        Classes="ConnDot" />
                                    <Button
                                        x:Name="btnRailToggle"
                                        Classes="RailToggle"
                                        ToolTip.Tip="{loc:T Nav_CollapsePanel}">
                                        <Border Classes="WinBtnBg">
                                            <Path
                                                Width="20"
                                                Height="20"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Classes="RailToggleGlyph"
                                                Data="M13,4 L7,10 L13,16"
                                                Stretch="None"
                                                Stroke="{DynamicResource Brush.OnSurfaceVariant}"
                                                StrokeJoin="Round"
                                                StrokeLineCap="Round"
                                                StrokeThickness="1.6" />
                                        </Border>
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!--  Общая область контента: Incy-градиент рисуется ОДИН раз под ЕДИНЫМ
                              хостом страниц — каждая вкладка наследует его сквозь прозрачный фон,
                              поэтому фон не «рвётся» на кроссфейде.  -->
                        <Panel x:Name="contentArea">
                            <Border Background="{DynamicResource Brush.HomeGradient}" />
                            <!--  PageTransition назначается в code-behind: RiseFadePageTransition
                                  (§A.4 — кроссфейд + подъём входящей страницы translateY 8→0, OutQuint);
                                  под .lite ставится null (мгновенный своп). Один источник — без инлайна.  -->
                            <TransitioningContentControl x:Name="contentHost" Background="Transparent" />

                            <!--  ==================== Bug5: скрим низа контента (компакт) ====================
                                  Компактная раскладка: контент раньше обрывался резкой линией над нижней
                                  навигацией. Теперь снизу контента лежит мягкий градиент-скрим, и контент
                                  «растворяется» в фон под безрамочной навигацией. Заливка = Brush.Bg
                                  (следует теме: тёмная/светлая/моно), а плавность даёт OpacityMask (только
                                  альфа: прозрачно сверху → непрозрачно снизу), поэтому цвет остаётся тема-
                                  верным во всех темах. Виден ТОЛЬКО в компакте (ApplyLayoutMode гонит
                                  IsVisible); в широкой раскладке нижней навигации нет. Клик сквозной.  -->
                            <Border
                                x:Name="navScrim"
                                Height="72"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource Brush.Bg}"
                                IsHitTestVisible="False"
                                IsVisible="False">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                        <GradientStop Offset="0.0" Color="#00000000" />
                                        <GradientStop Offset="0.5" Color="#59000000" />
                                        <GradientStop Offset="1.0" Color="#FF000000" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                        </Panel>

                        <!--  Нижняя навигация (компактная раскладка). Ставится в свою строку кодом.  -->
                        <views:BottomNavBar x:Name="bottomNav" />
                    </Grid>

                    <!--  Онбординг на всю ширину Row 1 (без рейла/панелей). Виден, пока нет подписок.  -->
                    <views:OnboardingView x:Name="onboardingView" />

                    <!--  ==================== Оверлей синхронизации аккаунта (E3) ====================
                          Полноэкранный экран загрузки «Добавляем аккаунт / Загружаем подписки…» — z-выше
                          онбординга, но НИЖЕ суб-страниц: пока открыт LoginView, он сверху; как только вход
                          закрывает суб-страницу, виден ЭТОТ оверлей (а НЕ пустой онбординг), пока идёт импорт.
                          Гейт — ApplyShellVisibility (3-way: syncing > empty > content). Появление/уход —
                          кроссфейд (C4). По завершении импорта передаёт кадр прямо заполненной «Главной».  -->
                    <views:AccountSyncView x:Name="accountSyncView" IsVisible="False" />

                    <!--  ==================== Хост суб-страниц (Buy/Login/Devices/History) ====================
                          Поверх контента И онбординга: суб-вью — полноэкранные, каждая со своим бесшовным
                          back-тулбаром (Brush.Bg фон полностью перекрывает низлежащее). Стек «назад» ведёт
                          MainWindow.PushSubPage/PopSubPage; скрыт, пока стек пуст. Открытие/закрытие —
                          направленный slide+fade (C2) в PushSubPage/PopSubPage.  -->
                    <ContentControl
                        x:Name="subPageHost"
                        Background="{DynamicResource Brush.Bg}"
                        IsVisible="False"
                        RenderTransformOrigin="50%,50%" />

                    <!--  ==================== Инлайн-уведомление ОТКЛЮЧЕНО (Bug1) ====================
                          Владелец не хочет НИКАКИХ нижних уведомлений (ни на подключении, ни на добавлении
                          подписки, ни на прочих событиях). Разметка пилюли оставлена на месте, но код
                          (DelegateSnackMsg) — осознанный no-op: этот Border НИКОГДА не показывается
                          (IsVisible остаётся False). Ошибки подключения отражает состояние Error на
                          connect-щите. Клик сквозной (IsHitTestVisible=False).  -->
                    <Border
                        x:Name="snackHost"
                        Margin="16,0,16,16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Classes="Toast"
                        IsHitTestVisible="False"
                        IsVisible="False"
                        RenderTransformOrigin="50%,50%">
                        <TextBlock
                            x:Name="snackText"
                            MaxWidth="420"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Border>
                </Panel>
            </Grid>

            <!--  Скрытый StatusBarView: сохраняет обработчики интеракций (буфер/иконка трея/пароль sudo)
                  и питание StatusBarViewModel. Реальные функции переедут в Настройки/Главную в фазе 1.  -->
            <ContentControl
                x:Name="contentStatusBarView"
                Width="0"
                Height="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                ClipToBounds="True"
                IsHitTestVisible="False"
                Opacity="0" />
        </Panel>
    </dialogHost:DialogHost>
</Window>
