<Window
    x:Class="v2rayN.Desktop.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:v2rayN.Desktop.Views"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="departament VPN"
    Width="1120"
    Height="760"
    MinWidth="1000"
    MinHeight="680"
    x:DataType="vms:MainWindowViewModel"
    Background="{DynamicResource Brush.Bg}"
    Design.DataContext="{x:Static dd:DesignData.MainWindow}"
    WindowDecorations="None"
    FontFamily="{DynamicResource Font.Grotesk}"
    Icon="/Assets/NotifyIcon1.ico"
    ShowInTaskbar="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <!--  Кнопки окна (min/max/close) в стиле Incy: прозрачные, hover SurfaceHigh; close hover красный.  -->
    <Window.Styles>
        <Style Selector="Button.WinBtn">
            <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.WinBtn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.WinBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.WinBtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.WinBtnBg">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.WinBtn:pointerover Border.WinBtnBg">
            <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
        </Style>
        <Style Selector="Button.WinBtn.close:pointerover Border.WinBtnBg">
            <Setter Property="Background" Value="{DynamicResource Brush.Red}" />
        </Style>
    </Window.Styles>

    <dialogHost:DialogHost
        Background="#B3000000"
        CloseOnClickAway="True"
        DisableOpeningAnimation="True">
        <Panel>
            <Grid RowDefinitions="32,*">

                <!--  ==================== Кастомная строка окна (chrome, высота 32) ====================
                      Тонкая рамка-заголовок (было 40 — владелец: «слишком толстая»); держит
                      мини-вордмарк + drag + системные кнопки (min/max/close 40×24).  -->
                <Grid
                    x:Name="titleBar"
                    Grid.Row="0"
                    Background="Transparent">
                    <!--  Мини-вордмарк слева  -->
                    <StackPanel
                        Margin="16,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Border
                            Width="22"
                            Height="22"
                            Background="{DynamicResource Brush.Accent}"
                            CornerRadius="7">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{DynamicResource Font.Grotesk}"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Brush.OnAccent}"
                                Text="d" />
                        </Border>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource Font.Grotesk}"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="{DynamicResource Brush.OnSurface}"
                            Text="departament" />
                    </StackPanel>

                    <!--  Системные кнопки справа  -->
                    <StackPanel
                        Margin="0,0,8,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="2">
                        <Button x:Name="btnMin" Classes="WinBtn">
                            <Border Classes="WinBtnBg">
                                <Path
                                    Width="16"
                                    Height="16"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="M5 12 H19"
                                    Stretch="None"
                                    Stroke="{DynamicResource Brush.OnSurfaceVariant}"
                                    StrokeLineCap="Round"
                                    StrokeThickness="1.5" />
                            </Border>
                        </Button>
                        <Button x:Name="btnMax" Classes="WinBtn">
                            <Border Classes="WinBtnBg">
                                <Path
                                    Width="12"
                                    Height="12"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="M6 6 H18 V18 H6 Z"
                                    Stretch="Uniform"
                                    Stroke="{DynamicResource Brush.OnSurfaceVariant}"
                                    StrokeJoin="Round"
                                    StrokeThickness="1.5" />
                            </Border>
                        </Button>
                        <Button
                            x:Name="btnClose"
                            Classes="WinBtn close">
                            <Border Classes="WinBtnBg">
                                <Path
                                    Width="12"
                                    Height="12"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="M6 6 L18 18 M18 6 L6 18"
                                    Stretch="Uniform"
                                    Stroke="{DynamicResource Brush.OnSurface}"
                                    StrokeLineCap="Round"
                                    StrokeThickness="1.5" />
                            </Border>
                        </Button>
                    </StackPanel>
                </Grid>

                <!--  ==================== Тело (Row 1): шелл (рейл 76 | контент) ↔ онбординг ====================
                      Пустой старт (нет подписок): виден ТОЛЬКО онбординг на всю ширину под chrome
                      (рейл и контент скрыты). После добавления подписки (HomeViewModel.IsEmpty=false)
                      появляется обычный шелл. Видимостью управляет MainWindow.SetupHome.  -->
                <Panel Grid.Row="1">

                    <!--  Шелл: рейл 76 | контент. Скрыт целиком, пока приложение пустое.  -->
                    <Grid x:Name="shellRoot" ColumnDefinitions="76,*" IsVisible="False">

                    <!--  Левый icon-рейл: фон = Bg (сливается с окном), без правой границы (DESIGN_PLAN Часть 3).  -->
                    <Border
                        Grid.Column="0"
                        Background="{DynamicResource Brush.Bg}">
                        <DockPanel LastChildFill="False">

                            <!--  3 вкладки (Главная · Настройки · Аккаунт). Список серверов живёт
                                  в левой колонке «Главной», отдельной вкладки «Сервера» нет.  -->
                            <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0">
                                <Button x:Name="navHome" Classes="NavRailItem">
                                    <Grid>
                                        <Border Classes="NavPill" />
                                        <StackPanel
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="4">
                                            <PathIcon Data="{StaticResource Geo.Nav.Home}" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                Classes="Chip"
                                                Text="Главная" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button x:Name="navSettings" Classes="NavRailItem">
                                    <Grid>
                                        <Border Classes="NavPill" />
                                        <StackPanel
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="4">
                                            <PathIcon Data="{StaticResource Geo.Nav.Settings}" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                Classes="Chip"
                                                Text="Настройки" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button x:Name="navAccount" Classes="NavRailItem">
                                    <Grid>
                                        <Border Classes="NavPill" />
                                        <StackPanel
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="4">
                                            <PathIcon Data="{StaticResource Geo.Nav.Account}" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                Classes="Chip"
                                                Text="Аккаунт" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </StackPanel>

                            <!--  Низ рейла: индикатор подключения + кнопка «в трей»  -->
                            <StackPanel
                                Margin="0,0,0,12"
                                HorizontalAlignment="Center"
                                DockPanel.Dock="Bottom"
                                Spacing="10">
                                <Ellipse
                                    x:Name="railStatusDot"
                                    Width="8"
                                    Height="8"
                                    HorizontalAlignment="Center"
                                    Fill="{DynamicResource Brush.OnSurfaceVariant}" />
                                <Button x:Name="btnTray" Classes="WinBtn">
                                    <Border Classes="WinBtnBg">
                                        <PathIcon
                                            Width="18"
                                            Height="18"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Data="M16.59 8.59 12 13.17 7.41 8.59 6 10l6 6 6-6z"
                                            Foreground="{DynamicResource Brush.OnSurfaceVariant}" />
                                    </Border>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!--  Контент по вкладкам (fade-through). Общий Incy-градиент рисуется ОДИН раз
                          под хостом страниц — каждая вкладка (Главная/Настройки/Аккаунт) наследует
                          его сквозь прозрачный фон, поэтому фон не «рвётся» на кроссфейде.  -->
                    <Panel Grid.Column="1">
                        <Border Background="{DynamicResource Brush.HomeGradient}" />
                        <TransitioningContentControl x:Name="contentHost" Background="Transparent">
                            <TransitioningContentControl.PageTransition>
                                <CrossFade Duration="0:0:0.18" />
                            </TransitioningContentControl.PageTransition>
                        </TransitioningContentControl>
                    </Panel>
                    </Grid>

                    <!--  Онбординг на всю ширину Row 1 (без рейла/панелей). Виден, пока нет подписок.  -->
                    <views:OnboardingView x:Name="onboardingView" />

                    <!--  ==================== Хост суб-страниц (Buy/Login/Devices/History) ====================
                          Поверх контента И онбординга: суб-вью — полноэкранные, каждая со своим бесшовным
                          back-тулбаром (Brush.Bg фон полностью перекрывает низлежащее). Стек «назад» ведёт
                          MainWindow.PushSubPage/PopSubPage; скрыт, пока стек пуст.  -->
                    <ContentControl
                        x:Name="subPageHost"
                        Background="{DynamicResource Brush.Bg}"
                        IsVisible="False" />
                </Panel>
            </Grid>

            <!--  Скрытый StatusBarView: сохраняет обработчики интеракций (буфер/иконка трея/пароль sudo)
                  и питание StatusBarViewModel. Реальные функции переедут в Настройки/Главную в фазе 1.  -->
            <ContentControl
                x:Name="contentStatusBarView"
                Width="0"
                Height="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                ClipToBounds="True"
                IsHitTestVisible="False"
                Opacity="0" />
        </Panel>
    </dialogHost:DialogHost>
</Window>
