<Window
    x:Class="v2rayN.Desktop.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:v2rayN.Desktop.Views"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="departament VPN"
    Width="310"
    Height="630"
    MinWidth="300"
    MinHeight="560"
    x:DataType="vms:MainWindowViewModel"
    Background="{DynamicResource Brush.Bg}"
    Design.DataContext="{x:Static dd:DesignData.MainWindow}"
    WindowDecorations="None"
    FontFamily="{DynamicResource Font.Grotesk}"
    Icon="/Assets/NotifyShieldOn.ico"
    ShowInTaskbar="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <!--  Кнопки окна (min/max/close) в стиле Incy: прозрачные, hover SurfaceHigh; close hover красный.  -->
    <Window.Styles>
        <Style Selector="Button.WinBtn">
            <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.WinBtn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.WinBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.WinBtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.WinBtnBg">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.WinBtn:pointerover Border.WinBtnBg">
            <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
        </Style>
        <Style Selector="Button.WinBtn.close:pointerover Border.WinBtnBg">
            <Setter Property="Background" Value="{DynamicResource Brush.Red}" />
        </Style>

        <!--  ==================== Свёртка нав-рейла ====================
              Кнопка внизу рейла (btnRailToggle) сворачивает/разворачивает ЛЕВУЮ навигацию
              (раньше прятала окно в трей — убрано; трей живёт в App.axaml + title-bar «мин»).
              Состоянием управляет класс .railCollapsed на bodyRoot (ставит code-behind):
                • navItems (StackPanel вкладок) едет Width 76→0 + Opacity 1→0 (OutQuint 200мс),
                  ClipToBounds режет 76-пиксельные пункты, столбец Auto рефлоит контент;
                • шеврон разворачивается на 180° вокруг СОБСТВЕННОГО центра (RenderTransformOrigin
                  0.5,0.5 на самом Path, НЕ на кейфрейме): ‹ (свернуть) ⇄ › (развернуть) — вращение
                  на месте, без смещения.
              В .lite (reduced-motion) переходы обнуляются — состояние переключается мгновенно.  -->

        <!--  Кнопка-переключатель рейла: слим 30×30, круглый hover, press-scale.  -->
        <Style Selector="Button.RailToggle">
            <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.RailToggle:pressed">
            <Setter Property="RenderTransform" Value="scale(0.92)" />
        </Style>
        <Style Selector="Button.RailToggle Border.WinBtnBg">
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
        </Style>
        <Style Selector="Button.RailToggle:pointerover Border.WinBtnBg">
            <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
        </Style>

        <!--  Шеврон переключателя: по умолчанию ‹ (свернуть). Крутится вокруг своего центра.  -->
        <Style Selector="Path.RailToggleGlyph">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2">
                        <TransformOperationsTransition.Easing>
                            <SplineEasing X1="0.22" Y1="1" X2="0.36" Y2="1" />
                        </TransformOperationsTransition.Easing>
                    </TransformOperationsTransition>
                </Transitions>
            </Setter>
        </Style>
        <!--  Свёрнуто → шеврон 180° = › (развернуть).  -->
        <Style Selector="Grid.railCollapsed Path.RailToggleGlyph">
            <Setter Property="RenderTransform" Value="rotate(180deg)" />
        </Style>

        <!--  Столбец вкладок: развёрнут 76, ClipToBounds; плавная свёртка ширины/непрозрачности.  -->
        <Style Selector="StackPanel.RailItems">
            <Setter Property="Width" Value="76" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.2">
                        <DoubleTransition.Easing>
                            <SplineEasing X1="0.22" Y1="1" X2="0.36" Y2="1" />
                        </DoubleTransition.Easing>
                    </DoubleTransition>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Grid.railCollapsed StackPanel.RailItems">
            <Setter Property="Width" Value="0" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <!--  Reduced-motion: переходы свёртки/шеврона мгновенны (состояние без анимации).  -->
        <Style Selector=":is(Window).lite StackPanel.RailItems">
            <Setter Property="Transitions">
                <Transitions />
            </Setter>
        </Style>
        <Style Selector=":is(Window).lite Path.RailToggleGlyph">
            <Setter Property="Transitions">
                <Transitions />
            </Setter>
        </Style>
        <Style Selector=":is(Window).lite Button.RailToggle">
            <Setter Property="Transitions">
                <Transitions />
            </Setter>
        </Style>
    </Window.Styles>

    <dialogHost:DialogHost
        Background="#B3000000"
        CloseOnClickAway="True"
        DisableOpeningAnimation="True">
        <Panel>
            <Grid RowDefinitions="28,*">

                <!--  ==================== Кастомная строка окна (chrome, высота 28) ====================
                      Слим-рамка-заголовок (было 40 → 32 → 28 — владелец: «слишком толстая»); держит
                      мини-вордмарк (лого 18 + «departament» 14) + drag + системные кнопки 44×22.
                      Глифы уменьшены (~11px) под тонкую полосу.  -->
                <Grid
                    x:Name="titleBar"
                    Grid.Row="0"
                    Background="Transparent">
                    <!--  Мини-вордмарк слева  -->
                    <StackPanel
                        Margin="14,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="7">
                        <Border
                            Width="18"
                            Height="18"
                            Background="{DynamicResource Brush.Accent}"
                            CornerRadius="6">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{DynamicResource Font.Grotesk}"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Brush.OnAccent}"
                                Text="d" />
                        </Border>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource Font.Grotesk}"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="{DynamicResource Brush.OnSurface}"
                            Text="departament" />
                    </StackPanel>

                    <!--  Системные кнопки справа  -->
                    <StackPanel
                        Margin="0,0,6,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="2">
                        <Button x:Name="btnMin" Classes="WinBtn">
                            <Border Classes="WinBtnBg">
                                <Path
                                    Width="11"
                                    Height="11"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="M0,5.5 H11"
                                    Stretch="None"
                                    Stroke="{DynamicResource Brush.OnSurfaceVariant}"
                                    StrokeLineCap="Round"
                                    StrokeThickness="1.4" />
                            </Border>
                        </Button>
                        <Button x:Name="btnMax" Classes="WinBtn">
                            <Border Classes="WinBtnBg">
                                <Path
                                    Width="10"
                                    Height="10"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="M0.5,0.5 H9.5 V9.5 H0.5 Z"
                                    Stretch="None"
                                    Stroke="{DynamicResource Brush.OnSurfaceVariant}"
                                    StrokeJoin="Round"
                                    StrokeThickness="1.4" />
                            </Border>
                        </Button>
                        <Button
                            x:Name="btnClose"
                            Classes="WinBtn close">
                            <Border Classes="WinBtnBg">
                                <Path
                                    Width="11"
                                    Height="11"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="M0.5,0.5 L10.5,10.5 M10.5,0.5 L0.5,10.5"
                                    Stretch="None"
                                    Stroke="{DynamicResource Brush.OnSurface}"
                                    StrokeLineCap="Round"
                                    StrokeThickness="1.4" />
                            </Border>
                        </Button>
                    </StackPanel>
                </Grid>

                <!--  ==================== Тело (Row 1): единый адаптивный шелл ↔ онбординг ====================
                      Пустой старт (нет подписок): виден ТОЛЬКО онбординг на всю ширину под chrome.
                      После добавления подписки (HomeViewModel.IsEmpty=false) виден bodyRoot.
                      Видимостью управляет ApplyShellVisibility.  -->
                <Panel Grid.Row="1">

                    <!--  ==================== Единый адаптивный шелл (bodyRoot) ====================
                          ОДИН общий contentHost на ОБЕ раскладки. Chrome перекладывается вокруг него:
                          широкая = [рейл(Auto) | контент(*)], компакт = [контент(*) / нижняя-нав(Auto)].
                          Строки/столбцы и Grid.Row/Column детей ставит код (ApplyLayoutMode) — сами
                          контролы НЕ переносятся между деревьями. Ключ к устойчивости свопа: Настройки/
                          Аккаунт (общие экземпляры) всегда живут в ЕДИНОМ contentHost, поэтому смена
                          ширины физически не может «перецепить» живой контрол в другой хост (был краш:
                          компакт→Настройки→расширение). Класс .railCollapsed на bodyRoot управляет
                          свёрткой рейла (стили выше по Grid.railCollapsed).  -->
                    <Grid x:Name="bodyRoot" IsVisible="False">

                        <!--  Левый icon-рейл (широкая раскладка). Фон = Bg (сливается с окном).  -->
                        <Border
                            x:Name="railHost"
                            Grid.Column="0"
                            Background="{DynamicResource Brush.Bg}">
                            <DockPanel LastChildFill="False">

                                <!--  Бренд-марка departament: ВСЕГДА видна, даже когда рейл свёрнут
                                      (живёт ВНЕ navItems, который и сворачивается) — пользователь не
                                      теряет лого/идентичность в слим-полосе.  -->
                                <Border
                                    x:Name="railBrand"
                                    Width="40"
                                    Height="40"
                                    Margin="0,10,0,2"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource Brush.Accent}"
                                    CornerRadius="{DynamicResource Radius.Tile}"
                                    DockPanel.Dock="Top">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{DynamicResource Font.Grotesk}"
                                        FontSize="20"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource Brush.OnAccent}"
                                        Text="d" />
                                </Border>

                                <!--  3 вкладки (Главная · Настройки · Аккаунт). Список серверов живёт
                                      в левой колонке «Главной», отдельной вкладки «Сервера» нет.  -->
                                <StackPanel
                                    x:Name="navItems"
                                    Margin="0,8,0,0"
                                    Classes="RailItems"
                                    ClipToBounds="True"
                                    DockPanel.Dock="Top">
                                    <Button x:Name="navHome" Classes="NavRailItem">
                                        <Grid>
                                            <Border Classes="NavPill" />
                                            <StackPanel
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Spacing="4">
                                                <PathIcon Data="{StaticResource Geo.Nav.Home}" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    Classes="Chip"
                                                    Text="Главная" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="navSettings" Classes="NavRailItem">
                                        <Grid>
                                            <Border Classes="NavPill" />
                                            <StackPanel
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Spacing="4">
                                                <PathIcon Data="{StaticResource Geo.Nav.Settings}" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    Classes="Chip"
                                                    Text="Настройки" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="navAccount" Classes="NavRailItem">
                                        <Grid>
                                            <Border Classes="NavPill" />
                                            <StackPanel
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Spacing="4">
                                                <PathIcon Data="{StaticResource Geo.Nav.Account}" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    Classes="Chip"
                                                    Text="Аккаунт" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </StackPanel>

                                <!--  Низ рейла (ВСЕГДА виден): индикатор подключения + кнопка свёртки.
                                      Шеврон ‹ сворачивает рейл, › разворачивает — навигация не «застревает».  -->
                                <StackPanel
                                    Margin="0,0,0,12"
                                    HorizontalAlignment="Center"
                                    DockPanel.Dock="Bottom"
                                    Spacing="10">
                                    <Ellipse
                                        x:Name="railStatusDot"
                                        Width="8"
                                        Height="8"
                                        HorizontalAlignment="Center"
                                        Fill="{DynamicResource Brush.OnSurfaceVariant}" />
                                    <Button
                                        x:Name="btnRailToggle"
                                        Classes="RailToggle"
                                        ToolTip.Tip="Свернуть панель">
                                        <Border Classes="WinBtnBg">
                                            <Path
                                                Width="20"
                                                Height="20"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Classes="RailToggleGlyph"
                                                Data="M13,4 L7,10 L13,16"
                                                Stretch="None"
                                                Stroke="{DynamicResource Brush.OnSurfaceVariant}"
                                                StrokeJoin="Round"
                                                StrokeLineCap="Round"
                                                StrokeThickness="1.6" />
                                        </Border>
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!--  Общая область контента: Incy-градиент рисуется ОДИН раз под ЕДИНЫМ
                              хостом страниц — каждая вкладка наследует его сквозь прозрачный фон,
                              поэтому фон не «рвётся» на кроссфейде.  -->
                        <Panel x:Name="contentArea">
                            <Border Background="{DynamicResource Brush.HomeGradient}" />
                            <TransitioningContentControl x:Name="contentHost" Background="Transparent">
                                <TransitioningContentControl.PageTransition>
                                    <CrossFade Duration="0:0:0.18" />
                                </TransitioningContentControl.PageTransition>
                            </TransitioningContentControl>
                        </Panel>

                        <!--  Нижняя навигация (компактная раскладка). Ставится в свою строку кодом.  -->
                        <views:BottomNavBar x:Name="bottomNav" />
                    </Grid>

                    <!--  Онбординг на всю ширину Row 1 (без рейла/панелей). Виден, пока нет подписок.  -->
                    <views:OnboardingView x:Name="onboardingView" />

                    <!--  ==================== Хост суб-страниц (Buy/Login/Devices/History) ====================
                          Поверх контента И онбординга: суб-вью — полноэкранные, каждая со своим бесшовным
                          back-тулбаром (Brush.Bg фон полностью перекрывает низлежащее). Стек «назад» ведёт
                          MainWindow.PushSubPage/PopSubPage; скрыт, пока стек пуст.  -->
                    <ContentControl
                        x:Name="subPageHost"
                        Background="{DynamicResource Brush.Bg}"
                        IsVisible="False" />
                </Panel>
            </Grid>

            <!--  Скрытый StatusBarView: сохраняет обработчики интеракций (буфер/иконка трея/пароль sudo)
                  и питание StatusBarViewModel. Реальные функции переедут в Настройки/Главную в фазе 1.  -->
            <ContentControl
                x:Name="contentStatusBarView"
                Width="0"
                Height="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                ClipToBounds="True"
                IsHitTestVisible="False"
                Opacity="0" />
        </Panel>
    </dialogHost:DialogHost>
</Window>
