<Window
    x:Class="v2rayN.Desktop.Views.AboutSubWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="О приложении"
    Width="520"
    Height="520"
    Background="{DynamicResource Brush.Bg}"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <DockPanel>
        <Grid
            Margin="16,14,16,10"
            ColumnDefinitions="*,Auto"
            DockPanel.Dock="Top">
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Classes="Headline"
                Text="О приложении" />
            <Button
                x:Name="btnDone"
                Grid.Column="1"
                Classes="Primary"
                Content="Готово" />
        </Grid>
        <Border
            Height="1"
            Background="{DynamicResource Brush.OutlineVariant}"
            DockPanel.Dock="Top" />

        <StackPanel Margin="16,16,16,24" Spacing="8">
            <StackPanel Margin="0,4,0,8" HorizontalAlignment="Center" Spacing="4">
                <TextBlock
                    HorizontalAlignment="Center"
                    Classes="Display"
                    Text="departament" />
                <TextBlock
                    x:Name="txtVersion"
                    HorizontalAlignment="Center"
                    Classes="Subtitle"
                    Text="Версия —" />
            </StackPanel>

            <Border Classes="Card" Padding="16,4">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto" MinHeight="56">
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Classes="Body" Text="Открыть сайт" />
                        <Button x:Name="btnSite" Grid.Column="1" VerticalAlignment="Center" Content="departament.site" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Brush.OutlineVariant}" />
                    <Grid ColumnDefinitions="*,Auto" MinHeight="56">
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Classes="Body" Text="Telegram-бот" />
                        <Button x:Name="btnTelegram" Grid.Column="1" VerticalAlignment="Center" Content="Открыть" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Classes="SectionHeader" Text="Сведения" />
            <Border Classes="Card" Padding="16,12">
                <StackPanel Spacing="8">
                    <TextBlock
                        x:Name="txtRuntime"
                        Classes="Subtitle"
                        Text="—"
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="btnCopy"
                        HorizontalAlignment="Left"
                        Content="Копировать сведения" />
                </StackPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
