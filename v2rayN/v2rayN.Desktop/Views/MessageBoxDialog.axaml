<Window
    x:Class="v2rayN.Desktop.Views.MessageBoxDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    Background="{DynamicResource Brush.Bg}"
    CanResize="False"
    FontFamily="{DynamicResource Font.Ui}"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    WindowDecorations="None"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <!--
        Incy-подтверждение (замена стокового OS/v2rayN-диалога). ОБЩИЙ для всех yes/no
        (удаление сервера/подписки/правил и пр.), поэтому оформлен глобально-и-безопасно
        токенами Incy. Хрома OS-заголовка нет (WindowDecorations=None), поэтому «v2rayN» из
        заголовка исчезает — сам вопрос ЕСТЬ заголовок. Фон окна = Brush.Bg (Incy-подложка,
        надёжно во всех темах и без зависимости от прозрачности композитора), поверх — карточка
        Surface: radius_card 20, 1px OutlineVariant, мягкая тень (читается плавающей на подложке).
        Утвердительная — акцентная Primary (годится и для не-деструктивных подтверждений),
        «Отмена» — тональная. Тема (тёмная/светлая/mono) соблюдается через DynamicResource.
    -->

    <Border
        Margin="16"
        Padding="24"
        Background="{DynamicResource Brush.Surface}"
        BorderBrush="{DynamicResource Brush.OutlineVariant}"
        BorderThickness="1"
        BoxShadow="0 16 40 0 #73000000"
        CornerRadius="{DynamicResource Radius.Card}">
        <StackPanel Width="300" Spacing="24">

            <!--  Вопрос = заголовок диалога: OnSurface, sentence-case, перенос; длинный текст скроллится.  -->
            <ScrollViewer
                MaxHeight="280"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <TextBlock
                    x:Name="txtMessage"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource Brush.OnSurface}"
                    LineHeight="24"
                    TextWrapping="Wrap" />
            </ScrollViewer>

            <!--  Действия: «Отмена» (тональная) слева · подтверждение (сплошная заливка) справа.
                  Класс подтверждающей и её подпись ставит code-behind: у ДЕСТРУКТИВНОГО вопроса это
                  Button.Destructive и глагол «Удалить», у обычного — Button.Primary и «Подтвердить».
                  Раньше подтверждающая всегда была Primary, чей фон объявлялся на КНОПКЕ и никогда на
                  презентере, который его рисует, — поэтому в покое она брала нейтральный тон темы
                  Semi и рядом со сплошной «Отменой» читалась ВЫКЛЮЧЕННОЙ (D3). Покой презентера
                  теперь объявлен у всех архетипов (GlobalStyles), а деструктивное действие вдобавок
                  окрашено красным: оно обязано читаться как главное, а не как погашенное.  -->
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="12">
                <Button
                    x:Name="btnNo"
                    MinWidth="96"
                    Padding="18,0"
                    Classes="Tonal"
                    Content="{x:Static resx:ResUI.TbCancel}"
                    IsCancel="True" />
                <Button
                    x:Name="btnYes"
                    MinWidth="112"
                    Padding="18,0"
                    Classes="Primary"
                    Content="{x:Static resx:ResUI.TbConfirm}"
                    IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
