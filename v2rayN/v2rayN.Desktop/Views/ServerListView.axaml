<UserControl
    x:Class="v2rayN.Desktop.Views.ServerListView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:local="clr-namespace:v2rayN.Desktop.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:ServiceLib.Models.Dto;assembly=ServiceLib"
    xmlns:vms="clr-namespace:v2rayN.Desktop.ViewModels"
    d:DesignHeight="900"
    d:DesignWidth="440"
    x:DataType="vms:HomeViewModel"
    Design.DataContext="{x:Static dd:DesignData.Home}"
    mc:Ignorable="d">

    <!--  DATA-DRIVEN: binds to the real HomeViewModel (grouped ProfileItems). The app starts EMPTY —
          the list only appears once a subscription is added. Sample rows live ONLY in
          DesignData.Home (design-time preview), never at runtime.  -->

    <UserControl.Resources>
        <!--  Local Material 24 glyphs (one family): chevron / filter / refresh / ping / plus.
              View-scope resources (not design-system tokens). Port of layout_servers_header + group chevron.  -->
        <StreamGeometry x:Key="Geo.Chevron">M16.59 8.59 12 13.17 7.41 8.59 6 10l6 6 6-6z</StreamGeometry>
        <StreamGeometry x:Key="Geo.Filter">M4.25 5.61C6.27 8.2 10 13 10 13v5c0 .55.45 1 1 1h2c.55 0 1-.45 1-1v-5s3.72-4.8 5.74-7.39c.51-.66.04-1.61-.79-1.61H5.04c-.83 0-1.3.95-.79 1.61z</StreamGeometry>
        <StreamGeometry x:Key="Geo.Refresh">M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4z</StreamGeometry>
        <StreamGeometry x:Key="Geo.Ping">M12 11c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0-4c-3.31 0-6 2.69-6 6h2c0-2.21 1.79-4 4-4s4 1.79 4 4h2c0-3.31-2.69-6-6-6zm0-4C6.48 3 2 7.48 2 13h2c0-4.42 3.58-8 8-8s8 3.58 8 8h2c0-5.52-4.48-10-10-10z</StreamGeometry>
        <StreamGeometry x:Key="Geo.Plus">M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6z</StreamGeometry>
    </UserControl.Resources>

    <UserControl.Styles>
        <!--  Group chevron: 0° expanded, −90° collapsed (smooth, mirrors bindHeader rotation).  -->
        <Style Selector="PathIcon.groupChevron">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="PathIcon.groupChevron.collapsed">
            <Setter Property="RenderTransform" Value="rotate(-90deg)" />
        </Style>

        <!--  Group header: hover highlight (like selectableItemBackground).  -->
        <Style Selector="Border.groupHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.groupHeader:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHigh}" />
        </Style>
    </UserControl.Styles>

    <Grid Background="{DynamicResource Brush.Bg}" RowDefinitions="Auto,*">

        <!--  HEADER (layout_servers_header): title + round actions + subtitle + search pill.  -->
        <StackPanel Grid.Row="0" Margin="16,8,12,4">

            <!--  Title «Сервера» + actions: collapse-all / refresh / ping-all / add (accent).  -->
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Classes="Headline"
                    Text="Сервера" />
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="2">
                    <Button Classes="IconButton" Click="OnCollapseAllClick">
                        <PathIcon
                            Width="22"
                            Height="22"
                            Data="{StaticResource Geo.Chevron}"
                            Foreground="{DynamicResource Brush.OnSurfaceVariant}" />
                    </Button>
                    <Button Classes="IconButton" Command="{Binding RefreshSubscriptionCmd}">
                        <PathIcon
                            Width="22"
                            Height="22"
                            Data="{StaticResource Geo.Refresh}"
                            Foreground="{DynamicResource Brush.OnSurfaceVariant}" />
                    </Button>
                    <Button Classes="IconButton" Command="{Binding Profiles.FastRealPingCmd}">
                        <PathIcon
                            Width="22"
                            Height="22"
                            Data="{StaticResource Geo.Ping}"
                            Foreground="{DynamicResource Brush.OnSurfaceVariant}" />
                    </Button>
                    <Button Classes="IconButton" Command="{Binding AddViaClipboardCmd}">
                        <PathIcon
                            Width="22"
                            Height="22"
                            Data="{StaticResource Geo.Plus}"
                            Foreground="{DynamicResource Brush.Accent}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!--  Subtitle «N серверов · M провайдеров» — recomputed from the real collections.  -->
            <TextBlock
                Margin="0,4,0,0"
                Classes="Subtitle"
                Text="{Binding Subtitle}" />

            <!--  Search pill (bg_search_pill): filter glyph + «Поиск серверов…» bound to ServerFilter.  -->
            <Border
                Height="44"
                Margin="0,12,4,0"
                Classes="SearchPill">
                <Grid Margin="14,0" ColumnDefinitions="Auto,*">
                    <PathIcon
                        Grid.Column="0"
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        Data="{StaticResource Geo.Filter}"
                        Foreground="{DynamicResource Brush.OnSurfaceVariant}" />
                    <TextBox
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="0"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="14"
                        Foreground="{DynamicResource Brush.OnSurface}"
                        PlaceholderText="Поиск серверов…"
                        Text="{Binding Profiles.ServerFilter}" />
                </Grid>
            </Border>
        </StackPanel>

        <!--  BODY: real grouped list when there are servers; quiet empty note otherwise.  -->
        <Panel Grid.Row="1">

            <!--  SCROLL: grouped flat list (group header + nested rows), bound to real ProfileItems.  -->
            <ScrollViewer IsVisible="{Binding HasServers}">
                <ItemsControl ItemsSource="{Binding ServerGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vms:HomeServerGroup">
                            <StackPanel>

                                <!--  Group header (= subscription): chevron + name + count.  -->
                                <Border
                                    Padding="16,12,16,4"
                                    Classes="groupHeader"
                                    Tapped="OnGroupHeaderTapped">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <PathIcon
                                            Grid.Column="0"
                                            Width="22"
                                            Height="22"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Classes="groupChevron"
                                            Classes.collapsed="{Binding !IsExpanded}"
                                            Data="{StaticResource Geo.Chevron}"
                                            Foreground="{DynamicResource Brush.OnSurfaceVariant}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Classes="Title"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Classes="Subtitle"
                                            Text="{Binding CountText}" />
                                    </Grid>
                                </Border>

                                <!--  Group rows (collapse with the group).  -->
                                <ItemsControl IsVisible="{Binding IsExpanded}" ItemsSource="{Binding Servers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:ProfileItemModel">

                                            <!--  Server row (bg_server_row): selected = blue pill outline (IsActive).
                                                  Tap → HomeViewModel.SelectServer (default + connect).  -->
                                            <Border
                                                Margin="16,4"
                                                Classes="ServerRow"
                                                Classes.selected="{Binding IsActive}"
                                                Tapped="OnServerRowTapped">
                                                <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">

                                                    <!--  Flag: circular clip; RemarkToFlag resolves the country flag from Remarks.  -->
                                                    <Border
                                                        Grid.Column="0"
                                                        Width="32"
                                                        Height="32"
                                                        Margin="0,0,12,0"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource Brush.SurfaceVariant}"
                                                        BorderBrush="{DynamicResource Brush.OutlineVariant}"
                                                        BorderThickness="1"
                                                        ClipToBounds="True"
                                                        CornerRadius="100">
                                                        <Image Source="{Binding Remarks, Converter={StaticResource RemarkToFlag}}" Stretch="UniformToFill" />
                                                    </Border>

                                                    <!--  Name (bold, ellipsize) + «protocol chip · transport».  -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock
                                                            Classes="Title"
                                                            Text="{Binding Remarks}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <StackPanel
                                                            Margin="0,4,0,0"
                                                            VerticalAlignment="Center"
                                                            Orientation="Horizontal">
                                                            <Border Classes="ProtocolChip">
                                                                <TextBlock
                                                                    Classes="Chip"
                                                                    Foreground="{DynamicResource Brush.Accent}"
                                                                    Text="{Binding ConfigType, Converter={StaticResource ConfigTypeToProtocol}}" />
                                                            </Border>
                                                            <TextBlock
                                                                Margin="8,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Classes="Caption"
                                                                Text="{Binding Converter={StaticResource ProfileTransport}}"
                                                                TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!--  Empty state (left panel): quiet placeholder. The full onboarding CTAs live in the
                  connect-hero (right panel). Shown when there are no servers/subscriptions.  -->
            <StackPanel
                Margin="24,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding IsEmpty}"
                Spacing="6">
                <TextBlock
                    HorizontalAlignment="Center"
                    Classes="Title"
                    Foreground="{DynamicResource Brush.OnSurfaceVariant}"
                    Text="Список пуст"
                    TextAlignment="Center" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Classes="Subtitle"
                    Text="Добавьте подписку, чтобы увидеть серверы"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Panel>
    </Grid>
</UserControl>
