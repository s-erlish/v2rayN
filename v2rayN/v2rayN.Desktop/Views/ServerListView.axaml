<UserControl
    x:Class="v2rayN.Desktop.Views.ServerListView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:loc="clr-namespace:v2rayN.Desktop.Common"
    xmlns:local="clr-namespace:v2rayN.Desktop.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:ServiceLib.Models.Dto;assembly=ServiceLib"
    xmlns:vms="clr-namespace:v2rayN.Desktop.ViewModels"
    d:DesignHeight="900"
    d:DesignWidth="440"
    x:DataType="vms:HomeViewModel"
    Design.DataContext="{x:Static dd:DesignData.Home}"
    mc:Ignorable="d">

    <!--  DATA-DRIVEN: binds the real HomeViewModel (grouped ProfileItems). Starts EMPTY —
          the list appears only once a subscription is added. Sample rows live ONLY in
          DesignData.Home (previewer), never at runtime.

          Owner's structural demand: NO separate «Сервера» header / toolbar / top-right «+».
          Each subscription is ONE cohesive section — its rich meta-bar (SubscriptionMetaView,
          the group header) flows DIRECTLY into its server rows. Multiple subscriptions =
          multiple such sections, each collapsible from its own meta-bar chevron.  -->

    <UserControl.Resources>
        <!--  Empty-state hero glyph (cloud download, port of ic_cloud_download_24dp).  -->
        <StreamGeometry x:Key="Geo.CloudDownload">M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z</StreamGeometry>
        <!--  Unified globe emblem for non-country / aggregate rows (import sub, xHTTP…).  -->
        <StreamGeometry x:Key="Geo.Globe">M12,2C6.48,2 2,6.48 2,12s4.48,10 10,10 10,-4.48 10,-10S17.52,2 12,2zM11,19.93c-3.95,-0.49 -7,-3.85 -7,-7.93 0,-0.62 0.08,-1.21 0.21,-1.79L9,15v1c0,1.1 0.9,2 2,2v1.93zM17.9,17.39c-0.26,-0.81 -1,-1.39 -1.9,-1.39h-1v-3c0,-0.55 -0.45,-1 -1,-1H8v-2h2c0.55,0 1,-0.45 1,-1V7h2c1.1,0 2,-0.9 2,-2v-0.41c2.93,1.19 5,4.06 5,7.41 0,2.08 -0.8,3.97 -2.1,5.39z</StreamGeometry>

        <!--  Server name: drop a leading flag emoji (the flag lives in its tile) — no duplication.  -->
        <local:StripLeadingFlagConverter x:Key="StripLeadingFlag" />
        <!--  Ping value shows only once a latency test produced a real (numeric ms) result.  -->
        <local:DelayResultConverter x:Key="DelayResult" />
        <!--  A test is in flight for this row: DelayVal holds the engine's non-numeric «Testing…»
              placeholder → show a spinner in the ping slot, never the placeholder text.  -->
        <local:DelayTestingConverter x:Key="DelayTesting" />
        <!--  A8: real reading → its ms number; a failed / timed-out probe («-1») → em-dash «—».  -->
        <local:DelayDisplayConverter x:Key="DelayDisplay" />
        <!--  A8: real reading → theme ink (blue/light, white/dark); failure («—») → muted variant tone.  -->
        <local:DelayInkConverter x:Key="DelayInk" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!--  Row divider (port of custom_divider): 1px, inset to the text-column start
              (16 gutter + 12 row padding + 40 tile + 12 gap = 80), full-bleed to the 16 gutter
              on the right. Hidden on the selected row so the blue pill reads cleanly. ONE
              separator only — a single row gap, no competing margins.  -->
        <Style Selector="Border.rowDivider">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="80,0,16,0" />
            <Setter Property="Background" Value="{DynamicResource Brush.OutlineVariant}" />
        </Style>

        <!--  Пинг-спиннер: гасим ПОЛНОСТЬЮ вне «теста» и под «Облегчённым режимом».
              Раньше видимость дуги висела на локальном IsVisible-биндинге (DelayTesting), а вращение
              гасил только глобальный селектор :is(Window):not(.lite) — под lite оставалась ЗАМЁРЗШАЯ
              половина кольца. Теперь видимость дуги привязана к ТОМУ ЖЕ рычагу, что и вращение: базово
              скрыта, показывается лишь пока идёт тест И движение включено. Тот же lever, что у
              ConnectHeroView (класс .lite на окне) → под lite дуга схлопывается (ничего не видно), и
              реагирует ЖИВО при переключении режима (класс .lite на окне ставится/снимается на лету).  -->
        <Style Selector="Ellipse.Spinner">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector=":is(Window):not(.lite) Ellipse.Spinner.spinning">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </UserControl.Styles>

    <Grid Background="Transparent">

        <!--  SCROLL: subscription sections (meta-bar header + its rows), bound to real ServerGroups.
              CLEARANCE — the bottom breathing room is a REAL trailing spacer child at the END of the
              scroll content (the trailing spacer below), NOT `ScrollViewer.Padding`. In this Avalonia
              build the ScrollViewer's bottom Padding is NOT reliably folded into the scroll Extent, so a
              padding-only clearance let the last row sit past the scrollable range and never come fully
              into view («bottom border clips the final server», both layouts). A child's height is ALWAYS
              part of the Extent, so a 0-hit-test spacer guarantees the last row scrolls clear. Compact's
              bottom nav no longer overlays the list (MainWindow's `navScrim` now reserves space instead
              of painting over `contentHost`), so ONE modest tail covers both layouts with no dead space.  -->
        <ScrollViewer IsVisible="{Binding HasServers}">
            <StackPanel>
            <ItemsControl ItemsSource="{Binding ServerGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vms:HomeServerGroup">
                        <StackPanel Margin="0,0,0,4">

                            <!--  Subscription meta-bar = the section header (name + traffic pill +
                                  actions + collapse chevron + delete). Flows directly into its rows.  -->
                            <local:SubscriptionMetaView Margin="16,16,16,8" />

                            <!--  Group rows reveal (collapse with the group via the meta-bar chevron).
                                  The chevron flips HomeServerGroup.IsExpanded; the code-behind runs a
                                  Transitions-driven accordion on THIS ClipToBounds viewport — a DoubleTransition
                                  tweens Height (0 ↔ measured content height) AND Opacity (0 ↔ 1) together over
                                  ~300ms OutQuint, so the list clips open/closed in step with the fade — both
                                  expand AND collapse visibly animate. Same primitive as the chevron rotate and
                                  the rail-width animation. Gated: under lite / reduced-motion the toggle is instant.  -->
                            <Border
                                ClipToBounds="True"
                                Loaded="OnGroupRevealLoaded"
                                Unloaded="OnGroupRevealUnloaded">
                            <ItemsControl ItemsSource="{Binding Servers}">
                                <!--  RAM: virtualize the per-group server rows. Avalonia's
                                      VirtualizingStackPanel realizes containers off the EFFECTIVE
                                      VIEWPORT (the visible window propagated down through the
                                      ScrollViewer / PageScroll clip + this reveal's ClipToBounds),
                                      NOT off a direct-ScrollViewer-child relationship — so it
                                      virtualizes even though the rows are nested (reveal Border →
                                      outer StackPanel → ScrollViewer). Only ~on-screen rows are
                                      realized+retained; off-screen rows recycle, dropping the
                                      dominant list RAM cost. The panel still reports the ESTIMATED
                                      FULL extent (rows are uniform height) as its DesiredSize, so the
                                      reveal's height measure, the scroll extent and the trailing
                                      spacer (last-row reachability) all stay correct; a collapsed
                                      group (Height 0 / IsVisible=false) realizes no rows at all.  -->
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ProfileItemModel">
                                        <StackPanel>

                                            <!--  Server row (bg_server_row): default flat, hover SurfaceHigh, pressed
                                                  scale 0.96, selected = blue pill (12% accent fill + 1.5px Accent,
                                                  radius 16). Tap → SelectServer (default + connect). Right-click → §2.13.
                                                  ONE grid: 56 rhythm, 40 tile, single inset divider, no vertical margin.  -->
                                            <!--  Loaded → одноразовый reveal-стаггер первой заливки списка
                                                  (первые ≤8 строк всплывают 12→0 + fade, задержка i×40мс,
                                                  ~300мс OutQuint). Строки видимы ПО УМОЛЧАНИЮ — анимация лишь
                                                  усиливает уже видимый покой (см. code-behind, §A.4).  -->
                                            <!--  ДОСТУПНОСТЬ (00-rules 12.2 «ничто не может быть доступно только мышью»,
                                                  7.1, 14.8): строка — таб-стоп. Раньше это был «голый» Border с одними
                                                  указательными обработчиками, поэтому ВСЕ семь действий строки (по
                                                  умолчанию / пинг / изменить / дублировать / QR / ссылка / удалить) жили
                                                  ТОЛЬКО в правом клике, а с клавиатуры не открывались вовсе. Focusable
                                                  + IsTabStop дают: (1) фокус-с-клавиатуры и уже готовое кольцо
                                                  FocusAdorner (GlobalStyles «Border.ServerRow» — фундамент лежал в
                                                  ожидании этого флага, как было с Border.AccountChip); (2) ContextMenu
                                                  по клавише «Меню» / Shift+F10 — Avalonia поднимает ContextRequested с
                                                  клавиатуры только на СФОКУСИРОВАННОМ контроле, а OnRowContextRequested
                                                  берёт цель из DataContext отправителя, поэтому клавиатурный путь ведёт
                                                  ровно к той же строке. Выбор сервера по Enter/Space остаётся за
                                                  code-behind (пара к WireRow в SettingsView.axaml.cs) — здесь разметка.  -->
                                            <Border
                                                MinHeight="52"
                                                Margin="16,2"
                                                Padding="12,6"
                                                Classes="ServerRow"
                                                Classes.selected="{Binding IsActive}"
                                                ContextRequested="OnRowContextRequested"
                                                CornerRadius="{StaticResource Radius.Search}"
                                                Focusable="True"
                                                IsTabStop="True"
                                                Loaded="OnServerRowLoaded"
                                                PointerCaptureLost="OnRowPointerCaptureLost"
                                                PointerExited="OnRowPointerExited"
                                                PointerPressed="OnRowPointerPressed"
                                                PointerReleased="OnRowPointerReleased">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Click="OnRowMakeDefault" Header="{loc:T Servers_MakeDefault}" />
                                                        <MenuItem Click="OnRowPing" Header="{loc:T Common_TestLatency}" />
                                                        <Separator />
                                                        <MenuItem Click="OnRowEdit" Header="{loc:T Common_Edit}" />
                                                        <MenuItem Click="OnRowDuplicate" Header="{loc:T Servers_Duplicate}" />
                                                        <Separator />
                                                        <MenuItem Click="OnRowShareQr" Header="{loc:T Servers_ShareQr}" />
                                                        <MenuItem Click="OnRowShareLink" Header="{loc:T Servers_ShareLink}" />
                                                        <Separator />
                                                        <MenuItem
                                                            Click="OnRowDelete"
                                                            Foreground="{DynamicResource Brush.Red}"
                                                            Header="{loc:T Common_Delete}" />
                                                    </ContextMenu>
                                                </Border.ContextMenu>

                                                <Grid VerticalAlignment="Center" ColumnDefinitions="Auto,*,Auto">

                                                    <!--  Flag: 40dp CIRCULAR tile (matches Android) — the country flag reads as a
                                                          clean disc, not a rounded square. The flag PNGs are already circular with
                                                          transparent corners, so a circular tile (radius = half = 20) removes the
                                                          square corners that used to poke out behind the disc. A 1.5px inset lets the
                                                          dark neutral tile show as a subtle ring around the flag (Android treatment).
                                                          RemarkToFlag resolves the country flag from Remarks; non-country / aggregate
                                                          rows fall back to the globe disc (xx.png) — a distinct, data-driven emblem.  -->
                                                    <Border
                                                        Grid.Column="0"
                                                        Width="40"
                                                        Height="40"
                                                        Margin="0,0,12,0"
                                                        Padding="1.5"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource Brush.Tile.Neutral}"
                                                        ClipToBounds="True"
                                                        CornerRadius="20">
                                                        <Image Source="{Binding Remarks, Converter={StaticResource RemarkToFlag}}" Stretch="UniformToFill" />
                                                    </Border>

                                                    <!--  Name (bold, ellipsize, flag stripped) + «protocol chip · transport».  -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock
                                                            Classes="Title"
                                                            Text="{Binding Remarks, Converter={StaticResource StripLeadingFlag}}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <StackPanel
                                                            Margin="0,2,0,0"
                                                            VerticalAlignment="Center"
                                                            Orientation="Horizontal">
                                                            <Border Classes="ProtocolChip">
                                                                <!--  BUG 2: center the glyph INSIDE the padded chip. Without this the chip
                                                                      text drew at the top of its stretched box, so «VLESS» sat higher than
                                                                      the vertically-centred «· TCP · REALITY» caption (mismatched baselines).
                                                                      Centred, the chip's optical middle matches the caption's → one line.  -->
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    Classes="Chip"
                                                                    Foreground="{DynamicResource Brush.Accent}"
                                                                    Text="{Binding Converter={StaticResource ConfigTypeToProtocol}}" />
                                                            </Border>
                                                            <TextBlock
                                                                Margin="8,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Classes="Caption"
                                                                Text="{Binding Converter={StaticResource ProfileTransport}}"
                                                                TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!--  Ping slot (tv_test_result): while a test is in flight show a compact
                                                          indeterminate spinner (NO «Testing…» text); when the result lands, show
                                                          the coloured ms value (green good / red bad). The two states are mutually
                                                          exclusive, share this Auto column, and are right-aligned on one vertical.  -->
                                                    <Panel Grid.Column="2" Margin="8,0,0,0">
                                                        <!--  In-flight: 15px arc spinner (reuses the global Ellipse.Spinner.spinning).  -->
                                                        <!--  Видимость дуги НЕ биндим напрямую: базово скрыта, а класс .spinning
                                                              (по DelayTesting) вместе с :is(Window):not(.lite) в UserControl.Styles
                                                              показывает её лишь во время теста И при включённом движении. Под lite
                                                              дуга схлопнута целиком (никакого замёрзшего полукольца).  -->
                                                        <Ellipse
                                                            Width="15"
                                                            Height="15"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            Classes="Spinner"
                                                            Classes.spinning="{Binding DelayVal, Converter={StaticResource DelayTesting}}"
                                                            Stroke="{DynamicResource Brush.Accent}"
                                                            StrokeDashArray="5.9,17.7"
                                                            StrokeLineCap="Round"
                                                            StrokeThickness="2">
                                                            <!--  Явный центр вращения (половина 15px = 7.5): глобальный
                                                                  Ellipse.Spinner.spinning крутит RotateTransform.Angle, а
                                                                  origin к этому пути не применяется — без CenterX/CenterY
                                                                  спиннер «облетал» по орбите вместо вращения на месте.  -->
                                                            <Ellipse.RenderTransform>
                                                                <RotateTransform
                                                                    Angle="0"
                                                                    CenterX="7.5"
                                                                    CenterY="7.5" />
                                                            </Ellipse.RenderTransform>
                                                        </Ellipse>
                                                        <!--  Result: right-aligned, tabular Grotesk digits, coloured by latency.  -->
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Classes="Numeric"
                                                            FontWeight="Bold"
                                                            Foreground="{Binding Delay, Converter={StaticResource DelayInk}}"
                                                            IsVisible="{Binding DelayVal, Converter={StaticResource DelayResult}}"
                                                            Text="{Binding DelayVal, Converter={StaticResource DelayDisplay}}"
                                                            TextAlignment="Right" />
                                                    </Panel>
                                                </Grid>
                                            </Border>

                                            <!--  Inter-row divider (single separator; hidden on the selected row).  -->
                                            <Border Classes="rowDivider" IsVisible="{Binding !IsActive}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

                <!--  Trailing spacer = the list's real bottom clearance (see the ScrollViewer note).
                      A concrete child height is always in the scroll Extent, so this lifts the LAST
                      server's full height clear of the bottom edge / nav with clean breathing room and
                      no magic padding constant. 0-hit-test so it never intercepts a row tap or scroll.  -->
                <Border
                    Height="24"
                    Background="Transparent"
                    Focusable="False"
                    IsHitTestVisible="False" />
            </StackPanel>
        </ScrollViewer>

        <!--  Empty state (layout_servers_empty): hero icon 64 + «Список пуст». The full onboarding
              CTAs live in the connect-hero (right panel of Home), so this stays quiet.  -->
        <StackPanel
            Margin="24,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsVisible="{Binding IsEmpty}"
            Spacing="14">
            <Border Classes="EmptyIcon">
                <PathIcon Data="{StaticResource Geo.CloudDownload}" />
            </Border>
            <TextBlock
                HorizontalAlignment="Center"
                Classes="Title"
                Text="{loc:T Servers_Empty}"
                TextAlignment="Center" />
            <TextBlock
                HorizontalAlignment="Center"
                Classes="Subtitle"
                MaxWidth="260"
                Text="{loc:T Servers_EmptyHint}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
