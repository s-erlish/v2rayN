<UserControl
    x:Class="v2rayN.Desktop.Views.DevicesView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vms="clr-namespace:v2rayN.Desktop.ViewModels"
    x:Name="Root"
    x:DataType="vms:DevicesViewModel"
    d:DesignWidth="560"
    d:DesignHeight="760"
    mc:Ignorable="d">

    <!--
        Экран «Устройства» (порт Android activity_devices.xml + item_device.xml,
        DeviceManagementActivity.kt / DeviceAdapter.kt). Язык — как на вкладке «Аккаунт»:
        seamless-тулбар «← Устройства» + счётчик, ОДНА карта со строками устройств, разделённые
        ОДНИМ inset-разделителем (без вложенных карт). Строка: плитка-платформа 40 (Windows /
        Android / iOS / роутер) · имя · «платформа · Активно: дата» · «ID: hwid» · «Отвязать» (Red).
        Текущее устройство подсвечено мягким акцентом + чип «Это устройство».

        Пять взаимоисключающих состояний: скелет / список / пусто / нет подписки / ошибка.
        Отвязка → in-view подтверждение (карта по центру на скриме) → POST delete → строка исчезает.

        DATA-DRIVEN: всё из GET /client/devices через DevicesViewModel; пусто до реального ответа.
        Incy: pure dark, один синий акцент (красный только у деструктива), Space Grotesk,
        токен-отступы/радиусы, sentence-case Russian, 0 elevation. Корень ПРОЗРАЧНЫЙ — под хостом
        страниц рисуется общий Incy-градиент, показываем его.
    -->

    <UserControl.Resources>
        <!--  Векторные глифы (порт Material/MDI, viewport 24×24).  -->
        <!--  Стрелка «назад» тулбара (Material arrow_back).  -->
        <StreamGeometry x:Key="Geo.Dev.Back">M20,11H7.83l5.59,-5.59L12,4l-8,8 8,8 1.41,-1.41L7.83,13H20v-2z</StreamGeometry>
        <!--  Универсальный «устройства» (ноутбук + телефон) — hero пустых состояний + fallback-платформа.  -->
        <StreamGeometry x:Key="Geo.Dev.Devices">M4,6h18V4H4c-1.1,0 -2,0.9 -2,2v11H0v3h14v-3H4V6zM23,8h-6c-0.55,0 -1,0.45 -1,1v10c0,0.55 0.45,1 1,1h6c0.55,0 1,-0.45 1,-1V9c0,-0.55 -0.45,-1 -1,-1zM22,18h-4v-8h4v8z</StreamGeometry>
        <!--  Корзина (ic_delete) — деструктив «Отвязать».  -->
        <StreamGeometry x:Key="Geo.Dev.Delete">M6,19c0,1.1 0.9,2 2,2h8c1.1,0 2,-0.9 2,-2V7H6v12zM19,4h-3.5l-1,-1h-5l-1,1H5v2h14V4z</StreamGeometry>
        <!--  Платформы.  -->
        <StreamGeometry x:Key="Geo.Dev.Android">M6,18c0,0.55 0.45,1 1,1h1v3.5c0,0.83 0.67,1.5 1.5,1.5s1.5,-0.67 1.5,-1.5V19h2v3.5c0,0.83 0.67,1.5 1.5,1.5s1.5,-0.67 1.5,-1.5V19h1c0.55,0 1,-0.45 1,-1V8H6V18zM3.5,8C2.67,8 2,8.67 2,9.5v7C2,17.33 2.67,18 3.5,18S5,17.33 5,16.5v-7C5,8.67 4.33,8 3.5,8zM20.5,8C19.67,8 19,8.67 19,9.5v7c0,0.83 0.67,1.5 1.5,1.5s1.5,-0.67 1.5,-1.5v-7C22,8.67 21.33,8 20.5,8zM15.53,2.16l1.3,-1.3c0.2,-0.2 0.2,-0.51 0,-0.71c-0.2,-0.2 -0.51,-0.2 -0.71,0l-1.48,1.48C13.85,1.23 12.95,1 12,1c-0.96,0 -1.86,0.23 -2.66,0.63L7.85,0.15c-0.2,-0.2 -0.51,-0.2 -0.71,0c-0.2,0.2 -0.2,0.51 0,0.71l1.31,1.31C6.97,3.26 6,5.01 6,7h12C18,5.01 17.03,3.25 15.53,2.16zM10,5H9V4h1V5zM15,5h-1V4h1V5z</StreamGeometry>
        <StreamGeometry x:Key="Geo.Dev.Apple">M17.05,20.28c-0.98,0.95 -2.05,0.8 -3.08,0.35c-1.09,-0.46 -2.09,-0.48 -3.24,0c-1.44,0.62 -2.2,0.44 -3.06,-0.35C2.79,15.25 3.51,7.59 9.05,7.31c1.35,0.07 2.29,0.74 3.08,0.8c1.18,-0.24 2.31,-0.93 3.57,-0.84c1.51,0.12 2.65,0.72 3.4,1.8c-3.12,1.87 -2.38,5.98 0.48,7.13c-0.57,1.5 -1.31,2.99 -2.54,4.09l0.01,-0.01zM12.03,7.25c-0.15,-2.23 1.66,-4.07 3.74,-4.25c0.29,2.58 -2.34,4.5 -3.74,4.25z</StreamGeometry>
        <StreamGeometry x:Key="Geo.Dev.Windows">M3,12V6.75L9,5.43V11.91L3,12M20,3V11.75L10,11.9V5.21L20,3M3,13L9,13.09V19.9L3,18.75V13M20,13.25V22L10,20.09V13.1L20,13.25Z</StreamGeometry>
        <StreamGeometry x:Key="Geo.Dev.Router">M20,13C21.11,13 22,13.89 22,15V19C22,20.11 21.11,21 20,21H4C2.89,21 2,20.11 2,19V15C2,13.89 2.89,13 4,13H20M20,15H4V19H20V15M6,16V18H8V16H6M11,16V18H13V16H11M15.5,16A1.5,1.5 0 0,0 14,17.5A1.5,1.5 0 0,0 15.5,19A1.5,1.5 0 0,0 17,17.5A1.5,1.5 0 0,0 15.5,16M11.72,10.28L10.3,11.7C11.11,12.5 11.11,13.5 10.3,14.29L11.72,15.71C13.42,14 13.42,12 11.72,10.28M14.55,7.44L13.13,8.86C15.31,11.04 15.31,14.28 13.13,16.46L14.55,17.88C17.5,14.93 17.5,10.61 14.55,7.44Z</StreamGeometry>
    </UserControl.Resources>

    <UserControl.Styles>
        <!--  Иконочные кнопки экрана: press scale 0.92 (§0.1), без ripple/glow.  -->
        <Style Selector="Button.IconButton">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.09" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.IconButton:pressed">
            <Setter Property="RenderTransform" Value="scale(0.92)" />
        </Style>

        <!--  Скелет: полоса-плейсхолдер + пульс alpha 0.45→1.0 (копия языка AccountView).  -->
        <Style Selector="Border.SkelBar">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHighest}" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Chip}" />
            <Setter Property="Height" Value="16" />
        </Style>
        <Style Selector="Border.Skeleton">
            <Style.Animations>
                <Animation
                    Duration="0:0:0.9"
                    Easing="SineEaseInOut"
                    IterationCount="Infinite"
                    PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.45" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1.0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!--  Деструктивная кнопка «Отвязать»: метрики Button.Primary, но фон Red #F04452 и белый текст.
              Фон закреплён на template-ContentPresenter, чтобы hover темы Semi его не подменял.  -->
        <Style Selector="Button.Destructive">
            <Setter Property="Background" Value="{DynamicResource Brush.Red}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Button}" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="24,0" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.Grotesk}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.09" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.Destructive /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.Red}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.Destructive:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#D93844" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.Destructive:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#D93844" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.Destructive:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)" />
        </Style>
        <Style Selector="Button.Destructive:disabled">
            <Setter Property="Opacity" Value="0.38" />
        </Style>

        <!--  Вход модалки: скрим fade 150мс, карта scale 0.96 → 1 + fade 220мс (Ease.Standard).  -->
        <Style Selector="Border.Scrim[IsVisible=True]">
            <Style.Animations>
                <Animation Duration="0:0:0.15" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.Scrim[IsVisible=True] Border.ModalCard">
            <Style.Animations>
                <Animation Duration="0:0:0.22" FillMode="Forward">
                    <Animation.Easing>
                        <SplineEasing
                            X1="0.2"
                            Y1="0"
                            X2="0"
                            Y2="1" />
                    </Animation.Easing>
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0.96" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0.96" />
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <!--  Прозрачный корень: показываем общий Incy-градиент, нарисованный под хостом страниц.  -->
    <Panel Background="Transparent">

        <!--  Центрированная колонка ~560 — как на вкладке «Аккаунт».  -->
        <DockPanel MaxWidth="560">

            <!--  ============ Seamless-тулбар: «← Устройства»  +  счётчик ============  -->
            <Grid
                DockPanel.Dock="Top"
                MinHeight="56"
                Margin="16,8,16,0"
                ColumnDefinitions="Auto,*,Auto">
                <Button
                    Grid.Column="0"
                    Width="40"
                    Height="40"
                    Padding="0"
                    VerticalAlignment="Center"
                    Classes="IconButton"
                    Click="OnBackClick"
                    ToolTip.Tip="Назад">
                    <PathIcon
                        Width="22"
                        Height="22"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="{StaticResource Geo.Dev.Back}"
                        Foreground="{DynamicResource Brush.OnSurface}" />
                </Button>
                <TextBlock
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Classes="Headline"
                    Text="Устройства"
                    TextTrimming="CharacterEllipsis" />
                <!--  Счётчик устройств: тихая пилюля, только когда список на экране.  -->
                <Border
                    Grid.Column="2"
                    Margin="12,0,0,0"
                    Padding="10,4"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Brush.SurfaceHigh}"
                    CornerRadius="{StaticResource Radius.Chip}"
                    IsVisible="{Binding HasCount}">
                    <TextBlock
                        Classes="Chip"
                        FontFeatures="tnum"
                        Foreground="{DynamicResource Brush.OnSurfaceVariant}"
                        Text="{Binding CountText}" />
                </Border>
            </Grid>

            <!--  Подзаголовок списка (скрыт под пустым/no-sub/ошибочным состоянием, как в Android).  -->
            <TextBlock
                DockPanel.Dock="Top"
                Margin="16,16,16,0"
                Classes="Subtitle"
                IsVisible="{Binding ShowSubtitle}"
                Text="Устройства, подключённые к вашей подписке"
                TextWrapping="Wrap" />

            <!--  ============ Контент: 5 взаимоисключающих слотов ============  -->
            <Panel>

                <!--  Состояние СПИСОК: ОДНА карта, строки с ОДНИМ inset-разделителем.  -->
                <ScrollViewer
                    HorizontalScrollBarVisibility="Disabled"
                    IsVisible="{Binding ShowList}"
                    VerticalScrollBarVisibility="Auto">
                    <Border
                        Margin="16,12,16,16"
                        Padding="0"
                        Classes="Card"
                        ClipToBounds="True">
                        <ItemsControl ItemsSource="{Binding Devices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vms:DeviceRow">
                                    <StackPanel>
                                        <!--  ОДИН inset-разделитель между строками (не над первой).  -->
                                        <Border
                                            Height="1"
                                            Margin="68,0,0,0"
                                            Background="{DynamicResource Brush.OutlineVariant}"
                                            IsVisible="{Binding ShowDivider}" />

                                        <Panel>
                                            <!--  Мягкая акцентная подложка текущего устройства.  -->
                                            <Border
                                                Background="{DynamicResource Brush.Tile.Blue}"
                                                IsVisible="{Binding IsCurrent}" />

                                            <Grid
                                                Margin="16,10"
                                                MinHeight="56"
                                                ColumnDefinitions="Auto,*,Auto">
                                                <!--  Плитка-платформа 40, глиф 22 Accent (ровно один виден).  -->
                                                <Border
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    Classes="Tile Blue">
                                                    <Panel>
                                                        <PathIcon
                                                            Width="22"
                                                            Height="22"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Data="{StaticResource Geo.Dev.Android}"
                                                            Foreground="{DynamicResource Brush.Accent}"
                                                            IsVisible="{Binding IsAndroid}" />
                                                        <PathIcon
                                                            Width="22"
                                                            Height="22"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Data="{StaticResource Geo.Dev.Apple}"
                                                            Foreground="{DynamicResource Brush.Accent}"
                                                            IsVisible="{Binding IsApple}" />
                                                        <PathIcon
                                                            Width="22"
                                                            Height="22"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Data="{StaticResource Geo.Dev.Windows}"
                                                            Foreground="{DynamicResource Brush.Accent}"
                                                            IsVisible="{Binding IsWindows}" />
                                                        <PathIcon
                                                            Width="22"
                                                            Height="22"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Data="{StaticResource Geo.Dev.Router}"
                                                            Foreground="{DynamicResource Brush.Accent}"
                                                            IsVisible="{Binding IsRouter}" />
                                                        <PathIcon
                                                            Width="22"
                                                            Height="22"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Data="{StaticResource Geo.Dev.Devices}"
                                                            Foreground="{DynamicResource Brush.Accent}"
                                                            IsVisible="{Binding IsGenericPlatform}" />
                                                    </Panel>
                                                </Border>

                                                <!--  Имя (+ чип «Это устройство») · мета · ID.  -->
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Center">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            VerticalAlignment="Center"
                                                            Classes="Title"
                                                            Text="{Binding Name}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <Border
                                                            Grid.Column="1"
                                                            Margin="8,0,0,0"
                                                            Padding="8,3"
                                                            VerticalAlignment="Center"
                                                            Background="{DynamicResource Brush.Tile.Blue}"
                                                            CornerRadius="{StaticResource Radius.Chip}"
                                                            IsVisible="{Binding IsCurrent}">
                                                            <TextBlock
                                                                Classes="Chip"
                                                                Foreground="{DynamicResource Brush.Accent}"
                                                                Text="Это устройство" />
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock
                                                        Margin="0,3,0,0"
                                                        Classes="Subtitle"
                                                        FontFeatures="tnum"
                                                        IsVisible="{Binding HasMeta}"
                                                        Text="{Binding Meta}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Margin="0,3,0,0"
                                                        Classes="Caption"
                                                        FontFeatures="tnum"
                                                        IsVisible="{Binding HasHwid}"
                                                        Text="{Binding HwidText}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <!--  «Отвязать» 40, глиф 22 Red — деструктив.  -->
                                                <Button
                                                    Grid.Column="2"
                                                    Width="40"
                                                    Height="40"
                                                    Margin="8,0,0,0"
                                                    Padding="0"
                                                    VerticalAlignment="Center"
                                                    Classes="IconButton"
                                                    Command="{Binding DataContext.DeleteCmd, ElementName=Root}"
                                                    CommandParameter="{Binding Dto}"
                                                    ToolTip.Tip="Отвязать устройство">
                                                    <PathIcon
                                                        Width="22"
                                                        Height="22"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Data="{StaticResource Geo.Dev.Delete}"
                                                        Foreground="{DynamicResource Brush.Red}" />
                                                </Button>
                                            </Grid>
                                        </Panel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </ScrollViewer>

                <!--  Состояние СКЕЛЕТ: одна карта с 3 пульсирующими строками той же геометрии.  -->
                <Border
                    Margin="16,12,16,16"
                    Padding="0"
                    VerticalAlignment="Top"
                    Classes="Card Skeleton"
                    ClipToBounds="True"
                    IsVisible="{Binding ShowLoading}">
                    <Border.Styles>
                        <Style Selector="Border.SkelTile">
                            <Setter Property="Width" Value="40" />
                            <Setter Property="Height" Value="40" />
                            <Setter Property="CornerRadius" Value="{StaticResource Radius.Tile}" />
                            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHighest}" />
                        </Style>
                        <Style Selector="Grid.SkelRow">
                            <Setter Property="Margin" Value="16,10" />
                            <Setter Property="MinHeight" Value="56" />
                        </Style>
                    </Border.Styles>
                    <StackPanel>
                        <Grid Classes="SkelRow" ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" VerticalAlignment="Center" Classes="SkelTile" />
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <Border Classes="SkelBar" Width="150" HorizontalAlignment="Left" />
                                <Border Classes="SkelBar" Width="200" Height="12" Margin="0,8,0,0" HorizontalAlignment="Left" />
                                <Border Classes="SkelBar" Width="240" Height="12" Margin="0,8,0,0" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Margin="68,0,0,0" Background="{DynamicResource Brush.OutlineVariant}" />
                        <Grid Classes="SkelRow" ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" VerticalAlignment="Center" Classes="SkelTile" />
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <Border Classes="SkelBar" Width="120" HorizontalAlignment="Left" />
                                <Border Classes="SkelBar" Width="180" Height="12" Margin="0,8,0,0" HorizontalAlignment="Left" />
                                <Border Classes="SkelBar" Width="220" Height="12" Margin="0,8,0,0" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Margin="68,0,0,0" Background="{DynamicResource Brush.OutlineVariant}" />
                        <Grid Classes="SkelRow" ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" VerticalAlignment="Center" Classes="SkelTile" />
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <Border Classes="SkelBar" Width="140" HorizontalAlignment="Left" />
                                <Border Classes="SkelBar" Width="190" Height="12" Margin="0,8,0,0" HorizontalAlignment="Left" />
                                <Border Classes="SkelBar" Width="230" Height="12" Margin="0,8,0,0" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  Состояние ПУСТО: hero-плитка 64 blue + заголовок + подсказка (по центру).  -->
                <StackPanel
                    Margin="32,16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding ShowEmpty}">
                    <Border
                        Width="64"
                        Height="64"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource Brush.Tile.Blue}"
                        CornerRadius="{StaticResource Radius.Tile}">
                        <PathIcon
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="{StaticResource Geo.Dev.Devices}"
                            Foreground="{DynamicResource Brush.Accent}" />
                    </Border>
                    <TextBlock
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        Classes="Title"
                        Text="Нет подключённых устройств"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,8,0,0"
                        MaxWidth="340"
                        HorizontalAlignment="Center"
                        Classes="Subtitle"
                        Text="Устройства появятся здесь после первого подключения к VPN."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!--  Состояние НЕТ ПОДПИСКИ: hero + заголовок + подсказка + CTA в «Аккаунт» (где покупка/вход).  -->
                <StackPanel
                    Margin="32,16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding ShowNoSub}">
                    <Border
                        Width="64"
                        Height="64"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource Brush.Tile.Blue}"
                        CornerRadius="{StaticResource Radius.Tile}">
                        <PathIcon
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="{StaticResource Geo.Dev.Devices}"
                            Foreground="{DynamicResource Brush.Accent}" />
                    </Border>
                    <TextBlock
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        Classes="Title"
                        Text="Активная подписка не найдена"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,8,0,0"
                        MaxWidth="340"
                        HorizontalAlignment="Center"
                        Classes="Subtitle"
                        Text="Оформите подписку в разделе «Аккаунт», чтобы подключать устройства."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Button
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        Classes="Primary"
                        Click="OnBackClick"
                        Content="Перейти в аккаунт" />
                </StackPanel>

                <!--  Состояние ОШИБКА: hero + реальная причина + «Повторить».  -->
                <StackPanel
                    Margin="32,16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding ShowError}">
                    <Border
                        Width="64"
                        Height="64"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource Brush.Tile.Blue}"
                        CornerRadius="{StaticResource Radius.Tile}">
                        <PathIcon
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="{StaticResource Geo.Dev.Devices}"
                            Foreground="{DynamicResource Brush.Accent}" />
                    </Border>
                    <TextBlock
                        Margin="0,16,0,0"
                        MaxWidth="340"
                        HorizontalAlignment="Center"
                        Classes="Title"
                        Text="{Binding ErrorText}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Button
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        Classes="Tonal"
                        Command="{Binding LoadCmd}"
                        Content="Повторить" />
                </StackPanel>
            </Panel>
        </DockPanel>

        <!--  ============ Подтверждение отвязки: карта по центру на скриме ============
              Клик по скриму/Escape → отмена (код-behind); кнопки заблокированы во время запроса.  -->
        <Border
            x:Name="DeleteScrim"
            Background="#80000000"
            Classes="Scrim"
            IsVisible="{Binding ShowDeleteConfirm}"
            PointerPressed="OnScrimPressed">
            <Border
                MinWidth="320"
                MaxWidth="360"
                Margin="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Classes="Card ModalCard">
                <StackPanel>
                    <TextBlock Classes="Title" Text="Отвязать устройство?" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Classes="Body"
                        Foreground="{DynamicResource Brush.OnSurfaceVariant}"
                        Text="{Binding DeleteConfirmText}"
                        TextWrapping="Wrap" />
                    <Grid Margin="0,16,0,0" ColumnDefinitions="*,12,*">
                        <Button
                            x:Name="DeleteCancelButton"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            Classes="Tonal"
                            Command="{Binding CancelDeleteCmd}"
                            Content="Отмена"
                            IsEnabled="{Binding !IsDeleting}" />
                        <Button
                            Grid.Column="2"
                            HorizontalAlignment="Stretch"
                            Classes="Destructive"
                            Command="{Binding ConfirmDeleteCmd}"
                            Content="Отвязать" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Panel>
</UserControl>
