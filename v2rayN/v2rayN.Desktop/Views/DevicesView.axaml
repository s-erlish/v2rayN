<UserControl
    x:Class="v2rayN.Desktop.Views.DevicesView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vms="clr-namespace:v2rayN.Desktop.ViewModels"
    x:Name="Root"
    x:DataType="vms:DevicesViewModel"
    d:DesignWidth="560"
    d:DesignHeight="760"
    mc:Ignorable="d">

    <!--
        Экран «Устройства» (порт Android activity_devices.xml + item_device.xml,
        DeviceManagementActivity.kt / DeviceAdapter.kt). Seamless-тулбар «← Устройства»,
        подзаголовок, список карточек устройств (тайл blue 40 · имя/мета/ID · корзина Red),
        пять взаимоисключающих состояний: скелет / список / пусто / нет подписки / ошибка.
        Удаление → in-view подтверждение (карта по центру на 50% скриме) → POST delete →
        строка исчезает + снек «Устройство удалено».

        DATA-DRIVEN: всё из GET /client/devices через DevicesViewModel; пусто до реального ответа.
        Incy: pure dark, один синий акцент (красный только у деструктива), Space Grotesk,
        токен-отступы/радиусы, sentence-case Russian, 0 elevation, без вложенных карт.
    -->

    <UserControl.Resources>
        <!--  Векторные глифы (порт Android drawable, viewport 24×24).  -->
        <!--  Стрелка «назад» тулбара (Material arrow_back, как на android_devices.jpg).  -->
        <StreamGeometry x:Key="Geo.Dev.Back">M20,11H7.83l5.59,-5.59L12,4l-8,8 8,8 1.41,-1.41L7.83,13H20v-2z</StreamGeometry>
        <!--  ic_acc_devices — ноутбук + телефон.  -->
        <StreamGeometry x:Key="Geo.Dev.Devices">M4,6h18V4H4c-1.1,0 -2,0.9 -2,2v11H0v3h14v-3H4V6zM23,8h-6c-0.55,0 -1,0.45 -1,1v10c0,0.55 0.45,1 1,1h6c0.55,0 1,-0.45 1,-1V9c0,-0.55 -0.45,-1 -1,-1zM22,18h-4v-8h4v8z</StreamGeometry>
        <!--  ic_delete_24dp — корзина с крестом.  -->
        <StreamGeometry x:Key="Geo.Dev.Delete">M6,19c0,1.1 0.9,2 2,2h8c1.1,0 2,-0.9 2,-2L18,7L6,7v12zM8.46,11.88l1.41,-1.41L12,12.59l2.12,-2.12 1.41,1.41L13.41,14l2.12,2.12 -1.41,1.41L12,15.41l-2.12,2.12 -1.41,-1.41L10.59,14l-2.13,-2.12zM15.5,4l-1,-1h-5l-1,1L5,4v2h14L19,4z</StreamGeometry>
    </UserControl.Resources>

    <UserControl.Styles>
        <!--  Иконочные кнопки этого экрана: press scale 0.92 (§0.1), без ripple/glow.
              [Кандидат в GlobalStyles: у глобального Button.IconButton press-скейла ещё нет.]  -->
        <Style Selector="Button.IconButton">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.09" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.IconButton:pressed">
            <Setter Property="RenderTransform" Value="scale(0.92)" />
        </Style>

        <!--  Карточка устройства: press scale 0.96 (Android press_scale), класс .pressed
              вешает код-behind по PointerPressed (как Border.ServerRow).  -->
        <Style Selector="Border.DeviceCard">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.DeviceCard.pressed">
            <Setter Property="RenderTransform" Value="scale(0.96)" />
        </Style>

        <!--  Скелет (копия локальных стилей AccountView — кандидат на промоушен в GlobalStyles).
              Полоса-плейсхолдер: нейтральная поверхность, скруглённая.  -->
        <Style Selector="Border.SkelBar">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHighest}" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Chip}" />
            <Setter Property="Height" Value="16" />
        </Style>
        <!--  Пульс скелета: alpha 0.45 → 1.0, 900мс, реверс, бесконечно.  -->
        <Style Selector="Border.Skeleton">
            <Style.Animations>
                <Animation
                    Duration="0:0:0.9"
                    Easing="SineEaseInOut"
                    IterationCount="Infinite"
                    PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.45" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1.0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!--  Деструктивная кнопка: метрики Button.Primary (48h, Radius.Button 16, Grotesk 15 Bold,
              press 0.97, disabled 0.38), но фон Red #F04452 и белый текст (bold 15 ≥ 3:1).
              Фон закреплён и на template-ContentPresenter, чтобы hover темы Semi его не подменял.
              [Кандидат в GlobalStyles как единый деструктив приложения.]  -->
        <Style Selector="Button.Destructive">
            <Setter Property="Background" Value="{DynamicResource Brush.Red}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Button}" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="24,0" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.Grotesk}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.09" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.Destructive /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.Red}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.Destructive:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#D93844" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.Destructive:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#D93844" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.Destructive:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)" />
        </Style>
        <Style Selector="Button.Destructive:disabled">
            <Setter Property="Opacity" Value="0.38" />
        </Style>

        <!--  Вход модалки: скрим fade 150мс, карта scale 0.96 → 1 + fade 220мс (Ease.Standard).  -->
        <Style Selector="Border.Scrim[IsVisible=True]">
            <Style.Animations>
                <Animation Duration="0:0:0.15" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.Scrim[IsVisible=True] Border.ModalCard">
            <Style.Animations>
                <Animation Duration="0:0:0.22" FillMode="Forward">
                    <!--  Ease.Standard (0.2,0,0,1) — инлайн, чтобы не зависеть от скоупа стиля.  -->
                    <Animation.Easing>
                        <SplineEasing
                            X1="0.2"
                            Y1="0"
                            X2="0"
                            Y2="1" />
                    </Animation.Easing>
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0.96" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0.96" />
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Panel Background="{DynamicResource Brush.Bg}">

        <!--  Центрированная колонка ~560 — как на вкладке «Аккаунт».  -->
        <DockPanel MaxWidth="560">

            <!--  ============ Seamless-тулбар: «← Устройства» ============  -->
            <Grid
                DockPanel.Dock="Top"
                MinHeight="56"
                Margin="16,8,16,0"
                ColumnDefinitions="Auto,*">
                <Button
                    Grid.Column="0"
                    Width="40"
                    Height="40"
                    Padding="0"
                    VerticalAlignment="Center"
                    Classes="IconButton"
                    Click="OnBackClick"
                    ToolTip.Tip="Назад">
                    <PathIcon
                        Width="22"
                        Height="22"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="{StaticResource Geo.Dev.Back}"
                        Foreground="{DynamicResource Brush.OnSurface}" />
                </Button>
                <TextBlock
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Classes="Headline"
                    Text="Устройства"
                    TextTrimming="CharacterEllipsis" />
            </Grid>

            <!--  Подзаголовок списка (скрыт под пустым/ошибочным состоянием, как в Android).  -->
            <TextBlock
                DockPanel.Dock="Top"
                Margin="16,16,16,0"
                Classes="Subtitle"
                IsVisible="{Binding ShowSubtitle}"
                Text="Устройства, подключённые к вашей подписке"
                TextWrapping="Wrap" />

            <!--  ============ Контент: 5 взаимоисключающих слотов ============  -->
            <Panel>

                <!--  Состояние СПИСОК.  -->
                <ScrollViewer
                    HorizontalScrollBarVisibility="Disabled"
                    IsVisible="{Binding ShowList}"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl Margin="16,12,16,16" ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vms:DeviceRow">
                                <!--  Карточка устройства (item_device.xml): Card 20 + press 0.96.  -->
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="12"
                                    Classes="Card DeviceCard"
                                    PointerCaptureLost="OnCardCaptureLost"
                                    PointerExited="OnCardExited"
                                    PointerPressed="OnCardPressed"
                                    PointerReleased="OnCardReleased">
                                    <Grid MinHeight="56" ColumnDefinitions="Auto,*,Auto">
                                        <!--  Тайл blue 40, глиф devices 22 Accent.  -->
                                        <Border
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Classes="Tile Blue">
                                            <PathIcon
                                                Width="22"
                                                Height="22"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Data="{StaticResource Geo.Dev.Devices}"
                                                Foreground="{DynamicResource Brush.Accent}" />
                                        </Border>

                                        <!--  Имя · «platform · Активно: дата» · «ID: hwid».  -->
                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                Classes="Title"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                Classes="Subtitle"
                                                FontFeatures="tnum"
                                                IsVisible="{Binding HasMeta}"
                                                Text="{Binding Meta}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                Classes="Caption"
                                                FontFeatures="tnum"
                                                IsVisible="{Binding HasHwid}"
                                                Text="{Binding HwidText}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!--  Корзина 40, глиф 22 Red — деструктив.  -->
                                        <Button
                                            Grid.Column="2"
                                            Width="40"
                                            Height="40"
                                            Margin="8,0,0,0"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            Classes="IconButton"
                                            Command="{Binding #Root.((vms:DevicesViewModel)DataContext).DeleteCmd}"
                                            CommandParameter="{Binding Dto}"
                                            ToolTip.Tip="Удалить устройство">
                                            <PathIcon
                                                Width="22"
                                                Height="22"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Data="{StaticResource Geo.Dev.Delete}"
                                                Foreground="{DynamicResource Brush.Red}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!--  Состояние СКЕЛЕТ: 3 пульсирующие карточки той же геометрии.  -->
                <StackPanel
                    Margin="16,12,16,16"
                    VerticalAlignment="Top"
                    IsVisible="{Binding ShowLoading}">
                    <StackPanel.Styles>
                        <!--  Разметка одной скелет-карточки задаётся здесь один раз.  -->
                        <Style Selector="Border.SkelTile">
                            <Setter Property="Width" Value="40" />
                            <Setter Property="Height" Value="40" />
                            <Setter Property="CornerRadius" Value="{StaticResource Radius.Tile}" />
                            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHighest}" />
                        </Style>
                    </StackPanel.Styles>

                    <Border
                        Margin="0,0,0,8"
                        Padding="12"
                        Classes="Card Skeleton">
                        <Grid MinHeight="56" ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" VerticalAlignment="Center" Classes="SkelTile" />
                            <StackPanel
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                                <Border
                                    Classes="SkelBar"
                                    Width="140"
                                    HorizontalAlignment="Left" />
                                <Border
                                    Classes="SkelBar"
                                    Width="200"
                                    Height="12"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Left" />
                                <Border
                                    Classes="SkelBar"
                                    Width="240"
                                    Height="12"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Left" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border
                        Margin="0,0,0,8"
                        Padding="12"
                        Classes="Card Skeleton">
                        <Grid MinHeight="56" ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" VerticalAlignment="Center" Classes="SkelTile" />
                            <StackPanel
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                                <Border
                                    Classes="SkelBar"
                                    Width="120"
                                    HorizontalAlignment="Left" />
                                <Border
                                    Classes="SkelBar"
                                    Width="180"
                                    Height="12"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Left" />
                                <Border
                                    Classes="SkelBar"
                                    Width="220"
                                    Height="12"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Left" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border
                        Margin="0,0,0,8"
                        Padding="12"
                        Classes="Card Skeleton">
                        <Grid MinHeight="56" ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" VerticalAlignment="Center" Classes="SkelTile" />
                            <StackPanel
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                                <Border
                                    Classes="SkelBar"
                                    Width="150"
                                    HorizontalAlignment="Left" />
                                <Border
                                    Classes="SkelBar"
                                    Width="190"
                                    Height="12"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Left" />
                                <Border
                                    Classes="SkelBar"
                                    Width="230"
                                    Height="12"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Left" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!--  Состояние ПУСТО: hero-иконка 64 blue + заголовок + подсказка (по центру).  -->
                <StackPanel
                    Margin="32,16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding ShowEmpty}">
                    <Border
                        Width="64"
                        Height="64"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource Brush.Tile.Blue}"
                        CornerRadius="{StaticResource Radius.Tile}">
                        <PathIcon
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="{StaticResource Geo.Dev.Devices}"
                            Foreground="{DynamicResource Brush.Accent}" />
                    </Border>
                    <TextBlock
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        Classes="Title"
                        Text="Нет подключённых устройств"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,8,0,0"
                        MaxWidth="340"
                        HorizontalAlignment="Center"
                        Classes="Subtitle"
                        Text="Устройства появятся здесь после первого подключения к VPN."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!--  Состояние НЕТ ПОДПИСКИ (android_devices_no_sub.jpg): hero + заголовок.  -->
                <StackPanel
                    Margin="32,16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding ShowNoSub}">
                    <Border
                        Width="64"
                        Height="64"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource Brush.Tile.Blue}"
                        CornerRadius="{StaticResource Radius.Tile}">
                        <PathIcon
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="{StaticResource Geo.Dev.Devices}"
                            Foreground="{DynamicResource Brush.Accent}" />
                    </Border>
                    <TextBlock
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        Classes="Title"
                        Text="Активная подписка не найдена"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!--  Состояние ОШИБКА: hero + реальная причина + «Повторить».  -->
                <StackPanel
                    Margin="32,16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding ShowError}">
                    <Border
                        Width="64"
                        Height="64"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource Brush.Tile.Blue}"
                        CornerRadius="{StaticResource Radius.Tile}">
                        <PathIcon
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="{StaticResource Geo.Dev.Devices}"
                            Foreground="{DynamicResource Brush.Accent}" />
                    </Border>
                    <TextBlock
                        Margin="0,16,0,0"
                        MaxWidth="340"
                        HorizontalAlignment="Center"
                        Classes="Title"
                        Text="{Binding ErrorText}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Button
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        Classes="Tonal"
                        Command="{Binding LoadCmd}"
                        Content="Повторить" />
                </StackPanel>
            </Panel>
        </DockPanel>

        <!--  ============ Подтверждение удаления: карта по центру на 50% скриме ============
              Клик по скриму/Escape → отмена (код-behind); кнопки заблокированы во время запроса.  -->
        <Border
            x:Name="DeleteScrim"
            Background="#80000000"
            Classes="Scrim"
            IsVisible="{Binding ShowDeleteConfirm}"
            PointerPressed="OnScrimPressed">
            <Border
                MinWidth="320"
                MaxWidth="360"
                Margin="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Classes="Card ModalCard">
                <StackPanel>
                    <TextBlock Classes="Title" Text="Удалить устройство?" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Classes="Body"
                        Text="{Binding DeleteConfirmText}"
                        TextWrapping="Wrap" />
                    <Grid Margin="0,16,0,0" ColumnDefinitions="*,12,*">
                        <Button
                            x:Name="DeleteCancelButton"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            Classes="Tonal"
                            Command="{Binding CancelDeleteCmd}"
                            Content="Отмена"
                            IsEnabled="{Binding !IsDeleting}" />
                        <Button
                            Grid.Column="2"
                            HorizontalAlignment="Stretch"
                            Classes="Destructive"
                            Command="{Binding ConfirmDeleteCmd}"
                            Content="Удалить" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Panel>
</UserControl>
