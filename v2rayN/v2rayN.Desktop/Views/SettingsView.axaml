<UserControl
    x:Class="v2rayN.Desktop.Views.SettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vms="clr-namespace:v2rayN.Desktop.ViewModels"
    x:DataType="vms:SettingsViewModel"
    Design.DataContext="{x:Static vms:SettingsViewModel.Design}"
    mc:Ignorable="d">

    <!--
        Настройки (вкладка «Настройки») — 1:1 порт Android layout_settings_content.xml.
        Секции-карточки со строками/тумблерами. Тёмная Incy, один синий акцент.
        Данные: значения/тумблеры имеют x:Name для последующего биндинга к ServiceLib
        (сейчас — design-time дефолты, соответствующие android_settings.jpg).
    -->

    <UserControl.Resources>
        <!--  Векторные глифы 22 (порт Android res/drawable ic_*). Масштабируются PathIcon.  -->
        <!--  Щит-контур (ic_shield_outline) — F0 = evenOdd, чтобы получить обводку.  -->
        <StreamGeometry x:Key="Geo.Set.Shield">F0 M12,2.2 L19.6,5.2 L19.6,11.4 C19.6,16.1 15.9,19.9 12,21.8 C8.1,19.9 4.4,16.1 4.4,11.4 L4.4,5.2 Z M12,4.7 L17.2,6.8 L17.2,11.4 C17.2,14.9 14.7,17.9 12,19.3 C9.3,17.9 6.8,14.9 6.8,11.4 L6.8,6.8 Z</StreamGeometry>
        <!--  Сетка приложений (ic_per_apps_24dp)  -->
        <StreamGeometry x:Key="Geo.Set.Grid">M4,8h4L8,4L4,4v4zM10,20h4v-4h-4v4zM4,20h4v-4L4,16v4zM4,14h4v-4L4,10v4zM10,14h4v-4h-4v4zM16,4v4h4L20,4h-4zM10,8h4L14,4h-4v4zM16,14h4v-4h-4v4zM16,20h4v-4h-4v4z</StreamGeometry>
        <!--  Глобус (ic_globe_24dp)  -->
        <StreamGeometry x:Key="Geo.Set.Globe">M12,2C6.48,2 2,6.48 2,12s4.48,10 10,10 10,-4.48 10,-10S17.52,2 12,2zM11,19.93c-3.95,-0.49 -7,-3.85 -7,-7.93 0,-0.62 0.08,-1.21 0.21,-1.79L9,15v1c0,1.1 0.9,2 2,2v1.93zM17.9,17.39c-0.26,-0.81 -1,-1.39 -1.9,-1.39h-1v-3c0,-0.55 -0.45,-1 -1,-1H8v-2h2c0.55,0 1,-0.45 1,-1V7h2c1.1,0 2,-0.9 2,-2v-0.41c2.93,1.19 5,4.06 5,7.41 0,2.08 -0.8,3.97 -2.1,5.39z</StreamGeometry>
        <!--  Щит-персона (ic_privacy_24dp, viewport 1024)  -->
        <StreamGeometry x:Key="Geo.Set.Privacy">M471.5,77.5a128,128 0,0 1,72.1 -2.6l8.9,2.6 256,85.3a128,128 0,0 1,87.3 113.6l0.3,7.8L896,512c0,101.6 -44.5,186 -103.2,253.1l-8.1,9 -12.1,12.8a618.2,618.2 0,0 1,-25 24.2l-12.8,11.4 -13,11a839.3,839.3 0,0 1,-127.7 86.5l-19.5,10.5 -17.5,9a101.4,101.4 0,0 1,-90.5 0l-18.9,-9.6c-40.1,-21.1 -93.9,-53.2 -145.9,-96.3l-12.9,-11 -12.8,-11.4a618.2,618.2 0,0 1,-24.9 -24.2l-12.1,-12.8 -8.1,-9c-55.9,-63.9 -98.9,-143.4 -102.9,-238.6L128,512L128,284.2A128,128 0,0 1,208.2 165.5l7.3,-2.7 256,-85.3zM512,661.3c-80.2,0 -151.1,40.3 -193.4,101.7 62,57.2 132.2,97.2 176.6,119a37.4,37.4 0,0 0,33.7 0c44.4,-21.9 114.6,-61.9 176.6,-119A234.4,234.4 0,0 0,512 661.3zM491.8,138.2l-256,85.3A64,64 0,0 0,192 284.2L192,512c0,78.5 32.9,146.4 81.5,204.2A298.2,298.2 0,0 1,512 597.3a298.2,298.2 0,0 1,238.5 118.8C799.1,658.4 832,590.5 832,512L832,284.2a64,64 0,0 0,-43.8 -60.7l-256,-85.3a64,64 0,0 0,-40.4 0zM512,298.7a128,128 0,1 1,0 256,128 128,0 0,1 0,-256zM512,362.7a64,64 0,1 0,0 128,64 64,0 0,0 0,-128z</StreamGeometry>
        <!--  Пинг / радар (ic_ping_24dp)  -->
        <StreamGeometry x:Key="Geo.Set.Ping">M12,11c-1.1,0 -2,0.9 -2,2s0.9,2 2,2 2,-0.9 2,-2 -0.9,-2 -2,-2zM18,13c0,-3.31 -2.69,-6 -6,-6s-6,2.69 -6,6c0,2.22 1.21,4.15 3,5.19l1,-1.74c-1.19,-0.7 -2,-1.97 -2,-3.45 0,-2.21 1.79,-4 4,-4s4,1.79 4,4c0,1.48 -0.81,2.75 -2,3.45l1,1.74c1.79,-1.04 3,-2.97 3,-5.19zM12,3C6.48,3 2,7.48 2,13c0,3.7 2.01,6.92 4.99,8.65l1,-1.73C5.61,18.53 4,15.96 4,13c0,-4.42 3.58,-8 8,-8s8,3.58 8,8c0,2.96 -1.61,5.53 -4,6.92l1,1.73c2.98,-1.73 5,-4.95 5,-8.65 0,-5.52 -4.48,-10 -10,-10z</StreamGeometry>
        <!--  Роутер (ic_hub_local_proxy)  -->
        <StreamGeometry x:Key="Geo.Set.Router">M20.2,5.9l0.8,-0.8C19.6,3.7 17.8,3 16,3s-3.6,0.7 -5,2.1l0.8,0.8C13,4.8 14.5,4.2 16,4.2s3,0.6 4.2,1.7zM19.3,6.7c-0.8,-0.8 -2.1,-1.4 -3.3,-1.4s-2.5,0.5 -3.3,1.4l0.8,0.8c0.6,-0.6 1.6,-1 2.5,-1s1.9,0.4 2.5,1l0.8,-0.8zM19,13h-2V9h-2v4H5c-1.1,0 -2,0.9 -2,2v4c0,1.1 0.9,2 2,2h14c1.1,0 2,-0.9 2,-2v-4c0,-1.1 -0.9,-2 -2,-2zM8,18H6v-2h2v2zM11.5,18h-2v-2h2v2zM15,18h-2v-2h2v2z</StreamGeometry>
        <!--  Mux — сплошной круг (ic_qu_switch залит акцентом → узел мультиплекса)  -->
        <StreamGeometry x:Key="Geo.Set.Mux">M12,3a9,9 0 1,0 0,18a9,9 0 1,0 0,-18z</StreamGeometry>
        <!--  Скорость / спидометр (ic_speed_24dp)  -->
        <StreamGeometry x:Key="Geo.Set.Speed">M20.38,8.57l-1.23,1.85a8,8 0 0,1 -0.22,7.58H5.07A8,8 0 0,1 15.58,6.85l1.85,-1.23A10,10 0 0,0 3.35,19a2,2 0 0,0 1.72,1h13.85a2,2 0 0,0 1.74,-1 10,10 0 0,0 -0.27,-10.44z M10.59,15.41a2,2 0 0,0 2.83,0l5.66,-8.49 -8.49,5.66a2,2 0 0,0 0,2.83z</StreamGeometry>
        <!--  Фрагментация / код (ic_source_code_24dp, viewport 1024)  -->
        <StreamGeometry x:Key="Geo.Set.Fragment">M469.2,802.1l-81.7,-24.6L554.8,221.9l81.7,24.6L469.2,802.1zM362.7,654.5l-124.7,-141.7 124.8,-143.5 -64.4,-56 -173.8,199.8 174,197.7 64.1,-56.3zM899.4,513.1l-173.8,-199.8 -64.4,56 124.8,143.5 -124.7,141.7 64.1,56.4 174,-197.7z</StreamGeometry>
        <!--  Шеврон-вправо (ic_chevron_right)  -->
        <StreamGeometry x:Key="Geo.Set.Chevron">M8.6,4.6L7.2,6l6,6l-6,6l1.4,1.4L16,12z</StreamGeometry>
        <!--  Палитра (ic_palette_24dp)  -->
        <StreamGeometry x:Key="Geo.Set.Palette">M12,2C6.49,2 2,6.49 2,12s4.49,10 10,10c1.38,0 2.5,-1.12 2.5,-2.5 0,-0.61 -0.23,-1.2 -0.64,-1.67 -0.08,-0.1 -0.13,-0.21 -0.13,-0.33 0,-0.28 0.22,-0.5 0.5,-0.5H16c3.31,0 6,-2.69 6,-6 0,-4.96 -4.49,-9 -10,-9zM17.5,13c-0.83,0 -1.5,-0.67 -1.5,-1.5S16.67,10 17.5,10s1.5,0.67 1.5,1.5 -0.67,1.5 -1.5,1.5zM14.5,9C13.67,9 13,8.33 13,7.5S13.67,6 14.5,6 16,6.67 16,7.5 15.33,9 14.5,9zM5,11.5C5,10.67 5.67,10 6.5,10S8,10.67 8,11.5 7.33,13 6.5,13 5,12.33 5,11.5zM11,7.5C11,8.33 10.33,9 9.5,9S8,8.33 8,7.5 8.67,6 9.5,6 11,6.67 11,7.5z</StreamGeometry>
        <!--  Луна / тёмный режим (ic_dark_mode_24dp) — для «Чёрная (AMOLED)»  -->
        <StreamGeometry x:Key="Geo.Set.Moon">M12,3c-4.97,0 -9,4.03 -9,9s4.03,9 9,9 9,-4.03 9,-9c0,-0.46 -0.04,-0.92 -0.1,-1.36 -0.98,1.37 -2.58,2.26 -4.4,2.26 -2.98,0 -5.4,-2.42 -5.4,-5.4 0,-1.81 0.89,-3.42 2.26,-4.4 -0.44,-0.06 -0.9,-0.1 -1.36,-0.1z</StreamGeometry>
        <!--  Питание / запуск (ic_power_settings)  -->
        <StreamGeometry x:Key="Geo.Set.Power">M13,3h-2v10h2V3zM17.83,5.17l-1.42,1.42C17.99,7.86 19,9.81 19,12c0,3.87 -3.13,7 -7,7s-7,-3.13 -7,-7c0,-2.19 1.01,-4.14 2.58,-5.42L6.17,5.17C4.23,6.82 3,9.26 3,12c0,4.97 4.03,9 9,9s9,-4.03 9,-9c0,-2.74 -1.23,-5.18 -3.17,-6.83z</StreamGeometry>
        <!--  Обновление (ic_refresh_24dp)  -->
        <StreamGeometry x:Key="Geo.Set.Refresh">M17.65,6.35C16.2,4.9 14.21,4 12,4c-4.42,0 -7.99,3.58 -7.99,8s3.57,8 7.99,8c3.73,0 6.84,-2.55 7.73,-6h-2.08c-0.82,2.33 -3.04,4 -5.65,4 -3.31,0 -6,-2.69 -6,-6s2.69,-6 6,-6c1.66,0 3.14,0.69 4.22,1.78L13,11h7V4l-2.35,2.35z</StreamGeometry>
        <!--  Маршрутизация (ic_routing_24dp, viewport 1024)  -->
        <StreamGeometry x:Key="Geo.Set.Routing">M740,161a112.1,112.1 0,0 0,-33.5 218.9v95.9L320,602.4L320,318.1a112.1,112.1 0,1 0,-148 -106.1c0,49.3 31.8,91 76,106.1v387.9a112.1,112.1 0,1 0,148 106.1c0,-49.2 -31.8,-91 -76,-106.1v-27.8l423.5,-138.7a50.6,50.6 0,0 0,34.9 -48.2L778.4,378.2c42.9,-15.8 73.6,-57 73.6,-105.2 0,-61.8 -50.2,-112 -112,-112zM236,212a48,48 0,1 1,96 0,48 48,0 0,1 -96,0zM332,812a48,48 0,1 1,-96 0,48 48,0 0,1 96,0zM740,321a48,48 0,1 1,0 -96,48 48,0 0,1 0,96z</StreamGeometry>
        <!--  Файл (ic_file_24dp, viewport 1024)  -->
        <StreamGeometry x:Key="Geo.Set.File">M537,85.3A85.3,85.3 0,0 1,597.3 110.3L828.3,341.3A85.3,85.3 0,0 1,853.3 401.7L853.3,810.7a128,128 0,0 1,-128 128L298.7,938.7a128,128 0,0 1,-128 -128L170.7,213.3a128,128 0,0 1,128 -128zM537,170.7L298.7,170.7a42.7,42.7 0,0 0,-42.7 42.7v597.3a42.7,42.7 0,0 0,42.7 42.7h426.7a42.7,42.7 0,0 0,42.7 -42.7L768,401.7L537,170.7zM512,384a42.7,42.7 0,0 1,42.4 37.7L554.7,426.7v85.3h85.3a42.7,42.7 0,0 1,5 85L640,597.3h-85.3v85.3a42.7,42.7 0,0 1,-85 5L469.3,682.7v-85.3L384,597.3a42.7,42.7 0,0 1,-5 -85L384,512h85.3v-85.3a42.7,42.7 0,0 1,42.7 -42.7z</StreamGeometry>
        <!--  О приложении / инфо (ic_about_24dp, viewport 1024)  -->
        <StreamGeometry x:Key="Geo.Set.About">M810.7,206.3A426.7,426.7 0,1 0,512 938.7h5.5A426.7,426.7 0,0 0,810.7 206.3zM771.8,765A360.1,360.1 0,0 1,517.1 874.7L512,874.7a362.7,362.7 0,0 1,-4.9 -725.3h3.4a362.7,362.7 0,0 1,261.3 615.7zM547.2,390a57.4,57.4 0,0 0,62.3 -55.3,39.3 39.3,0 0,0 -45,-42.7 58.9,58.9 0,0 0,-64 54.6c-1.7,26.9 13.9,43.3 46.7,43.3zM548.3,663.5c-5.5,0 -7.9,-7.3 -2.3,-28.2l31.1,-118c11.7,-42.7 7.9,-71.3 -15.8,-71.3 -28.4,0 -94.7,28.4 -152.5,76.4l11.7,19.4a181.3,181.3 0,0 1,56.1 -24.7c5.5,0 4.7,7.3 0,25.2l-27.3,112.2c-16.6,64 0,77.7 24.5,77.7s85.3,-21.3 141,-77.7l-13.4,-17.9a122.7,122.7 0,0 1,-53.1 26.9z</StreamGeometry>
        <!--  Резервное копирование (ic_backup_24dp, viewport 1024)  -->
        <StreamGeometry x:Key="Geo.Set.Backup">M864,192L704,192L704,96c0,-17.7 -14.3,-32 -32,-32L352,64c-9,0 -17.2,3.7 -22.9,9.7L137.7,265.1c-6,5.8 -9.7,14 -9.7,22.9v512c0,17.7 14.3,32 32,32h160v96c0,17.7 14.3,32 32,32h512c17.7,0 32,-14.3 32,-32L896,224c0,-17.7 -14.3,-32 -32,-32zM320,173.2L320,256h-82.8l82.8,-82.8zM192,768L192,320h160c17.7,0 32,-14.3 32,-32L384,128h256v64h-96c-9,0 -17.2,3.7 -22.9,9.7L329.7,393.1c-6,5.8 -9.7,14 -9.7,22.9v352L192,768zM512,301.2L512,384h-82.8l82.8,-82.8zM832,896L384,896L384,448h160c17.7,0 32,-14.3 32,-32L576,256h256v640z</StreamGeometry>
        <!--  Схемы URL / ссылка (ic_hub_url_scheme)  -->
        <StreamGeometry x:Key="Geo.Set.UrlScheme">M3.9,12c0,-1.71 1.39,-3.1 3.1,-3.1h4V7H7c-2.76,0 -5,2.24 -5,5s2.24,5 5,5h4v-1.9H7c-1.71,0 -3.1,-1.39 -3.1,-3.1zM8,13h8v-2H8v2zM17,7h-4v1.9h4c1.71,0 3.1,1.39 3.1,3.1s-1.39,3.1 -3.1,3.1h-4V17h4c2.76,0 5,-2.24 5,-5s-2.24,-5 -5,-5z</StreamGeometry>

        <!--  Поле ввода локального прокси. Полная ControlTheme (как TextBox.Incy в LoginView),
              чтобы тема Semi не перекрашивала фон/фокус своими токенами: recessed SurfaceHigh,
              радиус 12, высота 44, фокус = рамка Accent, текст OnSurface, каретка синяя.  -->
        <ControlTheme x:Key="TextBox.IncyField" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHigh}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.OutlineVariant}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Tile}" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurface}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="SelectionBrush" Value="#334C8DFF" />
            <Setter Property="SelectionForegroundBrush" Value="{DynamicResource Brush.OnSurface}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="IBeam" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        x:Name="PART_BorderElement"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                            </Transitions>
                        </Border.Transitions>
                        <Grid Margin="{TemplateBinding Padding}" ColumnDefinitions="*,Auto">
                            <Panel Grid.Column="0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <TextBlock
                                    x:Name="PART_Watermark"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource Brush.OnSurfaceVariant}"
                                    IsVisible="{TemplateBinding Text, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                                    Text="{TemplateBinding Watermark}"
                                    TextAlignment="{TemplateBinding TextAlignment}"
                                    TextWrapping="NoWrap" />
                                <ScrollViewer
                                    x:Name="PART_ScrollViewer"
                                    HorizontalScrollBarVisibility="Hidden"
                                    VerticalScrollBarVisibility="Disabled">
                                    <TextPresenter
                                        x:Name="PART_TextPresenter"
                                        VerticalAlignment="Center"
                                        CaretBrush="{TemplateBinding CaretBrush}"
                                        CaretIndex="{TemplateBinding CaretIndex}"
                                        PasswordChar="{TemplateBinding PasswordChar}"
                                        RevealPassword="{TemplateBinding RevealPassword}"
                                        SelectionBrush="{TemplateBinding SelectionBrush}"
                                        SelectionEnd="{TemplateBinding SelectionEnd}"
                                        SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                        SelectionStart="{TemplateBinding SelectionStart}"
                                        Text="{TemplateBinding Text, Mode=TwoWay}"
                                        TextAlignment="{TemplateBinding TextAlignment}"
                                        TextWrapping="{TemplateBinding TextWrapping}" />
                                </ScrollViewer>
                            </Panel>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#PART_BorderElement">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Outline}" />
            </Style>
            <Style Selector="^:focus /template/ Border#PART_BorderElement">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
            </Style>
        </ControlTheme>
    </UserControl.Resources>

    <UserControl.Styles>
        <!--  Плитка green: кисть Brush.Tile.Green есть глобально, но класса Border.Tile.Green
              в GlobalStyles НЕТ — добавляем локально (флаг в отчёте: продвинуть в GlobalStyles).  -->
        <Style Selector="Border.Tile.Green">
            <Setter Property="Background" Value="{DynamicResource Brush.Tile.Green}" />
        </Style>

        <!--  Строка настроек (setting row): minHeight 56, паддинг 16/12, прямоугольный
              hover→SurfaceHigh внутри скруглённой карты (карта клипует углы).  -->
        <Style Selector="Border.SettingRow">
            <Setter Property="MinHeight" Value="{DynamicResource Size.Row}" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Background" Value="Transparent" />
            <!--  Hover мгновенный (без BrushTransition на Background): при прокрутке колесом
                  подсвечивается ровно одна строка, а не две «затухающих» одновременно.  -->
        </Style>
        <Style Selector="Border.SettingRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHigh}" />
        </Style>

        <!--  Поле ввода локального прокси: одна высота 44, recessed SurfaceHigh, синий каретка.  -->

        <!--  Разделитель 1px, инсет слева 72 (16 паддинг + 40 плитка + 16 отступ).  -->
        <Style Selector="Border.SettingDivider">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="72,0,0,0" />
            <Setter Property="Background" Value="{DynamicResource Brush.OutlineVariant}" />
        </Style>

        <!--  Глиф в плитке: 22, по центру.  -->
        <Style Selector="PathIcon.Glyph">
            <Setter Property="Width" Value="{DynamicResource Size.Glyph}" />
            <Setter Property="Height" Value="{DynamicResource Size.Glyph}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--  Шеврон 18, tint OnSurfaceVariant, отступ слева 4.  -->
        <Style Selector="PathIcon.Chevron">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>

        <!--  Заголовок секции: паддинг 16/18/16/8 (SettingsSectionLabel).  -->
        <Style Selector="TextBlock.SettingsSection">
            <Setter Property="Margin" Value="16,18,16,8" />
        </Style>

        <!--  Значение строки: правое, одна строка, отступ слева 8.  -->
        <Style Selector="TextBlock.RowValue">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>

        <!--  iOS-тумблер строки: тема применяется в разметке; здесь только отступ.  -->
        <Style Selector="ToggleSwitch.RowSwitch">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
    </UserControl.Styles>

    <!--  Прозрачный фон: общий Incy-градиент рисуется под хостом страниц (MainWindow), показываем его.  -->
    <ScrollViewer
        Background="Transparent"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,16">

            <!--  ==================== ПОДКЛЮЧЕНИЕ ====================  -->
            <TextBlock Classes="SectionHeader SettingsSection" Text="Подключение" />

            <Border
                Margin="16,0"
                Classes="Card"
                ClipToBounds="True"
                Padding="0">
                <StackPanel>

                    <!--  Режим → TUN  -->
                    <Border x:Name="RowMode" Classes="SettingRow">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <Border
                                Grid.Column="0"
                                Classes="Tile Blue"
                                VerticalAlignment="Center">
                                <PathIcon
                                    Classes="Glyph"
                                    Data="{StaticResource Geo.Set.Shield}"
                                    Foreground="{DynamicResource Brush.Accent}" />
                            </Border>
                            <TextBlock
                                Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Classes="Body"
                                Text="Режим" />
                            <TextBlock
                                x:Name="ValueMode"
                                Grid.Column="2"
                                Classes="Subtitle RowValue"
                                Text="{Binding ModeText}" />
                            <PathIcon
                                Grid.Column="3"
                                Classes="Chevron"
                                Data="{StaticResource Geo.Set.Chevron}" />
                        </Grid>
                    </Border>

                    <Border Classes="SettingDivider" />

                    <!--  Прокси по приложениям → раздельное туннелирование (реальный экран)  -->
                    <Border x:Name="RowPerApp" Classes="SettingRow">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <Border
                                Grid.Column="0"
                                Classes="Tile Orange"
                                VerticalAlignment="Center">
                                <PathIcon
                                    Classes="Glyph"
                                    Data="{StaticResource Geo.Set.Grid}"
                                    Foreground="{DynamicResource Brush.Icon.Orange}" />
                            </Border>
                            <TextBlock
                                Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Classes="Body"
                                Text="Прокси по приложениям" />
                            <TextBlock
                                x:Name="ValuePerApp"
                                Grid.Column="2"
                                Classes="Subtitle RowValue"
                                Text="{Binding PerAppText}" />
                            <PathIcon
                                Grid.Column="3"
                                Classes="Chevron"
                                Data="{StaticResource Geo.Set.Chevron}" />
                        </Grid>
                    </Border>

                    <Border Classes="SettingDivider" />

                    <!--  Обход локальной сети + тумблер ON  -->
                    <Border x:Name="RowBypassLan" Classes="SettingRow">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <Border
                                Grid.Column="0"
                                Classes="Tile Green"
                                VerticalAlignment="Center">
                                <PathIcon
                                    Classes="Glyph"
                                    Data="{StaticResource Geo.Set.Globe}"
                                    Foreground="{DynamicResource Brush.Green}" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                Margin="16,0,8,0"
                                VerticalAlignment="Center">
                                <TextBlock Classes="Body" Text="Обход локальной сети" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Classes="Subtitle"
                                    Text="Прямой доступ к устройствам в локальной сети"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="SwitchBypassLan"
                                Grid.Column="2"
                                Classes="RowSwitch"
                                IsChecked="{Binding BypassLan, Mode=TwoWay}"
                                Theme="{DynamicResource ToggleSwitch.iOS}" />
                        </Grid>
                    </Border>

                    <Border Classes="SettingDivider" />

                    <!--  IPv6 + тумблер OFF  -->
                    <Border x:Name="RowIpv6" Classes="SettingRow">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <Border
                                Grid.Column="0"
                                Classes="Tile Green"
                                VerticalAlignment="Center">
                                <PathIcon
                                    Classes="Glyph"
                                    Data="{StaticResource Geo.Set.Globe}"
                                    Foreground="{DynamicResource Brush.Green}" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                Margin="16,0,8,0"
                                VerticalAlignment="Center">
                                <TextBlock Classes="Body" Text="IPv6" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Classes="Subtitle"
                                    Text="Включить IPv6-адресацию в туннеле"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="SwitchIpv6"
                                Grid.Column="2"
                                Classes="RowSwitch"
                                IsChecked="{Binding EnableIpv6, Mode=TwoWay}"
                                Theme="{DynamicResource ToggleSwitch.iOS}" />
                        </Grid>
                    </Border>

                    <Border Classes="SettingDivider" />

                    <!--  DNS → Cloudflare  -->
                    <Border x:Name="RowDns" Classes="SettingRow">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <Border
                                Grid.Column="0"
                                Classes="Tile Purple"
                                VerticalAlignment="Center">
                                <PathIcon
                                    Classes="Glyph"
                                    Data="{StaticResource Geo.Set.Privacy}"
                                    Foreground="{DynamicResource Brush.Accent}" />
                            </Border>
                            <TextBlock
                                Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Classes="Body"
                                Text="DNS" />
                            <TextBlock
                                x:Name="ValueDns"
                                Grid.Column="2"
                                Classes="Subtitle RowValue"
                                Text="{Binding DnsText}" />
                            <PathIcon
                                Grid.Column="3"
                                Classes="Chevron"
                                Data="{StaticResource Geo.Set.Chevron}" />
                        </Grid>
                    </Border>

                    <Border Classes="SettingDivider" />

                    <!--  Пинг → редактор параметров реальной проверки задержки  -->
                    <Border x:Name="RowPingMethod" Classes="SettingRow">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <Border
                                Grid.Column="0"
                                Classes="Tile Yellow"
                                VerticalAlignment="Center">
                                <PathIcon
                                    Classes="Glyph"
                                    Data="{StaticResource Geo.Set.Ping}"
                                    Foreground="{DynamicResource Brush.Icon.Yellow}" />
                            </Border>
                            <TextBlock
                                Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Classes="Body"
                                Text="Пинг" />
                            <TextBlock
                                x:Name="ValuePingMethod"
                                Grid.Column="2"
                                Classes="Subtitle RowValue"
                                Text="{Binding PingMethodText}" />
                            <PathIcon
                                Grid.Column="3"
                                Classes="Chevron"
                                Data="{StaticResource Geo.Set.Chevron}" />
                        </Grid>
                    </Border>

                    <Border Classes="SettingDivider" />

                    <!--  Локальный прокси (КРАСНАЯ плитка) → chevron  -->
                    <Border x:Name="RowLocalProxy" Classes="SettingRow">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <Border
                                Grid.Column="0"
                                Classes="Tile Red"
                                VerticalAlignment="Center">
                                <PathIcon
                                    Classes="Glyph"
                                    Data="{StaticResource Geo.Set.Router}"
                                    Foreground="{DynamicResource Brush.Red}" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                Margin="16,0,8,0"
                                VerticalAlignment="Center">
                                <TextBlock Classes="Body" Text="Локальный прокси" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Classes="Subtitle"
                                    Text="SOCKS5-авторизация, память, доступ по сети"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <!--  Раскрытие панели вращает шеврон 0°→90° БЕЗ CenterX/Y (code-behind ставит
                                  голый RotateTransform) → он вращается вокруг origin. Значит origin =
                                  относительный центр «50%,50%»; «0.5,0.5» = 0.5px ≈ угол → шеврон облетал бы.  -->
                            <PathIcon
                                x:Name="LocalProxyChevron"
                                Grid.Column="3"
                                Classes="Chevron"
                                Data="{StaticResource Geo.Set.Chevron}"
                                RenderTransformOrigin="50%,50%" />
                        </Grid>
                    </Border>

                    <!--  Инлайн-суб-поверхность локального прокси: реальные поля Inbound[0]
                          (порт + SOCKS5-авторизация). Раскрывается по тапу строки; коммит на
                          потере фокуса / при сворачивании. Адрес фиксирован 127.0.0.1.  -->
                    <Border
                        x:Name="LocalProxyPanel"
                        Padding="16,4,16,16"
                        Background="Transparent"
                        IsVisible="False">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="Subtitle" Text="Порт" />
                                <TextBox
                                    x:Name="ProxyPortBox"
                                    MaxLength="5"
                                    Text="{Binding LocalPortText, Mode=TwoWay}"
                                    Theme="{StaticResource TextBox.IncyField}" />
                            </StackPanel>
                            <TextBlock
                                Margin="0,4,0,0"
                                Classes="Subtitle"
                                Foreground="{DynamicResource Brush.OnSurface}"
                                Text="SOCKS5-авторизация" />
                            <StackPanel Spacing="6">
                                <TextBlock Classes="Subtitle" Text="Логин" />
                                <TextBox
                                    x:Name="ProxyUserBox"
                                    Text="{Binding ProxyUser, Mode=TwoWay}"
                                    Theme="{StaticResource TextBox.IncyField}"
                                    Watermark="Не задан" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Classes="Subtitle" Text="Пароль" />
                                <TextBox
                                    x:Name="ProxyPassBox"
                                    PasswordChar="●"
                                    Text="{Binding ProxyPass, Mode=TwoWay}"
                                    Theme="{StaticResource TextBox.IncyField}"
                                    Watermark="Не задан" />
                            </StackPanel>
                            <TextBlock
                                Classes="Subtitle"
                                Text="Адрес: 127.0.0.1. Пустые логин и пароль отключают SOCKS5-авторизацию."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>

            <!--  ==================== ОБХОД БЛОКИРОВОК ====================  -->
            <TextBlock Classes="SectionHeader SettingsSection" Text="Обход блокировок" />

            <Border
                Margin="16,0"
                Classes="Card"
                ClipToBounds="True"
                Padding="0">
                <StackPanel>

                    <!--  Мультиплексирование (Mux) + тумблер OFF  -->
                    <Border x:Name="RowMux" Classes="SettingRow">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <Border
                                Grid.Column="0"
                                Classes="Tile Blue"
                                VerticalAlignment="Center">
                                <PathIcon
                                    Classes="Glyph"
                                    Data="{StaticResource Geo.Set.Mux}"
                                    Foreground="{DynamicResource Brush.Accent}" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                Margin="16,0,8,0"
                                VerticalAlignment="Center">
                                <TextBlock Classes="Body" Text="Мультиплексирование (Mux)" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Classes="Subtitle"
                                    Text="Объединяет запросы в один канал соединения"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="SwitchMux"
                                Grid.Column="2"
                                Classes="RowSwitch"
                                IsChecked="{Binding MuxEnabled, Mode=TwoWay}"
                                Theme="{DynamicResource ToggleSwitch.iOS}" />
                        </Grid>
                    </Border>

                    <Border Classes="SettingDivider" />

                    <!--  Число соединений Mux (видимо только при Mux ON → скрыто по умолчанию)  -->
                    <Border
                        x:Name="RowMuxConcurrency"
                        Classes="SettingRow"
                        IsVisible="False">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <Border
                                Grid.Column="0"
                                Classes="Tile Blue"
                                VerticalAlignment="Center">
                                <PathIcon
                                    Classes="Glyph"
                                    Data="{StaticResource Geo.Set.Speed}"
                                    Foreground="{DynamicResource Brush.Accent}" />
                            </Border>
                            <TextBlock
                                Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Classes="Body"
                                Text="Число соединений Mux" />
                            <TextBlock
                                x:Name="ValueMuxConcurrency"
                                Grid.Column="2"
                                Classes="Subtitle RowValue"
                                Text="{Binding MuxConcurrencyText}" />
                            <PathIcon
                                Grid.Column="3"
                                Classes="Chevron"
                                Data="{StaticResource Geo.Set.Chevron}" />
                        </Grid>
                    </Border>

                    <Border
                        x:Name="DividerConcurrency"
                        Classes="SettingDivider"
                        IsVisible="False" />

                    <!--  Фрагментация пакетов + тумблер OFF  -->
                    <Border x:Name="RowFragment" Classes="SettingRow">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <Border
                                Grid.Column="0"
                                Classes="Tile Purple"
                                VerticalAlignment="Center">
                                <PathIcon
                                    Classes="Glyph"
                                    Data="{StaticResource Geo.Set.Fragment}"
                                    Foreground="{DynamicResource Brush.Accent}" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                Margin="16,0,8,0"
                                VerticalAlignment="Center">
                                <TextBlock Classes="Body" Text="Фрагментация пакетов" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Classes="Subtitle"
                                    Text="Разбивает TLS-рукопожатие против DPI"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="SwitchFragment"
                                Grid.Column="2"
                                Classes="RowSwitch"
                                IsChecked="{Binding FragmentEnabled, Mode=TwoWay}"
                                Theme="{DynamicResource ToggleSwitch.iOS}" />
                        </Grid>
                    </Border>

                </StackPanel>
            </Border>

            <!--  ==================== ПРОИЗВОДИТЕЛЬНОСТЬ (наше, не из Android) ====================  -->
            <!--  Владелец просил перф-контролы. В Android/плане строк нет — минимальный
                  раздел с одним тумблером, копия — по описанию владельца.  -->
            <TextBlock Classes="SectionHeader SettingsSection" Text="Производительность" />

            <Border
                Margin="16,0"
                Classes="Card"
                ClipToBounds="True"
                Padding="0">
                <StackPanel>

                    <!--  Облегчённый режим + тумблер OFF  -->
                    <Border x:Name="RowLiteMode" Classes="SettingRow">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <Border
                                Grid.Column="0"
                                Classes="Tile Yellow"
                                VerticalAlignment="Center">
                                <PathIcon
                                    Classes="Glyph"
                                    Data="{StaticResource Geo.Set.Speed}"
                                    Foreground="{DynamicResource Brush.Icon.Yellow}" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                Margin="16,0,8,0"
                                VerticalAlignment="Center">
                                <TextBlock Classes="Body" Text="Облегчённый режим" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Classes="Subtitle"
                                    Text="Отключает анимации, снижает нагрузку"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="SwitchLiteMode"
                                Grid.Column="2"
                                Classes="RowSwitch"
                                IsChecked="{Binding LiteMode, Mode=TwoWay}"
                                Theme="{DynamicResource ToggleSwitch.iOS}" />
                        </Grid>
                    </Border>

                </StackPanel>
            </Border>

            <!--  ==================== ИНТЕРФЕЙС ====================  -->
            <TextBlock Classes="SectionHeader SettingsSection" Text="Интерфейс" />

            <Border
                Margin="16,0"
                Classes="Card"
                ClipToBounds="True"
                Padding="0">
                <StackPanel>

                    <!--  Оформление → переключение темы (тап циклит значение, применяется вживую)  -->
                    <Border x:Name="RowAppearance" Classes="SettingRow">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <Border
                                Grid.Column="0"
                                Classes="Tile Purple"
                                VerticalAlignment="Center">
                                <PathIcon
                                    Classes="Glyph"
                                    Data="{StaticResource Geo.Set.Palette}"
                                    Foreground="{DynamicResource Brush.Accent}" />
                            </Border>
                            <TextBlock
                                Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Classes="Body"
                                Text="Оформление" />
                            <TextBlock
                                x:Name="ValueAppearance"
                                Grid.Column="2"
                                Classes="Subtitle RowValue"
                                Text="{Binding AppearanceText}" />
                            <PathIcon
                                Grid.Column="3"
                                Classes="Chevron"
                                Data="{StaticResource Geo.Set.Chevron}" />
                        </Grid>
                    </Border>

                    <Border Classes="SettingDivider" />

                    <!--  Чёрная (AMOLED) — ОТДЕЛЬНЫЙ тумблер поверх тёмной/светлой (как Android
                          Mono-оверлей). Чистый чёрный фон/поверхности для OLED; чернила
                          остаются высококонтрастными. Применяется вживую, переживает перезапуск.  -->
                    <Border x:Name="RowBlackTheme" Classes="SettingRow">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <Border
                                Grid.Column="0"
                                Classes="Tile Purple"
                                VerticalAlignment="Center">
                                <PathIcon
                                    Classes="Glyph"
                                    Data="{StaticResource Geo.Set.Moon}"
                                    Foreground="{DynamicResource Brush.Accent}" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                Margin="16,0,8,0"
                                VerticalAlignment="Center">
                                <TextBlock Classes="Body" Text="Чёрно-белая" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Classes="Subtitle"
                                    Text="Монохромный режим поверх тёмной или светлой темы"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="SwitchBlackTheme"
                                Grid.Column="2"
                                Classes="RowSwitch"
                                IsChecked="{Binding BlackTheme, Mode=TwoWay}"
                                Theme="{DynamicResource ToggleSwitch.iOS}" />
                        </Grid>
                    </Border>

                    <Border Classes="SettingDivider" />

                    <!--  Язык → Русский  -->
                    <Border x:Name="RowLanguage" Classes="SettingRow">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <Border
                                Grid.Column="0"
                                Classes="Tile Green"
                                VerticalAlignment="Center">
                                <PathIcon
                                    Classes="Glyph"
                                    Data="{StaticResource Geo.Set.Globe}"
                                    Foreground="{DynamicResource Brush.Green}" />
                            </Border>
                            <TextBlock
                                Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Classes="Body"
                                Text="Язык" />
                            <TextBlock
                                x:Name="ValueLanguage"
                                Grid.Column="2"
                                Classes="Subtitle RowValue"
                                Text="{Binding LanguageText}" />
                            <PathIcon
                                Grid.Column="3"
                                Classes="Chevron"
                                Data="{StaticResource Geo.Set.Chevron}" />
                        </Grid>
                    </Border>

                    <Border Classes="SettingDivider" />

                    <!--  Запуск при загрузке + тумблер OFF  -->
                    <Border x:Name="RowBoot" Classes="SettingRow">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <Border
                                Grid.Column="0"
                                Classes="Tile Orange"
                                VerticalAlignment="Center">
                                <PathIcon
                                    Classes="Glyph"
                                    Data="{StaticResource Geo.Set.Power}"
                                    Foreground="{DynamicResource Brush.Icon.Orange}" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                Margin="16,0,8,0"
                                VerticalAlignment="Center">
                                <TextBlock Classes="Body" Text="Запуск при загрузке" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Classes="Subtitle"
                                    Text="Открывать departament при входе в систему"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="SwitchBoot"
                                Grid.Column="2"
                                Classes="RowSwitch"
                                IsChecked="{Binding AutoStart, Mode=TwoWay}"
                                Theme="{DynamicResource ToggleSwitch.iOS}" />
                        </Grid>
                    </Border>

                </StackPanel>
            </Border>

            <!--  ==================== ПОДПИСКА ====================  -->
            <TextBlock Classes="SectionHeader SettingsSection" Text="Подписка" />

            <Border
                Margin="16,0"
                Classes="Card"
                ClipToBounds="True"
                Padding="0">
                <StackPanel>

                    <!--  Автообновление подписки → 24 часа  -->
                    <Border x:Name="RowSubAutoUpdate" Classes="SettingRow">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <Border
                                Grid.Column="0"
                                Classes="Tile Blue"
                                VerticalAlignment="Center">
                                <PathIcon
                                    Classes="Glyph"
                                    Data="{StaticResource Geo.Set.Refresh}"
                                    Foreground="{DynamicResource Brush.Accent}" />
                            </Border>
                            <TextBlock
                                Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Classes="Body"
                                Text="Автообновление подписки" />
                            <TextBlock
                                x:Name="ValueSubAutoUpdate"
                                Grid.Column="2"
                                Classes="Subtitle RowValue"
                                Text="{Binding SubAutoUpdateText}" />
                            <PathIcon
                                Grid.Column="3"
                                Classes="Chevron"
                                Data="{StaticResource Geo.Set.Chevron}" />
                        </Grid>
                    </Border>

                    <Border Classes="SettingDivider" />

                    <!--  Маршрутизация → chevron  -->
                    <Border x:Name="RowRouting" Classes="SettingRow">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <Border
                                Grid.Column="0"
                                Classes="Tile Purple"
                                VerticalAlignment="Center">
                                <PathIcon
                                    Classes="Glyph"
                                    Data="{StaticResource Geo.Set.Routing}"
                                    Foreground="{DynamicResource Brush.Accent}" />
                            </Border>
                            <TextBlock
                                Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Classes="Body"
                                Text="Маршрутизация" />
                            <PathIcon
                                Grid.Column="3"
                                Classes="Chevron"
                                Data="{StaticResource Geo.Set.Chevron}" />
                        </Grid>
                    </Border>

                    <Border Classes="SettingDivider" />

                    <!--  Файлы ресурсов → загрузка geoip/geosite (реальный экран)  -->
                    <Border x:Name="RowAssets" Classes="SettingRow">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border
                                Grid.Column="0"
                                Classes="Tile Green"
                                VerticalAlignment="Center">
                                <PathIcon
                                    Classes="Glyph"
                                    Data="{StaticResource Geo.Set.File}"
                                    Foreground="{DynamicResource Brush.Green}" />
                            </Border>
                            <TextBlock
                                Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Classes="Body"
                                Text="Файлы ресурсов" />
                            <PathIcon
                                Grid.Column="2"
                                Classes="Chevron"
                                Data="{StaticResource Geo.Set.Chevron}" />
                        </Grid>
                    </Border>

                </StackPanel>
            </Border>

            <!--  ==================== О ПРИЛОЖЕНИИ ====================  -->
            <TextBlock Classes="SectionHeader SettingsSection" Text="О приложении" />

            <Border
                Margin="16,0"
                Classes="Card"
                ClipToBounds="True"
                Padding="0">
                <StackPanel>

                    <!--  О приложении → версия + ссылки (реальный экран)  -->
                    <Border x:Name="RowAbout" Classes="SettingRow">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <Border
                                Grid.Column="0"
                                Classes="Tile Blue"
                                VerticalAlignment="Center">
                                <PathIcon
                                    Classes="Glyph"
                                    Data="{StaticResource Geo.Set.About}"
                                    Foreground="{DynamicResource Brush.Accent}" />
                            </Border>
                            <TextBlock
                                Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Classes="Body"
                                Text="О приложении" />
                            <TextBlock
                                x:Name="ValueAbout"
                                Grid.Column="2"
                                Classes="Subtitle RowValue"
                                Text="{Binding AboutText}" />
                            <PathIcon
                                Grid.Column="3"
                                Classes="Chevron"
                                Data="{StaticResource Geo.Set.Chevron}" />
                        </Grid>
                    </Border>

                    <Border Classes="SettingDivider" />

                    <!--  Резервное копирование → экспорт/импорт .zip (реальный экран)  -->
                    <Border x:Name="RowBackup" Classes="SettingRow">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border
                                Grid.Column="0"
                                Classes="Tile Green"
                                VerticalAlignment="Center">
                                <PathIcon
                                    Classes="Glyph"
                                    Data="{StaticResource Geo.Set.Backup}"
                                    Foreground="{DynamicResource Brush.Green}" />
                            </Border>
                            <TextBlock
                                Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Classes="Body"
                                Text="Резервное копирование" />
                            <PathIcon
                                Grid.Column="2"
                                Classes="Chevron"
                                Data="{StaticResource Geo.Set.Chevron}" />
                        </Grid>
                    </Border>

                    <Border Classes="SettingDivider" />

                    <!--  Схемы URL-адресов → регистрация depv:// + список (реальный экран)  -->
                    <Border x:Name="RowUrlScheme" Classes="SettingRow">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border
                                Grid.Column="0"
                                Classes="Tile Purple"
                                VerticalAlignment="Center">
                                <PathIcon
                                    Classes="Glyph"
                                    Data="{StaticResource Geo.Set.UrlScheme}"
                                    Foreground="{DynamicResource Brush.Accent}" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                Margin="16,0,8,0"
                                VerticalAlignment="Center">
                                <TextBlock Classes="Body" Text="Схемы URL-адресов" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Classes="Subtitle"
                                    Text="Быстрые команды depv://"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <PathIcon
                                Grid.Column="2"
                                Classes="Chevron"
                                Data="{StaticResource Geo.Set.Chevron}" />
                        </Grid>
                    </Border>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
