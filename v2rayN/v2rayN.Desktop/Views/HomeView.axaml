<UserControl
    x:Class="v2rayN.Desktop.Views.HomeView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:v2rayN.Desktop.Views"
    mc:Ignorable="d">

    <!--  Фон Главной — радиальный градиент (bg_home_gradient).  -->
    <Border Background="{DynamicResource Brush.HomeGradient}">

        <!--  Двухпанельная раскладка: ЛЕВО (440, серверы) | 1px divider | ПРАВО (flex, подключение).  -->
        <Grid ColumnDefinitions="440,1,*">

            <!--  ЛЕВАЯ колонка: мета-бар подписки + список серверов.  -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*" MinWidth="380">
                <views:SubscriptionMetaView Grid.Row="0" Margin="16,16,16,4" />
                <views:ServerListView Grid.Row="1" />
            </Grid>

            <!--  Вертикальный разделитель 1px  -->
            <Border Grid.Column="1" Background="{DynamicResource Brush.OutlineVariant}" />

            <!--  ПРАВАЯ колонка: чип аккаунта (сверху) + connect-щит.  -->
            <Grid Grid.Column="2" RowDefinitions="Auto,*" Margin="16">

                <!--  Чип аккаунта: аватар + @ник + «Управление аккаунтом» + chevron.  -->
                <Border
                    Grid.Row="0"
                    Height="64"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.OutlineVariant}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Card}"
                    Padding="10,8,16,8">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border
                            Grid.Column="0"
                            Width="40"
                            Height="40"
                            Classes="Avatar">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{DynamicResource Font.Grotesk}"
                                FontSize="18"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Brush.Accent}"
                                Text="S" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Spacing="1">
                            <TextBlock Classes="Title" Text="@serumfx" />
                            <TextBlock Classes="Caption" Text="Управление аккаунтом" />
                        </StackPanel>
                        <Path
                            Grid.Column="2"
                            Width="9"
                            Height="16"
                            Data="M1 1 L8 8 L1 15"
                            Stroke="{DynamicResource Brush.OnSurfaceVariant}"
                            StrokeThickness="1.6"
                            StrokeLineCap="Round"
                            VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!--  Connect-щит (стата-строка + кольца + диск + щит + подпись сервера + пустое состояние).  -->
                <views:ConnectHeroView Grid.Row="1" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
