<UserControl
    x:Class="v2rayN.Desktop.Views.SubscriptionMetaView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignWidth="408"
    mc:Ignorable="d">

    <!--
        Мета-бар подписки = ЗАГОЛОВОК её группы серверов (под-план 2, 1:1 c Android
        layout_subscription_meta_bar.xml). Владелец: карточка подписки сверху ДОЛЖНА
        бесшовно продолжаться в свои серверы одной секцией — поэтому этот вид живёт КАК
        header каждой группы внутри ServerListView (никакого отдельного «Сервера»-заголовка).

        Строка 1: шеврон-сворачивание (сворачивает серверы ЭТОЙ подписки) + (title + subtitle)
                   + действия (пинг · обновить · пин · «+» добавить подписку).
        Тело (видно только у реальной подписки с userinfo): трафик-пилюля + expiry, announce,
                   поддержка + telegram.

        DataContext = HomeServerGroup (наследуется из шаблона группы). SubItem резолвится в
        code-behind по Subid первого сервера группы (AppManager.GetSubItem) — только реальные
        данные движка, ничего не выдумываем. Образцы — ТОЛЬКО в Design.IsDesignMode.
    -->

    <UserControl.Resources>
        <!--  Глифы-иконки, портированные 1:1 из Android res/drawable (viewport 24×24).  -->
        <!--  ic_arrow_drop_down/шеврон группы — тонкий caret «⌄» (expand_more).  -->
        <StreamGeometry x:Key="Meta.Chevron">M7.41,8.59L12,13.17l4.59,-4.58L18,10l-6,6 -6,-6z</StreamGeometry>
        <!--  ic_ping_24dp — концентрические дуги-вещание.  -->
        <StreamGeometry x:Key="Meta.Ping">M12,11c-1.1,0 -2,0.9 -2,2s0.9,2 2,2 2,-0.9 2,-2 -0.9,-2 -2,-2zM18,13c0,-3.31 -2.69,-6 -6,-6s-6,2.69 -6,6c0,2.22 1.21,4.15 3,5.19l1,-1.74c-1.19,-0.7 -2,-1.97 -2,-3.45 0,-2.21 1.79,-4 4,-4s4,1.79 4,4c0,1.48 -0.81,2.75 -2,3.45l1,1.74c1.79,-1.04 3,-2.97 3,-5.19zM12,3C6.48,3 2,7.48 2,13c0,3.7 2.01,6.92 4.99,8.65l1,-1.73C5.61,18.53 4,15.96 4,13c0,-4.42 3.58,-8 8,-8s8,3.58 8,8c0,2.96 -1.61,5.53 -4,6.92l1,1.73c2.98,-1.73 5,-4.95 5,-8.65 0,-5.52 -4.48,-10 -10,-10z</StreamGeometry>
        <!--  ic_refresh_24dp — круговая стрелка обновления.  -->
        <StreamGeometry x:Key="Meta.Refresh">M17.65,6.35C16.2,4.9 14.21,4 12,4c-4.42,0 -7.99,3.58 -7.99,8s3.57,8 7.99,8c3.73,0 6.84,-2.55 7.73,-6h-2.08c-0.82,2.33 -3.04,4 -5.65,4 -3.31,0 -6,-2.69 -6,-6s2.69,-6 6,-6c1.66,0 3.14,0.69 4.22,1.78L13,11h7V4l-2.35,2.35z</StreamGeometry>
        <!--  ic_pin_24dp — канцелярская кнопка.  -->
        <StreamGeometry x:Key="Meta.Pin">M16,9V4h1c0.55,0 1,-0.45 1,-1s-0.45,-1 -1,-1H7C6.45,2 6,2.45 6,3s0.45,1 1,1h1v5c0,1.66 -1.34,3 -3,3v2h5.97v7l1,1 1,-1v-7H19v-2c-1.66,0 -3,-1.34 -3,-3z</StreamGeometry>
        <!--  ic_support_24dp — вопрос в круге (help).  -->
        <StreamGeometry x:Key="Meta.Support">M12,2C6.48,2 2,6.48 2,12s4.48,10 10,10 10,-4.48 10,-10S17.52,2 12,2zM13,19h-2v-2h2v2zM15.07,11.25l-0.9,0.92C13.45,12.9 13,13.5 13,15h-2v-0.5c0,-1.1 0.45,-2.1 1.17,-2.83l1.24,-1.26c0.37,-0.36 0.59,-0.86 0.59,-1.41 0,-1.1 -0.9,-2 -2,-2s-2,0.9 -2,2H8c0,-2.21 1.79,-4 4,-4s4,1.79 4,4c0,0.88 -0.36,1.68 -0.93,2.25z</StreamGeometry>
        <!--  Telegram — бумажный самолётик (send). Устойчивый all-line путь (без арок).  -->
        <StreamGeometry x:Key="Meta.Telegram">M2.01,21L23,12 2.01,3 2,10l15,2 -15,2z</StreamGeometry>
        <!--  «+» добавить подписку.  -->
        <StreamGeometry x:Key="Meta.Plus">M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6z</StreamGeometry>
        <!--  Пункты меню «+»: QR / буфер / файл.  -->
        <StreamGeometry x:Key="Meta.Qr">M9.5 6.5v3h-3v-3h3M11 5H5v6h6V5m-1.5 9.5v3h-3v-3h3M11 13H5v6h6v-6m6.5-6.5v3h-3v-3h3M19 5h-6v6h6V5m-1.5 9.5v3h-3v-3h3M19 13h-6v6h6v-6M3 3h2V1H3c-1.1 0-2 .9-2 2v2h2V3m18 0v2h2V3c0-1.1-.9-2-2-2h-2v2h2M3 21v-2H1v2c0 1.1.9 2 2 2h2v-2H3m18 0h-2v2h2c1.1 0 2-.9 2-2v-2h-2v2z</StreamGeometry>
        <StreamGeometry x:Key="Meta.Clipboard">M19 2h-4.18C14.4.84 13.3 0 12 0c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm7 18H5V4h2v3h10V4h2v16z</StreamGeometry>
        <StreamGeometry x:Key="Meta.File">M6 2c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6H6zm7 7V3.5L18.5 9H13z</StreamGeometry>
    </UserControl.Resources>

    <UserControl.Styles>
        <!--  Шеврон-сворачивание: 0° раскрыто, −90° свёрнуто (зеркалит Android bindHeader).  -->
        <Style Selector="PathIcon.metaChevron">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="PathIcon.metaChevron.collapsed">
            <Setter Property="RenderTransform" Value="rotate(-90deg)" />
        </Style>

        <!--  Меню «+» (Incy тёмная поверхность, радиус 12, пункты Body).  -->
        <Style Selector="MenuFlyoutPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.OutlineVariant}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style Selector="MenuFlyoutPresenter MenuItem">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurface}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </UserControl.Styles>

    <!--  Карточка мета-бара (bg_server_card): Surface, radius 20, 1px OutlineVariant.
          Паддинг 16/12/12/12 как в Android. Без вложенных карточек.
          Всегда видна для группы; тело — только у реальной подписки с userinfo.  -->
    <Border
        x:Name="MetaCard"
        Classes="Card"
        Padding="16,12,12,12">
        <StackPanel>

            <!--  ============ Строка 1: шеврон + заголовок/подзаголовок + действия ============  -->
            <Grid ColumnDefinitions="Auto,*,Auto">

                <!--  Шеврон-сворачивание серверов подписки (глиф 22). Бокс 40 — ≥ touch target.  -->
                <Button
                    x:Name="CollapseButton"
                    Grid.Column="0"
                    Margin="0,0,4,0"
                    Classes="IconButton40"
                    Click="OnCollapseClick"
                    ToolTip.Tip="Свернуть серверы">
                    <PathIcon
                        x:Name="CollapseIcon"
                        Width="22"
                        Height="22"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Classes="metaChevron"
                        Data="{StaticResource Meta.Chevron}"
                        Foreground="{DynamicResource Brush.OnSurfaceVariant}" />
                </Button>

                <!--  Заголовок (profile-title/remarks) + подзаголовок (last-update · автообновление).  -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        x:Name="TitleText"
                        Classes="Title"
                        Text=""
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="SubtitleText"
                        Margin="0,4,0,0"
                        Classes="Caption"
                        Text=""
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!--  Действия: пинг → обновить → пин → «+». Иконочные кнопки 40, глиф 20.  -->
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        x:Name="PingButton"
                        Classes="IconButton40 Row Accent"
                        ToolTip.Tip="Проверить задержку">
                        <PathIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="{StaticResource Meta.Ping}" />
                    </Button>
                    <!--  Обновить: во время обновления глиф В ТОМ ЖЕ 40-слоте заменяется компактным
                          спиннером-дугой (никакого растущего прогресс-бара, ничего вокруг не сдвигается).  -->
                    <Button
                        x:Name="RefreshButton"
                        Classes="IconButton40 Row Accent"
                        ToolTip.Tip="Обновить подписку">
                        <Panel>
                            <PathIcon
                                x:Name="RefreshIcon"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="{StaticResource Meta.Refresh}" />
                            <Ellipse
                                x:Name="RefreshSpinner"
                                Width="18"
                                Height="18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Classes="Spinner"
                                IsVisible="False"
                                Stroke="{DynamicResource Brush.Accent}"
                                StrokeDashArray="7,21.2"
                                StrokeLineCap="Round"
                                StrokeThickness="2" />
                        </Panel>
                    </Button>
                    <Button
                        x:Name="PinButton"
                        Classes="IconButton40 Row"
                        ToolTip.Tip="Закрепить">
                        <!--  Foreground = OnSurfaceVariant (не закреплено) / Accent (закреплено).  -->
                        <PathIcon
                            x:Name="PinIcon"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="{StaticResource Meta.Pin}"
                            Foreground="{DynamicResource Brush.OnSurfaceVariant}" />
                    </Button>
                    <!--  «+» добавить ДРУГУЮ подписку (буфер / QR / файл) — акцент = основное действие.  -->
                    <Button
                        x:Name="AddButton"
                        Classes="IconButton40 Row Accent"
                        ToolTip.Tip="Добавить подписку">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Click="OnImportClipboard" Header="Импорт из буфера обмена">
                                    <MenuItem.Icon>
                                        <PathIcon Width="20" Height="20" Data="{StaticResource Meta.Clipboard}" Foreground="{DynamicResource Brush.OnSurfaceVariant}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Click="OnImportQr" Header="Импорт из QR-кода">
                                    <MenuItem.Icon>
                                        <PathIcon Width="20" Height="20" Data="{StaticResource Meta.Qr}" Foreground="{DynamicResource Brush.OnSurfaceVariant}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Click="OnImportFile" Header="Импорт из файла">
                                    <MenuItem.Icon>
                                        <PathIcon Width="20" Height="20" Data="{StaticResource Meta.File}" Foreground="{DynamicResource Brush.OnSurfaceVariant}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuFlyout>
                        </Button.Flyout>
                        <PathIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="{StaticResource Meta.Plus}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!--  ============ Тело (только у реальной подписки): трафик + announce + поддержка ============  -->
            <StackPanel x:Name="MetaBody">

                <!--  Строка 2: трафик-пилюля по центру + expiry-маркер справа на той же линии.  -->
                <Grid Margin="0,12,0,0">
                    <!--  Пилюля 160×16: трек SurfaceVariant, radius 8, с заливкой Accent под подписью.  -->
                    <Panel
                        Width="{StaticResource Size.TrafficPill}"
                        HorizontalAlignment="Center">
                        <Border Classes="TrafficPill" VerticalAlignment="Center">
                            <!--  Заливка: Width = 160 * trafficFraction. Безлимит (∞) ⇒ 0 (пустой трек).  -->
                            <Border
                                x:Name="TrafficFill"
                                Width="0"
                                Classes="TrafficPill Fill" />
                        </Border>
                        <TextBlock
                            x:Name="TrafficText"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Classes="Numeric"
                            FontFeatures="tnum"
                            FontSize="11"
                            FontWeight="Medium"
                            Text="" />
                    </Panel>
                    <!--  Expiry: «∞» / «до dd.MM.yyyy» / «Просрочено» (красный) — привязка.  -->
                    <TextBlock
                        x:Name="ExpiryText"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Classes="Caption"
                        FontFeatures="tnum"
                        Text="" />
                </Grid>

                <!--  Announce-баннер подписки (по центру, приглушённый, до 5 строк). Скрыт, если пусто.  -->
                <TextBlock
                    x:Name="AnnounceText"
                    Margin="0,12,0,0"
                    Classes="Caption"
                    MaxLines="5"
                    Text=""
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />

                <!--  Нижняя строка: тональная «Поддержка» слева + Telegram справа (противоположные углы).
                      Скрыта целиком, когда провайдер не прислал ни support-url, ни web-page-url.  -->
                <Grid
                    x:Name="ActionRow"
                    Margin="0,12,0,0"
                    ColumnDefinitions="Auto,*,Auto">
                    <!--  «Поддержка»: компактная тональная пилюля (в теме Incy — синий контейнер акцента).  -->
                    <Button
                        x:Name="SupportButton"
                        Grid.Column="0"
                        Height="40"
                        Padding="12,0,16,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource Brush.AccentContainer}"
                        Classes="Tonal"
                        FontSize="12"
                        Foreground="{DynamicResource Brush.OnAccentContainer}"
                        ToolTip.Tip="Открыть поддержку">
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <PathIcon
                                Width="16"
                                Height="16"
                                Data="{StaticResource Meta.Support}"
                                Foreground="{DynamicResource Brush.OnAccentContainer}" />
                            <TextBlock VerticalAlignment="Center" Text="Поддержка" />
                        </StackPanel>
                    </Button>

                    <!--  Telegram (правый нижний угол): иконка-кнопка 40, tint Accent.  -->
                    <Button
                        x:Name="TelegramButton"
                        Grid.Column="2"
                        Classes="IconButton40 Row Accent"
                        VerticalAlignment="Center"
                        ToolTip.Tip="Telegram">
                        <PathIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="{StaticResource Meta.Telegram}" />
                    </Button>
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
